dist

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# IDE / Editor
.idea

# Service worker
sw.*
# Men static/sw.js er vår bevisste self-destroying SW (Workbox er avskrudd) og MÅ committes/deployes
!static/sw.js

# macOS
.DS_Store

# Vim swap files
*.swp

# Browser-journey evidence. The FILES are a record of a run, not source, so they are ignored BY
# DEFAULT — but the CONTRACT is committed (test/e2e/support/journey.js): the path
# artifacts/journeys/<name>.playwright.json and the JSON shape are stable, because probes read them.
# Delete this directory and the next run rebuilds it; change the path or the shape and every probe
# breaks.
#
# EXCEPT WHERE A LANE'S EXIT NAMES THE FILE ITSELF. Some exits are written as "artifacts/journeys/
# <name>.playwright.json captures a completed walk". An exit whose evidence is regenerated-or-absent
# can be neither reviewed after the fact nor shown to fail, so those records are force-added past
# this line (`git add -f`) and are the only artifacts under version control:
#
#   modal-scroll-lock, modal-estate-scroll-lock, workforce-invitation-onboarding
#
# Each is committed WITH the screenshots its own `screenshots` array names, because a committed
# record pointing at ignored pictures is a dangling reference. Everything else here stays ignored:
# tracking every run would put a merge conflict on the output of a test.
#
# NAMED HERE UNTIL 2026-08-06 BUT NEVER ON THIS BRANCH: growth-guest-lifecycle and
# growth-testsend-refusal (L-JOURNEY-GROWTH). Their SPECS landed — test/e2e/journeys/growth-
# guest-lifecycle.spec.js and growth-testsend-refusal.spec.js are both here — but the records
# and their screenshots stop at lane/L-JOURNEY-GROWTH (ef2d6be) and were never force-added.
# Nothing on this branch reads them, so the gap costs nothing today; the list claiming they were
# committed is what costs, because the next person to wonder why `git add artifacts/journeys/
# growth-*` does nothing burns an hour on a line that was never true. Land them with `git add -f`
# from ef2d6be if the exit still wants them, and move them back up into the list above when you do.
artifacts/

# Playwright's own caches
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

.claude