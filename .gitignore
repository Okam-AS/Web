# Created by .ignore support plugin (hsz.mobi)
### Node template
# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# parcel-bundler cache (https://parceljs.org/)
.cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# Nuxt generate
dist

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# IDE / Editor
.idea

# Service worker
sw.*
# Men static/sw.js er vår bevisste self-destroying SW (Workbox er avskrudd) og MÅ committes/deployes
!static/sw.js

# macOS
.DS_Store

# Vim swap files
*.swp

# Browser-journey evidence. The FILES are a record of a run, not source, so they are ignored BY
# DEFAULT — but the CONTRACT is committed (test/e2e/support/journey.js): the path
# artifacts/journeys/<name>.playwright.json and the JSON shape are stable, because probes read them.
# Delete this directory and the next run rebuilds it; change the path or the shape and every probe
# breaks.
#
# EXCEPT WHERE A LANE'S EXIT NAMES THE FILE ITSELF. Some exits are written as "artifacts/journeys/
# <name>.playwright.json captures a completed walk". An exit whose evidence is regenerated-or-absent
# can be neither reviewed after the fact nor shown to fail, so those records are force-added past
# this line (`git add -f`) and are the only artifacts under version control:
#
#   modal-scroll-lock, modal-estate-scroll-lock, workforce-invitation-onboarding
#   growth-guest-lifecycle, growth-testsend-refusal        (L-JOURNEY-GROWTH)
#
# Each is committed WITH the screenshots its own `screenshots` array names, because a committed
# record pointing at ignored pictures is a dangling reference. Everything else here stays ignored:
# tracking every run would put a merge conflict on the output of a test.
artifacts/

# Playwright's own caches
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

.claude