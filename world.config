# The branch this repo is expected to be standing on when it feeds the plan.
#
# This is the one deliberately-enumerated value in the drift guardrails. Everything
# else worldstamp reports is derived from git. "Which branch is this program's world"
# is a decision, not a derivable fact, so it is written down where a human can see it
# and changed by a human who means it.
integration_branch=feature/restaurant-modules
