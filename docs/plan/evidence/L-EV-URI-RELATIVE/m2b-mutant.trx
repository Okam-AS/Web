    <UnitTestResult executionId="cf99c960-03c5-4299-9e87-753c5750b9e1" testId="b64112b0-0988-4daa-6e37-1fdf4890dfd3" testName="WebApi.Tests.Observability.CredentialCompositionSweepTests.A_log_statement_never_reads_a_credential_whatever_the_placeholder_is_called" computerName="svens-macbook-pro" duration="00:00:00.1608536" startTime="2026-08-02T10:06:55.2335580+02:00" endTime="2026-08-02T10:06:55.2335580+02:00" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" outcome="Failed" testListId="8c84fa94-04c1-424b-9868-57a2d4851a1d" relativeResultsDirectory="cf99c960-03c5-4299-9e87-753c5750b9e1">
      <Output>
        <ErrorInfo>
          <Message>A log call is handed a credential. Application Insights keeps it for the retention period and the placeholder it was logged under is irrelevant — a reader holds the credential either way. Log a derived fact, or add the statement to LogAllowed in this file with the reason:
  Services/Events/EventsEmailNotificationDelivery.cs:95: PublicToken   in: _logger.LogWarning("Malformed guest link {Link}", _settings.PublicBaseUrl + "/events/deposit/" + row.PublicToken.ToString("D"));
