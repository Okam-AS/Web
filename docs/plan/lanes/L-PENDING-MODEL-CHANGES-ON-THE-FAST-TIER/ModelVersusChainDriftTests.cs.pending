using System;
using System.Collections.Generic;
using System.Data.Common;
using System.Linq;
using System.Text;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Diagnostics;
using Microsoft.EntityFrameworkCore.Infrastructure;
using Microsoft.EntityFrameworkCore.Metadata;
using Microsoft.EntityFrameworkCore.Migrations;
using Microsoft.EntityFrameworkCore.Migrations.Operations;
using WebApi.Entities;
using WebApi.Helpers;
using Xunit;

namespace WebApi.Tests.Modules;

/// <summary>
/// <b>The model and the migration chain's snapshot agree — checked without a database.</b>
///
/// <para><b>The defect shape.</b> An index, a constraint or a whole table declared in
/// <c>OnModelCreating</c> and created by nothing in <c>Migrations/</c> is invisible to every test that builds
/// its database from the model: <c>EnsureCreated</c> materialises the declaration, so the guarantee reads as
/// enforced everywhere it is tested and is absent from every database the chain built — okam_local, okamtest,
/// prod. That is <c>AccountingSummaries</c>' unique claim index (a live double-post, MIG-7) and the
/// <c>GrowthAuditEvents</c> table (MIG-29), and the second cost twenty-one SQL-tier failures and a
/// fifty-five-minute run to surface.</para>
///
/// <para><b>Why this file exists when fifteen suites already assert it.</b>
/// <c>HasPendingModelChanges()</c> is asserted in fifteen <c>*MigrationLineageTests</c> — and every one of the
/// fifteen carries <c>[Trait("Database", "SqlServer")]</c> behind a live container fixture, because each sits
/// beside a <c>GetPendingMigrationsAsync()</c> call and catalog probes that do need a server. So the cheapest
/// check in the estate was reachable only on its scarcest tier, and the two areas with no lineage suite at
/// all — Kassa and Tripletex — were covered by none of them. This suite carries no <c>Database</c> trait: it
/// runs under <c>--filter Database!=SqlServer</c>, in about three seconds, on every commit.</para>
///
/// <para><b>What it compares, and what it therefore cannot see.</b> The check diffs the current model against
/// <c>ApplicationDbContextModelSnapshot</c>. It does <b>not</b> read the migrations' operations. A
/// declaration that reaches the model AND the snapshot while no migration creates it is invisible here —
/// which is precisely what happened to <c>AccountingSummaries</c>, whose snapshot was regenerated by a later,
/// unrelated migration and thereafter claimed the end state; that is why MIG-7's fix had to be hand-authored,
/// <c>ef migrations add</c> having emitted an empty <c>Up</c>. This check would have red on the commit that
/// introduced that index and gone quiet at the next regeneration. It is a tripwire at the moment of
/// introduction, not a chain audit. The chain audit is the SQL-tier catalog probe and stays there.</para>
///
/// <para><b>No database.</b> Every context here is built against an unroutable connection string AND carries
/// an interceptor that fails the test the instant anything opens a connection, so "needs no round-trip" is
/// measured rather than asserted.</para>
///
/// <para><b>It can be made to fail.</b> <see cref="A_model_only_index_is_reported_as_drift"/> perturbs the
/// design-time model with one index no migration creates and requires this suite's own reporting path — the
/// same path, past the same parked-drift filter — to name it. A future change that neuters the instrument (a
/// missing snapshot, a swallowed diff, a park that absorbs everything) cannot leave it silently green, which
/// is how three separate controls in this estate were found passing for the wrong reason.</para>
/// </summary>
public sealed class ModelVersusChainDriftTests
{
    /// <summary>
    /// Drift that is already LIVE, with the reason it is still here. This is a defect record and not an
    /// exemption: the fix is a migration, one migration author holds the chain at a time, and it is not this
    /// sweep's to make. An entry buys nothing except the ability to see the NEXT one — a check that is red
    /// for a known reason cannot report a new arrival.
    ///
    /// <para><see cref="Every_parked_drift_is_still_exactly_as_recorded"/> re-derives each entry and FAILS
    /// when it stops matching, whether because it was fixed or because its shape changed. The list cannot
    /// outlive what justifies it, and <see cref="The_model_and_the_migration_snapshot_do_not_drift"/> matches
    /// entries by their exact operation text, so it cannot absorb a new finding.</para>
    /// </summary>
    private static readonly IReadOnlyDictionary<string, string> Parked =
        new Dictionary<string, string>(StringComparer.Ordinal)
        {
            ["CreateTable GrowthAuditEvents"] = ParkedForMig29,
            ["CreateIndex IX_GrowthAuditEvents_AggregateType_AggregateId on GrowthAuditEvents "
                + "(AggregateType, AggregateId)"] = ParkedForMig29,
            ["CreateIndex IX_GrowthAuditEvents_StoreId_OccurredAt on GrowthAuditEvents "
                + "(StoreId, OccurredAt)"] = ParkedForMig29,
        };

    private const string ParkedForMig29 =
        "LIVE, INHERITED BY THE INTEGRATION MERGE, AND OWNED BY THE NEXT MIGRATION AUTHOR. `bd3a840f` put "
        + "the GrowthAuditEvent entity, its DbSet and its two indexes into ApplicationDbContext.GrowthBuilder "
        + "with no migration, so Growth's entire audit ledger — the writer, five write sites and the read "
        + "surface — is green against model-built databases and writes to a table that exists on no deployed "
        + "one. It is the third instance of the AccountingSummaries shape. docs/plans/PENDING-MIGRATIONS-"
        + "LEDGER.md records it as MIG-29 `Growth_AuditLedger`, and it is deliberately NOT folded into a "
        + "neighbouring migration: it owes an append-only deny-trigger (THROW 50074) that no generator can "
        + "produce, and folding would put two ledger entries on one migration. FIX (migration author, not "
        + "this lane): land MIG-29, then delete these three entries in the same change.";

    /// <summary>
    /// Syntactically valid, routable to nothing: port 1 refuses immediately rather than hanging, and the
    /// one-second timeout bounds even that. Nothing in this suite may need it.
    /// </summary>
    private const string UnroutableConnectionString =
        "Server=127.0.0.1,1;Database=OkamModelVersusChain;User Id=nobody;Password=nobody;"
        + "TrustServerCertificate=True;Connect Timeout=1;";

    /// <summary>
    /// Fails the test — rather than merely counting — the instant anything asks for a connection. A silent
    /// counter would let a round-trip hide behind an exception caught somewhere inside EF.
    /// </summary>
    private sealed class RefuseToConnect : DbConnectionInterceptor
    {
        public int Attempts;

        public override InterceptionResult ConnectionOpening(
            DbConnection connection, ConnectionEventData eventData, InterceptionResult result)
            => throw Refusal();

        public override ValueTask<InterceptionResult> ConnectionOpeningAsync(
            DbConnection connection, ConnectionEventData eventData, InterceptionResult result,
            CancellationToken cancellationToken = default)
            => throw Refusal();

        private Exception Refusal()
        {
            Interlocked.Increment(ref Attempts);
            return new InvalidOperationException(
                "The model-versus-chain check opened a database connection. The whole reason it runs on the "
                + "container-free tier is that it does not need one; if this API now requires a server, say "
                + "so plainly and move the check to the SQL tier rather than pointing it at a reachable "
                + "database.");
        }
    }

    private static DbContextOptionsBuilder<ApplicationDbContext> BaseOptions(RefuseToConnect guard)
        => new DbContextOptionsBuilder<ApplicationDbContext>()
            .UseSqlServer(UnroutableConnectionString)
            .UseOpenIddict()
            .AddInterceptors(guard);

    /// <summary>
    /// The sweep. Any drift that is not in <see cref="Parked"/>, named operation by operation.
    /// </summary>
    [Fact]
    public void The_model_and_the_migration_snapshot_do_not_drift()
    {
        var guard = new RefuseToConnect();
        using var ctx = new ApplicationDbContext(BaseOptions(guard).Options);

        var unparked = Drift(ctx).Where(op => !Parked.ContainsKey(op)).ToList();

        Assert.True(unparked.Count == 0, Report(unparked));
        Assert.Equal(0, guard.Attempts);
    }

    /// <summary>
    /// The raw API, asserted directly, and this suite's own diff held against it. EF's verdict is true
    /// exactly while something is parked — the day <see cref="Parked"/> empties, this becomes the bare
    /// <c>Assert.False(HasPendingModelChanges())</c> the fifteen SQL-tier lineage suites make. Holding
    /// <see cref="Drift"/> beside it pins that the operation list the park is matched against is the same
    /// comparison EF answers yes/no about, rather than a lookalike that has quietly diverged.
    /// </summary>
    [Fact]
    public void The_pending_changes_api_and_this_suites_own_diff_agree()
    {
        // Two contexts, and the diff on the one that has answered nothing yet. HasPendingModelChanges()
        // finalizes and runtime-initializes the snapshot model on its way past, so calling it first on the
        // same context would warm exactly the state Drift() has to establish for itself. That order
        // dependence is not hypothetical: it is what made an earlier draft of this file pass on its own and
        // throw inside the full assembly.
        var driftGuard = new RefuseToConnect();
        using var forDiff = new ApplicationDbContext(BaseOptions(driftGuard).Options);
        var drift = Drift(forDiff).ToList();

        var apiGuard = new RefuseToConnect();
        using var forApi = new ApplicationDbContext(BaseOptions(apiGuard).Options);
        var pending = forApi.Database.HasPendingModelChanges();

        Assert.Equal(pending, drift.Count > 0);
        Assert.Equal(Parked.Count > 0, pending);
        Assert.Equal(0, driftGuard.Attempts);
        Assert.Equal(0, apiGuard.Attempts);
    }

    /// <summary>
    /// The parked list re-derived. An entry that no longer describes live drift is a silencer aimed at
    /// nothing, and the next declaration to land on that table would arrive already forgiven.
    /// </summary>
    [Fact]
    public void Every_parked_drift_is_still_exactly_as_recorded()
    {
        var guard = new RefuseToConnect();
        using var ctx = new ApplicationDbContext(BaseOptions(guard).Options);

        var live = Drift(ctx).ToHashSet(StringComparer.Ordinal);
        var stale = Parked.Keys.Where(entry => !live.Contains(entry)).ToList();

        Assert.True(
            stale.Count == 0,
            "These parked drift entries no longer describe anything the model-versus-snapshot diff reports:"
            + Environment.NewLine
            + string.Join(Environment.NewLine, stale.Select(entry => "  - " + entry))
            + Environment.NewLine
            + "Either the migration landed or the model changed. Delete the entry — a park that outlives its "
            + "defect silences the next arrival on the same table.");
        Assert.Equal(0, guard.Attempts);
    }

    /// <summary>
    /// The reported drift does not depend on whether <c>HasPendingModelChanges()</c> has already run on the
    /// same context. It reads like an implementation detail and is not: EF finalizes and runtime-initializes
    /// the snapshot's model in place, so the first call leaves the second a different object to work on, and
    /// a version of this file that handled only one of the two orders passed alone and threw in the full
    /// assembly. xUnit's ordering is nobody's to rely on.
    /// </summary>
    [Fact]
    public void The_reported_drift_does_not_depend_on_whether_the_api_ran_first()
    {
        var coldGuard = new RefuseToConnect();
        using var cold = new ApplicationDbContext(BaseOptions(coldGuard).Options);
        var beforeTheApi = Drift(cold).ToList();

        var warmGuard = new RefuseToConnect();
        using var warm = new ApplicationDbContext(BaseOptions(warmGuard).Options);
        warm.Database.HasPendingModelChanges();
        var afterTheApi = Drift(warm).ToList();

        Assert.Equal(beforeTheApi, afterTheApi);
        Assert.Equal(0, coldGuard.Attempts);
        Assert.Equal(0, warmGuard.Attempts);
    }

    /// <summary>
    /// <c>HasPendingModelChanges()</c> returns false when the snapshot cannot be found at all — EF locates it
    /// by a <c>[DbContext(typeof(...))]</c> attribute matching the runtime context type, so a renamed context,
    /// a moved migrations assembly or a deleted snapshot makes every check above pass while comparing nothing.
    /// </summary>
    [Fact]
    public void The_check_is_not_vacuous_because_the_snapshot_is_found_and_populated()
    {
        var guard = new RefuseToConnect();
        using var ctx = new ApplicationDbContext(BaseOptions(guard).Options);

        var snapshot = ctx.GetService<IMigrationsAssembly>().ModelSnapshot;
        Assert.True(
            snapshot is not null,
            "ApplicationDbContextModelSnapshot was not found for this context type, so every other test in "
            + "this file passes without comparing anything. EF locates the snapshot by the "
            + "[DbContext(typeof(T))] attribute on it matching the runtime context type — check that "
            + "attribute and the migrations assembly before trusting any green from this suite.");

        var snapshotTables = snapshot!.Model.GetEntityTypes()
            .Select(entity => entity.GetTableName())
            .Where(table => table is not null)
            .Distinct(StringComparer.Ordinal)
            .Count();
        Assert.True(
            snapshotTables > 100,
            $"The snapshot maps only {snapshotTables} tables. This model has hundreds; a snapshot that small "
            + "is a truncated or stale file, and a diff against it means nothing.");
        Assert.Equal(0, guard.Attempts);
    }

    /// <summary>
    /// The red arm: one index declared in the model that no migration creates — the
    /// <c>AccountingSummaries</c> shape — must survive the parked filter and be named.
    /// </summary>
    [Fact]
    public void A_model_only_index_is_reported_as_drift()
    {
        var guard = new RefuseToConnect();
        using var drifted = new ApplicationDbContext(
            BaseOptions(guard)
                .ReplaceService<IModelCustomizer, OneUndeclaredIndexCustomizer>()
                .Options);

        Assert.True(
            drifted.Database.HasPendingModelChanges(),
            "An index was declared in the model that no migration creates, and HasPendingModelChanges() "
            + "still read clean. The API is not measuring what its name says, so every green this suite has "
            + "ever reported is worthless — fix the check, not this test.");

        var unparked = Drift(drifted).Where(op => !Parked.ContainsKey(op)).ToList();
        Assert.Contains(
            unparked,
            op => op.Contains(OneUndeclaredIndexCustomizer.IndexName, StringComparison.Ordinal));

        // The perturbation is confined to its own internal service provider — ReplaceService is part of that
        // provider's cache key — so the real model is unchanged in this same process. Proven, not assumed.
        var clean = new RefuseToConnect();
        using var real = new ApplicationDbContext(BaseOptions(clean).Options);
        Assert.DoesNotContain(
            Drift(real),
            op => op.Contains(OneUndeclaredIndexCustomizer.IndexName, StringComparison.Ordinal));

        Assert.Equal(0, guard.Attempts);
        Assert.Equal(0, clean.Attempts);
    }

    /// <summary>
    /// Runs the real <c>OnModelCreating</c> and then adds one index nothing in <c>Migrations/</c> creates.
    /// </summary>
    private sealed class OneUndeclaredIndexCustomizer : RelationalModelCustomizer
    {
        public const string IndexName = "IX_ModelVersusChainDrift_Probe";

        public OneUndeclaredIndexCustomizer(ModelCustomizerDependencies dependencies)
            : base(dependencies)
        {
        }

        public override void Customize(ModelBuilder modelBuilder, DbContext context)
        {
            base.Customize(modelBuilder, context);
            modelBuilder.Entity<AccountingSummary>()
                .HasIndex(x => x.DaysTakings)
                .HasDatabaseName(IndexName);
        }
    }

    /// <summary>
    /// The operations that would carry <c>ApplicationDbContextModelSnapshot</c> up to the model — the drift,
    /// spelled out one line at a time. This is what <c>HasPendingModelChanges()</c> answers yes/no about; EF
    /// runs the identical diff internally.
    /// </summary>
    private static IEnumerable<string> Drift(ApplicationDbContext ctx)
    {
        var snapshot = ctx.GetService<IMigrationsAssembly>().ModelSnapshot;
        if (snapshot is null)
            return Array.Empty<string>();

        // A snapshot's model is built by a bare ModelBuilder with no runtime dependencies, so
        // GetRelationalModel() throws on it until it has been finalized and initialized — the two steps EF
        // performs inside HasPendingModelChanges() before it can diff. It performs them IN PLACE on the
        // snapshot instance the context holds, so both orders occur in practice and both have to work: on a
        // context that has not answered the API yet the model is mutable and must be finalized here, and on
        // one that has, it is already read-only and finalizing it again throws. An earlier draft handled
        // neither and its verdict depended on which test xUnit happened to run first.
        var snapshotModel = snapshot.Model;
        if (snapshotModel is IMutableModel mutable && snapshotModel is AnnotatableBase { IsReadOnly: false })
            snapshotModel = mutable.FinalizeModel();
        snapshotModel = ctx.GetService<IModelRuntimeInitializer>().Initialize(snapshotModel, designTime: true);

        return ctx.GetService<IMigrationsModelDiffer>()
            .GetDifferences(
                snapshotModel.GetRelationalModel(),
                ctx.GetService<IDesignTimeModel>().Model.GetRelationalModel())
            .Select(Describe)
            .ToList();
    }

    private static string Report(IReadOnlyCollection<string> unparked)
    {
        if (unparked.Count == 0)
            return string.Empty;

        var report = new StringBuilder();
        report.Append("The model and ApplicationDbContextModelSnapshot disagree. ")
            .Append(unparked.Count)
            .AppendLine(" unrecorded operation(s) would be needed to bring the snapshot up to the model:");
        foreach (var op in unparked)
            report.Append("  - ").AppendLine(op);
        report.AppendLine(
            "Each line is something declared in OnModelCreating that the chain does not create, so it exists "
            + "on every model-built test database and on no deployed one. Add the migration (C2: one "
            + "migration author at a time, and the chain is the truth, not the model). If a migration cannot "
            + "be authored yet, record it in Parked with the ledger number that owns it.");
        return report.ToString();
    }

    private static string Describe(MigrationOperation op) => op switch
    {
        CreateTableOperation o => $"CreateTable {o.Name}",
        DropTableOperation o => $"DropTable {o.Name}",
        RenameTableOperation o => $"RenameTable {o.Name} -> {o.NewName}",
        CreateIndexOperation o => $"CreateIndex {o.Name} on {o.Table} ({string.Join(", ", o.Columns)})"
            + (o.IsUnique ? " UNIQUE" : string.Empty),
        DropIndexOperation o => $"DropIndex {o.Name} on {o.Table}",
        AddColumnOperation o => $"AddColumn {o.Table}.{o.Name} {o.ColumnType}",
        AlterColumnOperation o => $"AlterColumn {o.Table}.{o.Name} {o.ColumnType}",
        DropColumnOperation o => $"DropColumn {o.Table}.{o.Name}",
        AddUniqueConstraintOperation o => $"AddUniqueConstraint {o.Name} on {o.Table}",
        AddCheckConstraintOperation o => $"AddCheckConstraint {o.Name} on {o.Table}",
        AddForeignKeyOperation o => $"AddForeignKey {o.Name} on {o.Table}",
        DropForeignKeyOperation o => $"DropForeignKey {o.Name} on {o.Table}",
        AddPrimaryKeyOperation o => $"AddPrimaryKey {o.Name} on {o.Table}",
        _ => op.GetType().Name,
    };
}
