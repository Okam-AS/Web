      CREATE TRIGGER [dbo].[TR_MarginWasteEntries_FrozenWeekImmutable]
      ON [dbo].[MarginWasteEntries]
      AFTER INSERT, UPDATE, DELETE
      AS
      BEGIN
          SET NOCOUNT ON;
      
          -- The UNION of the pre-image and the post-image, so an entry can neither be moved INTO a frozen week
          -- nor dragged OUT of one: the row's old day is the day the frozen week accounted for.
          IF EXISTS (
              SELECT 1
              FROM [dbo].[MarginPeriodStatements] s
              INNER JOIN (
                  SELECT [StoreId], [WasteDate] FROM inserted
                  UNION
                  SELECT [StoreId], [WasteDate] FROM deleted
              ) w ON w.[StoreId] = s.[StoreId]
                 AND w.[WasteDate] BETWEEN s.[PeriodStart] AND s.[PeriodEnd]
              WHERE s.[State] = 'Finalized')
          BEGIN
              ROLLBACK TRANSACTION;
              THROW 50062, 'MarginWasteEntries covered by a Finalized MarginPeriodStatement are frozen: a finalized week''s waste is part of the explanation published with its figures, and is never inserted, edited or deleted afterwards. Correct the week with a new forward-only revision.', 1;
          END
      END
