info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (4ms) [Parameters=[], CommandType='Text', CommandTimeout='60']
      CREATE TRIGGER [dbo].[TR_MarginPeriodStatements_FinalizedImmutable]
      ON [dbo].[MarginPeriodStatements]
      AFTER UPDATE, DELETE
      AS
      BEGIN
          SET NOCOUNT ON;
      
          -- DELETE branch (no inserted rows): a Finalized statement is never deleted. A week that turns out to
          -- be wrong is superseded by a new revision, so the record of what was reported stays readable.
          IF NOT EXISTS (SELECT 1 FROM inserted)
          BEGIN
              IF EXISTS (SELECT 1 FROM deleted WHERE [State] = 'Finalized')
              BEGIN
                  ROLLBACK TRANSACTION;
                  THROW 50061, 'MarginPeriodStatements is immutable once Finalized: a finalized statement cannot be deleted. A correction is a new forward-only revision of the week.', 1;
              END
              RETURN;
          END
      
          -- UPDATE branch: the OLD row decides. Finalized is terminal, so any update over a Finalized pre-image
          -- is forbidden; Open -> Finalized passes here because its pre-image is Open.
          IF EXISTS (SELECT 1 FROM deleted WHERE [State] = 'Finalized')
          BEGIN
              ROLLBACK TRANSACTION;
              THROW 50061, 'MarginPeriodStatements is immutable once Finalized: its figures, input receipt and finalize timestamp are frozen. A correction is a new forward-only revision of the week, never an edit.', 1;
          END
      END
