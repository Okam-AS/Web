      CREATE TRIGGER [dbo].[TR_MealsStatementLines_FinalizedImmutable]
      ON [dbo].[MealsStatementLines]
      AFTER INSERT, UPDATE, DELETE
      AS
      BEGIN
          IF EXISTS (
              SELECT 1 FROM [dbo].[MealsStatementRuns] r
              WHERE r.[Status] = 'Finalized'
                AND r.[StatementRunId] IN (
