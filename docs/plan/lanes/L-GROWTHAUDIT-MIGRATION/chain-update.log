Applying migration '20260803093235_Kassa_AccountingSummaryDayUniqueIndex'.
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (23ms) [Parameters=[], CommandType='Text', CommandTimeout='60']
      
      SET NOCOUNT ON;
      
      -- Narrowing to nvarchar(10) truncates anything wider, and truncating accounting history is not a
      -- migration's decision either. One writer produces this column and it always writes yyyy-MM-dd, so a wider
      -- value means something else wrote it and a human should see it before the width is fixed.
      DECLARE @wide int = (
          SELECT COUNT(*) FROM [dbo].[AccountingSummaries] WHERE [Date] IS NOT NULL AND LEN([Date]) > 10);
      
      IF @wide > 0
      BEGIN
          DECLARE @wideMessage nvarchar(2000) = CONCAT(
              'MIG-7 refuses to narrow AccountingSummaries.Date: ', @wide,
              ' row(s) hold a value longer than the 10-character yyyy-MM-dd claim key, and narrowing would ',
              'truncate accounting history. Inspect them first: SELECT Id, StoreId, [Date] FROM ',
              'AccountingSummaries WHERE LEN([Date]) > 10;');
          RAISERROR(@wideMessage, 16, 1);
          RETURN;
      END;
      
      DECLARE @duplicateDays int = (
          SELECT COUNT(*) FROM (
              SELECT [StoreId], [Date]
              FROM [dbo].[AccountingSummaries]
              WHERE [Date] IS NOT NULL
              GROUP BY [StoreId], [Date]
              HAVING COUNT(*) > 1) AS duplicated);
      
      IF @duplicateDays > 0
      BEGIN
          DECLARE @duplicateMessage nvarchar(2000) = CONCAT(
              'MIG-7 refuses to create IX_AccountingSummaries_StoreId_Date: ', @duplicateDays,
              ' (StoreId, Date) group(s) already hold more than one claim row, which means the accounting day ',
              'this index exists to refuse has already been posted more than once. Which row is the real claim ',
              'is an accounting decision and not a migration''s: both may have reached the eMonkey webhook, and ',
              'the receiver has no dedup. Run the sweep in docs/plans/PENDING-MIGRATIONS-LEDGER.md (MIG-7), ',
              'resolve every group with the accounting owner, then re-run this migration.');
          RAISERROR(@duplicateMessage, 16, 1);
          RETURN;
      END;
      
      -- The composite below leads with StoreId, so it answers everything this one did.
      DROP INDEX [IX_AccountingSummaries_StoreId] ON [dbo].[AccountingSummaries];
      
      ALTER TABLE [dbo].[AccountingSummaries] ALTER COLUMN [Date] nvarchar(10) NULL;
      
      -- Filtered on [Date] IS NOT NULL because the column is nullable and that is the filter the SQL Server
      -- provider derives from the model. A NULL date is not a claim on any day, so the rows the filter exempts
      -- are the rows the guard was never about.
      CREATE UNIQUE INDEX [IX_AccountingSummaries_StoreId_Date]
          ON [dbo].[AccountingSummaries] ([StoreId], [Date])
          WHERE [Date] IS NOT NULL;
