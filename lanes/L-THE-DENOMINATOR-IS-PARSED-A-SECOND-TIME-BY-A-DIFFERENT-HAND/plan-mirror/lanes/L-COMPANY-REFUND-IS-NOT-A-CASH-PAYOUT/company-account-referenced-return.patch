+using WebApi.Services.Kassa;
+using WebApi.Tests.Kassa;
+using Xunit;
+
+namespace WebApi.Tests.Meals;
+
+/// <summary>
+/// A referenced return of a <see cref="PaymentType.CompanyAccount"/> sale credits the account the sale
+/// was charged to and leaves the cash drawer alone (Company Meals spec 20 §13.2: a company-funded order
+/// is "a typed company receivable allocation, never fake cash or card tender"; §7 names the refund paths
+/// among the payment-type switches that must classify it as a receivable).
+///
+/// <para>Before this existed the only referenced-return route was <c>payment/cash/{id}/refund</c>, which
+/// hardcodes <see cref="PaymentType.Cash"/>, demands an open cash-drawer day and books a drawer pay-out.
+/// A company lunch refunded through it put a cash tender on the RETREC for a sale no cash came in for and
+/// then paid the drawer down by money that never moved, so a correct physical count read as an overage.
+/// Each fact below is asserted against the PERSISTED journal, never the API response, because the journal
+/// is the document an inspector reads.</para>
+///
+/// <para><b>Scope.</b> These tests end at the fiscal journal. The company's allowance is restored
+/// downstream by the Meals funding ledger, which appends its <c>Reversal</c> allocation from this RETREC
+/// through the read-only journal projection (spec §3 step 5, §37) keyed on <c>ReceiptType == Return</c>,
+/// not on the tender — that limb is covered by <c>MealsCaptureLedgerTests</c>. What this file pins is the
+/// input that limb reads: a truthful return receipt.</para>
+/// </summary>
+public sealed class MealsCompanyAccountRefundJournalTests
+{
+    private const int Gross = 14900;
+    private const int OpeningFloat = 100000;
+
+    private static async Task<JournalEntry> SeedSaleAsync(PosHarness h, PaymentType tender)
+    {
+        var orderId = await h.SeedOrderAsync(finalAmount: Gross, unitAmount: Gross, taxPercent: 25);
+        var order = await h.LoadOrderAsync(orderId);
+
+        await h.Finalize.FinalizeSettlementAsync(new FinalizeSettlementRequest
+        {
+            Order = order,
+            CashPointId = PosHarness.CashPointId,
+            OperatorId = PosHarness.StandardOperatorId,
+            OperatorName = "Ola Nordmann",
+            Payments = new List<SettlementPaymentAllocation>
+            {
+                new SettlementPaymentAllocation { PaymentType = tender, Amount = Gross }
+            }
+        });
+
+        return await h.Context.JournalEntries.AsNoTracking()
+            .Include(e => e.PaymentLines)
+            .SingleAsync(e => e.EventType == KassaEventType.SALREC);
+    }
+
+    private static CompanyAccountRefundRequest RefundBody(Guid? returnId = null) => new CompanyAccountRefundRequest
+    {
+        CashPointId = PosHarness.CashPointId,
+        ReturnId = returnId ?? Guid.NewGuid(),
+        ReasonType = PosReasonType.AngretKjop
+    };
+
+    private static Task<JournalEntry> ReadRetrecAsync(PosHarness h) =>
+        h.Context.JournalEntries.AsNoTracking()
+            .Include(e => e.PaymentLines)
+            .SingleAsync(e => e.EventType == KassaEventType.RETREC);
+
+    // THE claim. This is the assertion that reds the moment the route hardcodes a tender the way the
+    // cash route does: the RETREC must name the medium the sale was actually settled on.
+    [Fact]
+    public async Task Return_of_a_company_sale_journals_the_company_account_tender()
+    {
+        await using var h = await PosHarness.CreateAsync();
+        var sale = await SeedSaleAsync(h, PaymentType.CompanyAccount);
+
+        var result = await h.CreatePosController().RefundCompanyAccount(sale.JournalEntryId, RefundBody());
+        Assert.IsType<OkObjectResult>(result);
+
+        var retrec = await ReadRetrecAsync(h);
+        var paymentLine = Assert.Single(retrec.PaymentLines);
+        Assert.Equal(PaymentType.CompanyAccount, paymentLine.PaymentType);
+        Assert.NotEqual(PaymentType.Cash, paymentLine.PaymentType);
+        Assert.Equal(Gross, paymentLine.Amount);
+
+        // It is a real referenced return, not a bare marker: it reverses the gross and points at the sale.
+        Assert.Equal(Gross, retrec.GrossAmount);
+        Assert.Equal(sale.ReceiptNumber, retrec.ReferencedReceiptNumber);
+        Assert.Equal(sale.JournalEntryId, retrec.ReferencedJournalEntryId);
+        Assert.Equal(sale.OrderId, retrec.OrderId);
+    }
+
+    // The whole point of the lane: the drawer stops recording money that never left it.
+    [Fact]
+    public async Task Return_of_a_company_sale_leaves_the_cash_drawer_untouched()
+    {
+        await using var h = await PosHarness.CreateAsync();
+        var sale = await SeedSaleAsync(h, PaymentType.CompanyAccount);
+        await h.Drawer.BeginDayAsync(PosHarness.CashPointId, OpeningFloat, PosHarness.ApproverOperatorId, "Kari Hansen");
+
+        await h.CreatePosController().RefundCompanyAccount(sale.JournalEntryId, RefundBody());
+
+        Assert.Empty(await h.Context.CashDrawerTransactions
+            .Where(t => t.Type == CashDrawerTransactionType.PayOut).ToListAsync());
+
+        var session = await h.Context.CashDrawerSessions
+            .Include(s => s.Transactions)
+            .SingleAsync(s => s.CashPointId == PosHarness.CashPointId && s.ClosedAt == null);
+        Assert.Equal(OpeningFloat, CashDrawerService.ComputeExpectedCash(session, 0));
+    }
+
+    // An open cash day is a precondition of paying cash out. Nothing is paid out here, so a register
+    // that has taken no cash today can still refund a company lunch — the control finally exists.
+    [Fact]
+    public async Task Return_of_a_company_sale_needs_no_open_cash_day()
+    {
+        await using var h = await PosHarness.CreateAsync();
+        var sale = await SeedSaleAsync(h, PaymentType.CompanyAccount);
+        Assert.Null(await h.Drawer.GetOpenSessionAsync(PosHarness.CashPointId));
+
+        var result = await h.CreatePosController().RefundCompanyAccount(sale.JournalEntryId, RefundBody());
+
+        Assert.IsType<OkObjectResult>(result);
+        Assert.Equal(PaymentType.CompanyAccount, Assert.Single((await ReadRetrecAsync(h)).PaymentLines).PaymentType);
+        Assert.Empty(await h.Context.CashDrawerTransactions.ToListAsync());
+    }
+
+    // The day's cash takings are the reconciliation an operator counts against. A company refund must
+    // not appear in them at all; it belongs to the non-cash tender breakdown (spec §13.2).
+    [Fact]
+    public async Task Return_of_a_company_sale_does_not_move_the_X_report_cash_total()
+    {
+        await using var h = await PosHarness.CreateAsync();
+        var sale = await SeedSaleAsync(h, PaymentType.CompanyAccount);
+        await h.Drawer.BeginDayAsync(PosHarness.CashPointId, OpeningFloat, PosHarness.ApproverOperatorId, "Kari Hansen");
+
+        await h.CreatePosController().RefundCompanyAccount(sale.JournalEntryId, RefundBody());
+
+        var x = await h.Reports.GenerateXReportAsync(PosHarness.CashPointId);
+        Assert.Equal(0, x.CashTotal);
+        // Sale +149.00 and return -149.00 both land on the non-cash breakdown and net to nothing.
+        Assert.Equal(0, x.OtherTotal);
+        Assert.Contains(x.PaymentMeans, p => p.PaymentType == PaymentType.CompanyAccount);
+        Assert.DoesNotContain(x.PaymentMeans, p => p.PaymentType == PaymentType.Cash);
+    }
+
+    // What Skatteetaten actually reads. The return's payment medium must be the kundekonto code, not
+    // the cash code — the export derives it from the tender this route journals.
+    [Fact]
+    public async Task Return_of_a_company_sale_exports_as_the_kundekonto_payment_medium()
+    {
+        await using var h = await PosHarness.CreateAsync();
+        var sale = await SeedSaleAsync(h, PaymentType.CompanyAccount);
+
+        await h.CreatePosController().RefundCompanyAccount(sale.JournalEntryId, RefundBody());
+
+        var today = DateTime.Now.Date;
+        var export = await h.Saft.BuildExportAsync(PosHarness.StoreId, today, today.AddDays(1), today, today);
+        var doc = XDocument.Parse(export.Xml);
+        XNamespace ns = MealsSaftJournalKit.Ns;
+
+        var returnTransaction = doc.Descendants(ns + "cashtransaction")
+            .Single(t => t.Element(ns + "amntTp")!.Value == "D");
+        var mediumCode = returnTransaction.Element(ns + "payment")!.Element(ns + "paymentType")!.Value;
+
+        var mediumBasic = doc.Descendants(ns + "basic")
+            .Where(b => b.Element(ns + "basicType")!.Value == "12")
+            .Single(b => b.Element(ns + "basicID")!.Value == mediumCode);
+        Assert.Equal("12006", mediumBasic.Element(ns + "predefinedBasicID")!.Value);
+        Assert.NotEqual("CASH", mediumCode);
+    }
+
+    // The wrong control is now closed, and the refusal names the right one rather than dead-ending.
+    [Fact]
+    public async Task Cash_return_refuses_a_company_sale_and_names_the_company_route()
+    {
+        await using var h = await PosHarness.CreateAsync();
