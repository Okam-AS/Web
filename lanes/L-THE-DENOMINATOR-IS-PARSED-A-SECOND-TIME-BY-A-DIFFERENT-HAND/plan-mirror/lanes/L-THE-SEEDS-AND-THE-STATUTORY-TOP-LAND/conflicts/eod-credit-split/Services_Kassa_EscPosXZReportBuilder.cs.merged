        // Exhaustive over PaymentType. This used to fall back to paymentType.ToString(), which put the
        // English enum identifier on a fiscal document the moment a tender arrived without a label —
        // "CompanyAccount" printed on a Norwegian Z report. An unrecognised value is named as unknown
        // WITH its code, so a reader sees a tender the register could not name rather than a plausible
        // invented one; the suite derives its expectations from Enum.GetValues, so the next tender
        // fails the build instead of reaching paper.
        private static string PaymentLabel(PaymentType paymentType)
        {
            switch (paymentType)
            {
                case PaymentType.NotSet:
                    return "Ikke satt";
                case PaymentType.Cash:
                    return "Kontant";
                case PaymentType.SurfboardTerminal:
                case PaymentType.DinteroTerminal:
                    return "Kort";
                case PaymentType.Giftcard:
                    return "Gavekort";
                case PaymentType.PayInStore:
                    return "Betal i butikk";
                case PaymentType.CompanyAccount:
                    return "Bedriftskonto";
                case PaymentType.Stripe:
                    return "Kort (Stripe)";
                case PaymentType.Vipps:
                    return "Vipps";
                case PaymentType.Dintero:
                    return "Dintero";
                case PaymentType.DinteroVipps:
                    return "Vipps (Dintero)";
                case PaymentType.DinteroBillie:
                    return "Billie (Dintero)";
                case PaymentType.DinteroKlarna:
                    return "Klarna (Dintero)";
                case PaymentType.DinteroKravia:
                    return "Kravia (Dintero)";
                case PaymentType.WoltMarketplace:
                    return "Wolt";
                case PaymentType.Surfboard:
                    return "Surfboard";
                case PaymentType.SurfboardVipps:
                    return "Vipps (Surfboard)";
                default:
                    return "Ukjent kode "
                        + ((int)paymentType).ToString(CultureInfo.InvariantCulture);
            }
        }
