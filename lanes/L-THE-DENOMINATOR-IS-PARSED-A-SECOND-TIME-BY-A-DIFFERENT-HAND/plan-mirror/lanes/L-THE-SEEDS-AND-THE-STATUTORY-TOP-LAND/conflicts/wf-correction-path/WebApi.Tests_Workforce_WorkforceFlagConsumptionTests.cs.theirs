using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using WebApi.Services.Workforce;
using WebApi.Tests.Modules;
using Xunit;

namespace WebApi.Tests.Workforce;

/// <summary>
/// <b>What the <c>workforce.*</c> family actually does, stated as a measurement.</b>
///
/// <para>The estate-wide guard enforces the RULE (an advertised flag gates at least one request); this
/// states the FACT, per flag, so a change in what a flag gates is visible as a diff rather than only as a
/// rule that still happens to hold. It is the sibling of <c>TrainingFlagConsumptionTests</c> and reads the
/// same census, which is the point — there is one measurement of "gates something" in the suite now, not one
/// per module.</para>
///
/// <para>The two withheld keys measure NOTHING, and that is the assertion rather than an omission: it is the
/// evidence behind <see cref="WorkforceFeatureFlags.Withheld"/>. If either ever gains an enforcement point,
/// this goes red beside the withholding it invalidates. For <c>workforce.personnel-list</c> that evidence is
/// only worth having because the census PROBES the § 8-5-6 correction — the module's one write that key
/// could conceivably gate. A withholding measured over a probe set its own route is missing from asserts
/// nothing about itself.</para>
/// </summary>
public sealed class WorkforceFlagConsumptionTests
{
    /// <summary>The flags that DO gate, and exactly which probed mutations each one refuses.</summary>
    private static readonly IReadOnlyDictionary<string, string[]> ExpectedGates =
        new Dictionary<string, string[]>(StringComparer.Ordinal)
        {
            // The module master answers above every stage flag, so it refuses the whole probed surface —
            // including the § 8-5-6 correction, which is behind no stage flag at all. §9.2 darkens no read,
            // but the module master is not a stage lever: it is the store not having Workforce.
            [WorkforceFeatureFlags.Module] = new[]
            {
                "POST   /workforce/{store}/staff",
                "POST   /workforce/{store}/schedules/drafts",
                "POST   /workforce/me/staff-memberships/{id}/time-off",
                "POST   /workforce/me/staff-memberships/{id}/open-assignments/{id}/requests",
                "POST   /workforce/{store}/attendance/adjustments",
                "POST   /workforce/{store}/personnel-list/entries/{id}/corrections",
            },
            [WorkforceFeatureFlags.Setup] = new[] { "POST   /workforce/{store}/staff" },
            [WorkforceFeatureFlags.Publication] = new[] { "POST   /workforce/{store}/schedules/drafts" },
            [WorkforceFeatureFlags.SelfService] = new[] { "POST   /workforce/me/staff-memberships/{id}/time-off" },
            [WorkforceFeatureFlags.Exchange] = new[]
            {
                "POST   /workforce/me/staff-memberships/{id}/open-assignments/{id}/requests",
            },
            [WorkforceFeatureFlags.Clock] = new[] { "POST   /workforce/{store}/attendance/adjustments" },
            [WorkforceFeatureFlags.Dispatch] = new[] { "DRAIN  workforce notification outbox" },
        };

    /// <summary>
    /// The census, probe by probe. Asserted as a full map rather than a count, so a flag that begins
    /// refusing a DIFFERENT operation than the one it is documented to gate fails here too — which is how a
    /// gate accidentally repointed at another flag's key becomes visible.
    /// </summary>
    [Fact]
    public async Task Seven_of_the_nine_declared_workforce_flags_gate_a_request_and_the_two_withheld_ones_gate_nothing()
    {
        var census = await ModuleFlagCensus.MeasureAsync("Workforce");

        Assert.Equal(CensusMethod.Behavioural, census.Method);

        foreach (var flag in WorkforceFeatureFlags.All)
        {
            string[] expected;
            if (!ExpectedGates.TryGetValue(flag, out expected))
            {
                expected = Array.Empty<string>();
            }

            Assert.Equal(expected, census.Evidence[flag]);
        }

        // Stated as its own claim so the count cannot drift while the map above still passes row by row.
        Assert.Equal(
            ExpectedGates.Keys.OrderBy(k => k, StringComparer.Ordinal).ToList(),
            census.Evidence.Where(e => e.Value.Length > 0).Select(e => e.Key).OrderBy(k => k, StringComparer.Ordinal).ToList());

        // …and the pair the withholding rests on.
        Assert.Equal(
            new[] { WorkforceFeatureFlags.Export, WorkforceFeatureFlags.PersonnelList }.OrderBy(k => k, StringComparer.Ordinal).ToList(),
            WorkforceFeatureFlags.Withheld.Keys.OrderBy(k => k, StringComparer.Ordinal).ToList());
    }
}
