  ev_guest_inquiry_sending: 'Sender ...',
  ev_guest_inquiry_sent_heading: 'Takk. Forespørselen er sendt.',
  ev_guest_inquiry_sent_body: 'Stedet ser på den og kommer tilbake til deg på e-post.',
  ev_guest_inquiry_reference: 'Referanse: {reference}',
  ev_guest_inquiry_refused_heading: 'Forespørselen ble ikke sendt',
  ev_guest_store_unknown_heading: 'Vi vet ikke hvilket sted dette gjelder',
  ev_guest_store_unknown_body: 'Lenken mangler stedet. Bruk lenken du fikk fra stedet, eller ta kontakt med dem direkte.',

  // Ordet 'internkontroll' er BANNLYST fra alle brukerflater, prising og markedsføring til TR8/TR-B6
  // er levert (OD-6). HACCP-fareanalyse, sporbarhet og allergeninformasjon finnes ikke i domenemodellen
  // engang ved full spesifikasjon, og skjenkebevillingens internkontroll (alkoholforskriften kap. 8) er
  // et helt annet regime — så tittelen ville lovet noe produktet ikke kan innfri. Når TR8/TR-B6 lander
  // blir visningsnavnet 'Opplæring og rutiner', og påstanden snevres til dokumentasjonsSTØTTE.
  nav_training_courses: 'Opplæring',
  trn_page_title: 'Opplæring',
  trn_page_intro: 'Ett kurs blir til dokumentasjon: lag kurset, publiser en versjon, tildel den, før gjennomføringen — og slå opp hva personen faktisk innehar.',
  trn_reload: 'Les inn på nytt',

  trn_gate_unknown: 'Kontekstkallet svarte ikke. Vi vet ikke om opplæringsmodulen er på for denne butikken, og sier derfor ingenting om den.',
  trn_gate_unauthenticated: 'Du er ikke innlogget mot API-et.',
  trn_gate_forbidden: 'Serveren avviste forespørselen. Den skiller ikke mellom en butikk du ikke administrerer og en butikk som ikke finnes, så vi kan ikke si hvilken av delene det er.',
  trn_gate_invisible: 'Opplæringsmodulen er ikke slått på for denne butikken. Serveren svarte selv, så modulen er utrullet — den er bare usynlig her til en operatør skrur på training.setup.',
  trn_gate_unreachable: 'Ingen svar fra opplæringsmodulen. Ruten finnes ikke i dette miljøet, og da kan ingenting sies om butikken.',

  trn_footnote_zone: 'Tidspunkter vises i butikkens tidssone ({zone}), slik serveren oppga den. Datoer (utstedt, utløper, frist) vises som den dagen som ble ført, uten omregning.',
  trn_footnote_zone_fallback: 'Butikken har ingen gyldig tidssone. Serveren falt tilbake på {zone}, og tidspunktene under vises i den. Datoer vises som den dagen som ble ført, uten omregning.',
  trn_footnote_zone_utc: 'Butikkens tidssone er ukjent, så tidspunkter vises i UTC. Datoer vises som den dagen som ble ført, uten omregning.',
  trn_footnote_scope: 'Denne siden er journalen for kurs, tildelinger, gjennomføringer og sertifikater. Redigering av utkast, pensjonering av versjoner, retting av sertifikater og utløpsvarsel-listen er ikke koblet opp her.',

  trn_err_validation: 'Serveren avviste innholdet i forespørselen.',
  trn_err_forbidden: 'Serveren avviste forespørselen. Den skiller ikke mellom manglende tilgang og en butikk som ikke finnes.',
  trn_err_not_found: 'Serveren fant ikke ressursen. Svaret er det samme enten den ikke finnes, tilhører en annen butikk, eller modulen er av — så vi vet ikke hvilken.',
  trn_err_idem_mismatch: 'Samme idempotensnøkkel ble brukt med et annet innhold. Ingenting ble skrevet.',
  trn_err_idem_inflight: 'En lik forespørsel er allerede underveis. Les inn på nytt og prøv igjen.',
  trn_err_immutable: 'Versjonen er ikke et utkast. Innholdet i en publisert versjon er låst — en endring er en ny versjon.',
  trn_err_flag_off: 'Denne delen er slått av for butikken. Lesing virker, skriving gjør det ikke.',
  trn_err_unknown: 'Noe gikk galt, og feilen kom ikke fra opplæringsmodulen.',
  // Bare for de to skrivingene som binder en person. Alle andre 400-er de rutene kan kaste, hindrer
  // skjemaet før sending, så dette er den ene årsaken som står igjen — se `fail` på siden.
  trn_err_person_unknown: 'ID-en peker ikke på en kjent person, så ingenting ble ført. Kontroller den mot ansattlisten, eller mot person-ID-en bemanningsmodulen viser.',

