  gr_guest_request_reference: 'Referanse {reference} · registrert {when}',

  gr_guest_signup_eyebrow: 'NYHETSBREV',
  gr_guest_signup_meta_title: 'Meld deg på nyhetsbrevet',
  gr_guest_signup_title: 'Meld deg på nyhetsbrevet',
  gr_guest_signup_intro: 'Påmeldingen skjer i to trinn. Du legger inn e-postadressen din her, og den blir aktiv først når den er bekreftet fra innboksen din. Fram til det står du ikke på lista, og du får ingenting fra oss.',
  gr_guest_signup_which_venue: 'Samtykket gjelder bare spisestedet du kom hit fra. Har du meldt deg på flere steder, er hvert av dem for seg.',
  gr_guest_signup_email_label: 'E-postadresse',
  gr_guest_signup_email_hint: 'navn@eksempel.no',
  gr_guest_signup_consent_recorded: 'Ordlyd versjon {version} ({locale}). Det er nøyaktig denne setningen som blir lagret sammen med samtykket ditt — ikke et sammendrag av den.',
  gr_guest_signup_consent_language: 'Samtykketeksten står på norsk ({locale}), fordi det er den ordlyden som blir lagret. Vi oversetter den ikke her: da ville du lest noe annet enn det som faktisk står på kvitteringen din.',
