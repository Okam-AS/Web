  meals_people_title: 'Folk',
  meals_mig17_title: 'Uten ansattreferanse gir denne invitasjonen et medlemskap som ikke kan merkes senere.',
  meals_mig17_body: 'Referansen kan bare fanges opp her, ved invitasjonen. Et medlemskap som blir krevd uten den, kan aldri få den senere: invitasjonen er brukt opp, og linjene på en avsluttet månedsoppgave er låst. Da står personen oppført med en ren identifikator på hver eneste linje av bedriftens regning, permanent.',
  meals_mig17_ack: 'Jeg forstår at denne invitasjonen gir et medlemskap som blir stående med en ren identifikator på alle framtidige månedsoppgaver, og at det ikke kan rettes senere.',
  meals_token_title: 'Invitasjonskoden',
  meals_token_not_sent_title: 'Ingenting er sendt.',
  meals_token_not_sent_body: 'Okam har ingen måte å levere denne koden på — verken e-post eller SMS. Den finnes her og ingen andre steder. Skal invitasjonen nå fram, må du selv gi koden videre, gjennom en kanal du stoler på.',
  meals_token_label: 'Engangskode',
  meals_token_recipient: 'Ment for {contact} som {role}. Utløper {expires}.',
  meals_token_bearer_note: 'Koden brukes bare én gang, og den som krever den, må være innlogget som kontakten du oppga. En videresendt kode blir avvist.',
  meals_token_claim_screen: 'Den du gir koden til, løser den inn selv på {link}. Der limer de inn koden og logger inn. Okam sender dem ingenting, så adressen må følge med koden.',
  meals_token_copy: 'Kopier koden',
  meals_token_copied: 'Kopiert',
  meals_token_copy_failed: 'Vi fikk ikke kopiert automatisk. Merk teksten i feltet og kopier den selv.',
  meals_token_done: 'Jeg har gitt koden videre',
  meals_token_once_note: 'Koden vises ikke igjen. Ingen rute kan hente den fram på nytt — er den borte, må du trekke invitasjonen tilbake og lage en ny.',
  meals_invite_title: 'Inviter noen',
  meals_invite_intro: 'Oppgi e-post eller telefon. Kontakten er ikke bare en merkelapp: den som krever invitasjonen, må være innlogget som nettopp denne personen.',
  meals_invite_action: 'Lag invitasjon',
  meals_field_contact_email: 'E-post',
  meals_field_contact_phone: 'Telefon',
  meals_field_role: 'Rolle',
  meals_field_expires_days: 'Gyldig i dager (1–90)',
  meals_field_employee_ref: 'Bedriftens ansattreferanse',
  meals_field_employee_ref_hint: 'Bedriftens egen referanse til denne personen — ansattnummer, kostnadssted eller initialer. Den havner på hver linje av månedsoppgaven og i eksporten regnskapsføreren åpner. Aldri fødselsnummer; serveren avviser det. Kan bare fylles ut nå.',
  meals_role_employee: 'Ansatt',
  meals_role_admin: 'Bedriftsadministrator',
  meals_err_contact_required: 'E-post eller telefon må fylles ut.',
  meals_err_expires_range: 'Antall dager må være mellom 1 og 90.',
  meals_err_ack_required: 'Fyll inn ansattreferansen, eller bekreft at du har lest hva det medfører å la den stå tom.',
  meals_invitations_title: 'Invitasjoner',
  meals_invitations_none: 'Ingen invitasjoner er laget for denne bedriften.',
  meals_col_contact: 'Kontakt',
  meals_col_role: 'Rolle',
  meals_col_expires: 'Utløper (din tid)',
  meals_invite_pending: 'Venter',
  meals_invite_claimed: 'Innløst',
  meals_invite_revoked: 'Trukket tilbake',
  meals_invite_expired: 'Utløpt',
  meals_invite_revoke: 'Trekk tilbake',
  meals_members_title: 'Medlemskap',
  meals_members_none: 'Ingen har krevd et medlemskap i denne bedriften ennå.',
  meals_col_member_ref: 'Referanse på månedsoppgaven',
  meals_member_ref_missing: 'ingen ansattreferanse',
  meals_col_account: 'Brukerkonto',
  meals_members_display_note: 'Kolonnen er nøyaktig det som havner på hver linje av bedriftens månedsoppgave: bedriftens egen ansattreferanse der den ble oppgitt, ellers medlemskaps-ID-en. Modulen kjenner ingen navn. Radene merket «ingen ansattreferanse» kan ikke rettes — invitasjonen er brukt opp, og avsluttede månedsoppgaver er låst.',
  meals_member_revoked: 'Tilbakekalt',

  // Avslag som gjelder de bedriftsstyrte rutene. De har en ANNEN bryter enn utsalgsstedets: den
  // modulvide innstillingen, uten butikkdimensjon. Derfor er det en egen setning.
  meals_refusal_company_dark: 'Company Meals er ikke slått på for denne installasjonen, eller så er det ingenting å vise her. Modulen svarer likt på begge deler.',
  meals_refusal_company_forbidden: 'Denne kontoen har ikke et aktivt medlemskap som bedriftsadministrator for denne bedriften. Fullmakten kommer bare derfra — aldri fra butikk- eller Okam-rollen.',
  meals_refusal_concierge_forbidden: 'Dette krever fullmakt som Okam-administrator (concierge). Denne kontoen har den ikke.',

  // Skrivefeil. Hver setning må si om noe ble lagret — det er nettopp det den som prøver, står og
  // lurer på.
  meals_write_stale: 'Noen andre har endret dette imens. Ingenting ble lagret. Last siden på nytt og prøv igjen.',
  meals_write_stale_policy: 'Ordningen har fått en nyere regelverksversjon imens. Ingenting ble lagret. Last siden på nytt og se hvilken versjon som gjelder før du publiserer.',
  meals_write_idempotency_mismatch: 'Serveren kjente igjen forsøket, men innholdet var et annet. Ingenting ble lagret. Last siden på nytt og prøv igjen.',
  meals_write_in_progress: 'Det samme forsøket er allerede under behandling. Vent litt og prøv igjen — ikke gjør det to ganger.',
  meals_write_invitation_not_claimable: 'Invitasjonen er ikke lenger til å trekke tilbake — den er allerede innløst eller trukket. Ingenting ble endret.',
  meals_write_currency_mismatch: 'Valutaen stemmer ikke med avtalens. Ingenting ble lagret.',
  meals_write_validation: 'Serveren avviste opplysningene slik de står. Ingenting ble lagret.',
  meals_write_rejected: 'Serveren avviste forespørselen. Ingenting ble lagret.',
  meals_write_network: 'Vi fikk ikke kontakt med serveren, så vi vet ikke om noe ble lagret. Last siden på nytt før du prøver igjen.',
  meals_write_unknown: 'Noe gikk galt. Vi vet ikke om noe ble lagret — last siden på nytt før du prøver igjen.',

  // Growth — fra samtykke til lovlig utsendelse (/admin/growth-newsletter). Hele flaten finnes for
  // å gjøre en ulovlig utsendelse umulig og en lovlig etterprøvbar, så teksten sier tydelig fra om
  // hvorfor noe stoppes og lover aldri en tillatelse backend ikke har gitt.
  nav_growth_newsletter: 'Nyhetsbrev',
  growth_page_title: 'Nyhetsbrev',
  growth_page_intro: 'Fra det gjestene har samtykket til, til en utsendelse du kan stå for. Hvert steg under kontrolleres mot samtykkeloggen — ingenting her kan gi samtykke på vegne av en gjest.',

  // Samtykkestatus (#8) — bare tall, aldri en mottakerliste.
  growth_standing_title: 'Samtykkestatus',
  growth_standing_intro: 'Hva gjestene har sagt ja til, som tall. Dette er ikke mottakere.',
  growth_standing_unknown: 'Vi klarte ikke å lese samtykkeloggen. Det betyr ikke at det ikke finnes samtykker — det betyr at vi ikke vet, og ingenting kan sendes før vi gjør det.',
  growth_standing_consented: 'Samtykket',
  growth_standing_withdrawn: 'Trukket tilbake',
  growth_standing_suppressed: 'Sperret',
  growth_standing_pending: 'Venter på bekreftelse',
  growth_standing_reasons: 'Hvorfor kontakter er sperret',
  growth_standing_no_suppressions: 'Ingen sperringer registrert.',
  growth_standing_scope_note: 'Sperregrunnene vises slik de er registrert. Hvor langt hver av dem rekker vises ikke her, fordi det ikke er avklart ennå.',
  growth_standing_no_grant_note: 'Det finnes ingen måte å legge til en abonnent eller gi samtykke fra denne skjermen. Samtykke kommer fra gjesten, gjennom dobbel bekreftelse, eller så finnes det ikke.',

  // Målgruppe (#10/#11) — den eneste lovlige mottakerkosten.
