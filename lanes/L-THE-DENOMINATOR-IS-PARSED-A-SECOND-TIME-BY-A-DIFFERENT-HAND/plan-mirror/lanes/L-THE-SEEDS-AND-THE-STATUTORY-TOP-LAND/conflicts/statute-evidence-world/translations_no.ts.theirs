  // ---- Bedriftsmat: den inviterte sin egen side (pages/meals/join.vue) ---------------------------
  //
  // Skrevet for en ansatt, ikke for en operatør. Leseren har aldri sett produktet, står med en kode
  // hen fikk i en melding, og har som regel ikke en knapp som løser problemet – løsningen er nesten
  // alltid å snakke med arbeidsgiveren. Derfor slutter hver avvisning med noe konkret å gjøre eller
  // noen å spørre, og ingen av dem sier «noe gikk galt».
  meals_claim_eyebrow: 'BEDRIFTSMAT',
  meals_claim_meta_title: 'Ta i bruk invitasjonen – Okam',
  meals_claim_lang_label: 'Språk',
  meals_claim_lang_no: 'Norsk',
  meals_claim_lang_en: 'English',
  meals_claim_lang_de: 'Deutsch',
  meals_claim_login_subtitle: 'Bedriftsmat hos Okam',
  meals_claim_private_note: 'Koden er personlig. Ikke del den videre – den kan bare brukes én gang, og bare av deg.',
  meals_claim_footer_help: 'Er noe uklart? Svar på meldingen du fikk koden i, så tar arbeidsgiveren din det derfra.',
  meals_claim_footer_mark: 'Levert av Okam',
  meals_claim_working: 'Henter …',
  meals_claim_platform_words: 'Plattformens eget svar: {detail}',
  meals_claim_retry: 'Prøv igjen',
  meals_claim_other_code: 'Prøv en annen kode',
  meals_claim_switch_account: 'Logg inn med en annen konto',

  meals_claim_paste_title: 'Har du fått en invitasjonskode?',
  meals_claim_paste_intro: 'Arbeidsgiveren din har satt opp en matordning hos Okam og laget en engangskode til deg. Lim den inn her.',
  meals_claim_paste_label: 'Invitasjonskode',
  meals_claim_paste_placeholder: 'mealsinv_…',
  meals_claim_paste_empty: 'Vi trenger koden for å komme videre. Lim den inn i feltet over.',
  meals_claim_paste_button: 'Fortsett',
  meals_claim_paste_help: 'Okam sender ikke ut disse kodene, verken på e-post eller SMS. Koden kom fra arbeidsgiveren din. Har du ingen, er det dem du skal spørre.',

  meals_claim_signin_title: 'Logg inn for å se invitasjonen',
  meals_claim_signin_body: 'Invitasjonen er laget til én bestemt person, og vi får ikke hentet den fram før du er logget inn. Du logger inn med telefonnummeret ditt og en kode på SMS.',
  meals_claim_signin_kept: 'Koden du har limt inn, blir liggende her mens du logger inn. Du slipper å finne den fram igjen.',
  meals_claim_signin_button: 'Logg inn',

  meals_claim_preview_title: 'Du er invitert til {company}',
  meals_claim_preview_title_unnamed: 'Du er invitert til en bedriftsordning',
  meals_claim_field_role: 'Rolle',
  meals_claim_field_expires: 'Gyldig til',
  meals_claim_role_employee: 'Ansatt',
  meals_claim_role_admin: 'Administrator for ordningen',
  meals_claim_unknowns_title: 'Dette står ikke i invitasjonen',
  meals_claim_unknowns_body: 'Invitasjonen sier hvilken bedrift du blir med i og hvilken rolle du får – ikke noe mer. Hvor mye du har å gå på, hvilke spisesteder ordningen gjelder for, og hvem som inviterte deg, står det ingenting om, så vi kan ikke vise deg det her. Spør arbeidsgiveren din hvis du vil vite det før du takker ja.',
  meals_claim_effect: 'Trykker du nå, blir du medlem av bedriftens matordning. Koden blir brukt opp og kan ikke brukes en gang til.',
  meals_claim_button: 'Ta i bruk invitasjonen',
  meals_claim_button_busy: 'Vent litt …',

  meals_claim_done_title: 'Du er med i {company}',
  meals_claim_done_title_unnamed: 'Du er med i bedriftsordningen',
  meals_claim_done_body: 'Medlemskapet er aktivt fra nå, med rollen {role}.',
  meals_claim_done_next: 'Arbeidsgiveren din kan si hvor ordningen gjelder og hvor mye du har å gå på. Okam har ingen slik oversikt å vise deg her ennå.',
  meals_claim_ref_label: 'Din referanse på bedriftens oppgaver',
  meals_claim_ref_body: 'Regningene bedriften får fra Okam, viser deg med denne referansen og ikke med navnet ditt. Ta vare på den: trenger du noen gang å spørre om en linje på regningen, er det denne du må oppgi.',

  meals_claim_unknown_title: 'Vi kjenner ikke igjen denne koden',
  meals_claim_unknown_body: 'Det kan være at noe mangler i koden, at den er brukt opp, eller at ordningen ikke er slått på hos oss. Vi får ikke vite hvilken av delene det er. Sjekk at du fikk med hele koden, og spør den som ga deg den hvis den fortsatt ikke virker.',
  meals_claim_used_title: 'Koden er allerede brukt',
  meals_claim_used_body: 'Noen har tatt denne invitasjonen i bruk. Var det deg, er du med fra før og trenger ikke gjøre mer. Var det ikke deg, si fra til arbeidsgiveren din – de kan lage en ny kode.',
  meals_claim_withdrawn_title: 'Invitasjonen er trukket tilbake',
  meals_claim_withdrawn_body: 'Arbeidsgiveren din har trukket denne invitasjonen. Skal du fortsatt være med, be dem lage en ny kode.',
  meals_claim_expired_title: 'Invitasjonen er utløpt',
  meals_claim_expired_body: 'Invitasjoner varer bare en stund. Be arbeidsgiveren din lage en ny kode – det tar dem et øyeblikk.',
  meals_claim_closed_title: 'Denne invitasjonen kan ikke brukes lenger',
  meals_claim_closed_body: 'Vi fikk ikke vite hvorfor. Be arbeidsgiveren din lage en ny kode.',
  meals_claim_wrong_account_title: 'Invitasjonen hører til en annen konto',
  meals_claim_wrong_account_body: 'Koden er i orden, men den ble laget til én bestemt e-postadresse eller ett bestemt telefonnummer, og kontoen du er logget inn med nå, er ikke den. Vi sier ikke hvilken det er – da ville en kode på avveie fortalt hvem som helst hvilken konto de trengte. Prøv å logge inn med kontoen arbeidsgiveren din har registrert på deg, eller spør dem hvilken de brukte.',
  meals_claim_already_member_title: 'Du er med fra før',
  meals_claim_already_member_body: 'Kontoen du er logget inn med, er allerede med i denne bedriftens matordning. Du trenger ikke gjøre noe mer.',
  meals_claim_signed_out_title: 'Du er ikke logget inn lenger',
  meals_claim_signed_out_body: 'Innloggingen varte ikke ut. Logg inn på nytt – koden blir liggende her så lenge du har siden åpen.',
  meals_claim_no_code_title: 'Koden kom ikke med',
  meals_claim_no_code_body: 'Forespørselen gikk uten koden. Trykk «Prøv en annen kode» og lim den inn på nytt.',
  meals_claim_in_progress_title: 'Vi holder fortsatt på',
  meals_claim_in_progress_body: 'Forrige forsøk er ikke ferdig behandlet. Vent noen sekunder og prøv igjen – du blir ikke medlem to ganger av det.',
  meals_claim_collision_title: 'Vi fikk ikke fullført',
  meals_claim_collision_body: 'Forsøket kolliderte med et annet fra samme side. Prøv en gang til, så sender vi en helt ny forespørsel.',
  meals_claim_no_module_title: 'Vi fikk ikke kontakt med matordningen',
  meals_claim_no_module_body: 'Serveren svarte, men ikke som matordningen, så vi vet ingenting om invitasjonen din. Ingenting er endret. Prøv igjen om litt, og si fra til den som ga deg koden hvis det fortsetter.',
  meals_claim_offline_title: 'Vi fikk ikke svar',
  meals_claim_offline_body: 'Noe gikk galt på veien, og vi vet ikke om forespørselen rakk fram. Sjekk at du er på nett og prøv igjen: du blir ikke medlem to ganger, og koden går ikke tapt av et forsøk som aldri kom fram.',
  // ---- Growth: the guest surface (`/subscribe/*`, `/preferences/*`) --------------------------
  // NORWEGIAN IS THE SOURCE. These four pages are consent surfaces read by members of the public,
  // and every sentence is written to survive the two facts the module currently lives with: the
  // subscribe endpoint deliberately answers identically whatever the address's state is, and no mail
  // leaves the process (`IGrowthMailProvider` is bound to the in-memory fake). So nothing here claims
  // an email was sent, or that a person is already on a list, or that data has been deleted.
  gr_guest_loading: 'Henter …',
  gr_guest_working: 'Jobber …',
  gr_guest_retry: 'Prøv på nytt',
