  nav_workforce_personnel_list: 'Personalliste',
  wfpl_page_title: 'Personalliste',
  wfpl_page_intro: 'Hvem som er på arbeidsstedet nå, og hvem som var det tidligere samme dag — med tidspunkt for både begynnelse og slutt. Listen skal være tilgjengelig på arbeidsstedet og umiddelbart kunne skrives ut på papir.',
