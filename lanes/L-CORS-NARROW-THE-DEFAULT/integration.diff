 {
     public static class ServiceCollectionExtensions
     {
+        /// <summary>
+        /// Registers the CORS policies this API serves.
+        ///
+        /// <para>The DEFAULT policy is the global one: <c>app.UseCors()</c> in <c>Program</c> applies it to
+        /// every route, and it sits BEFORE <c>UseAuthentication()</c> in the pipeline, so it stamps its
+        /// headers on a 401 exactly as it does on a 200. It therefore names its origins rather than echoing
+        /// whatever asks.</para>
+        ///
+        /// <para>Why a wildcard was not safe here even though nothing on this API rides on a browser-attached
+        /// session: three credentials are carried in explicit request headers — <c>Authorization: Bearer</c>
+        /// on every <c>[Authorize]</c> route, <c>X-Okam-ApiKey</c> in <c>StoresController</c> and
+        /// <c>X-API-Key</c> in <c>ExternalMenuController</c>. A header the script sets itself is not
+        /// "credentials" in the CORS sense, so <c>Access-Control-Allow-Origin: *</c> satisfies such a request
+        /// completely and any page on the internet can read the response body. The two API-key headers were
+        /// open on a wildcard whatever the header policy said, because a literal <c>*</c> in
+        /// <c>Access-Control-Allow-Headers</c> covers ordinary non-safelisted headers. Only
+        /// <c>Authorization</c> has a carve-out — <c>*</c> never covers it, and the Fetch specification would
+        /// therefore have blocked cross-origin bearer calls by accident — but <c>AllowAnyHeader()</c> ECHOES
+        /// the requested headers instead of emitting <c>*</c>, which defeats that one carve-out by name.</para>
+        ///
+        /// <para>Do NOT add <c>AllowCredentials()</c> to the default policy. <c>AllowAnyOrigin()</c> together
+        /// with <c>AllowCredentials()</c> throws at startup, which is a safety net;
+        /// <c>SetIsOriginAllowed(_ => true).AllowCredentials()</c> does NOT throw, and it is the one line
+        /// somebody reaches for when a page starts answering 401. On the global default it would hand every
+        /// cookie on this host to every origin. Credentialed browser access belongs on a NAMED policy applied
+        /// per action with <c>[EnableCors]</c>, the way <see cref="ClaimConstants.McpCorsPolicy"/> is scoped
+        /// to the MCP endpoints with <c>RequireCors</c>.</para>
+        ///
+        /// <para>The exposed-header set stays as it was and is read from <see cref="BrowserReadableHeaders"/>
+        /// rather than spelled as a literal: narrowing the ORIGIN does not change which response headers a
+        /// permitted origin may read, and a naive merge that respells the set is how Content-Disposition was
+        /// dropped from every export download once already.</para>
+        ///
+        /// <para>Methods and headers stay open on the default policy deliberately: once the origin is named,
+        /// the method and header sets carry no further authority, and narrowing them would break callers for
+        /// reasons unrelated to the exposure this closes.</para>
+        /// </summary>
+        public static IServiceCollection AddOkamCors(
+            this IServiceCollection services, IConfiguration configuration, IHostEnvironment environment)
+        {
+            var defaultOrigins = OkamCorsOrigins.ResolveDefaultPolicyOrigins(configuration, environment);
+            var mcpAllowedOrigins = configuration.GetSection(Constants.McpAllowedOrigins).Get<string[]>()
+                ?? Array.Empty<string>();
+
+            return services.AddCors(options =>
+            {
+                options.AddDefaultPolicy(policy =>
+                {
+                    policy.WithOrigins(defaultOrigins)
+                          .AllowAnyMethod()
+                          .AllowAnyHeader()
+                          .WithExposedHeaders(BrowserReadableHeaders.All);
+                });
+
+                options.AddPolicy(ClaimConstants.McpCorsPolicy, policy =>
+                {
+                    policy.WithOrigins(mcpAllowedOrigins)
+                        .WithMethods("POST", "GET", "DELETE")
+                        .WithHeaders("Content-Type", "Authorization", "MCP-Protocol-Version", "Mcp-Session-Id")
+                        .WithExposedHeaders("Mcp-Session-Id");
+                });
+            });
+        }
+
         public static IServiceCollection AddCustomAuthorization(this IServiceCollection services)
         {
             // Not very happy about the way authentication works here but this is the recommended way from Microsoft -André
