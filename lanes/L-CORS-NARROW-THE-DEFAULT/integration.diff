diff --git a/Helpers/OkamCorsOrigins.cs b/Helpers/OkamCorsOrigins.cs
new file mode 100644
index 00000000..550e025d
--- /dev/null
+++ b/Helpers/OkamCorsOrigins.cs
@@ -0,0 +1,106 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Hosting;
+
+namespace WebApi.Helpers
+{
+    /// <summary>
+    /// Resolves the origin list for the global (default) CORS policy.
+    ///
+    /// <para>Which origins are permitted can only be answered on the RESOLVED policy, never by reading a
+    /// settings file. The configuration array is overridden BY INDEX, so an environment file or an
+    /// <c>Cors__AllowedOrigins__0</c> app setting replaces one entry rather than the list. Both the startup
+    /// log and the tests therefore read <c>CorsOptions</c>, not <c>appsettings.json</c>.</para>
+    ///
+    /// <para>Loopback origins are added HERE, in Development only, rather than configured, and are removed
+    /// from a configured list everywhere else. <c>appsettings.Development.json</c> ships in the publish
+    /// output, so a loopback entry in a settings file would otherwise be one mis-set
+    /// <c>ASPNETCORE_ENVIRONMENT</c> away from trusting whatever else is listening on the operator's
+    /// machine.</para>
+    /// </summary>
+    public static class OkamCorsOrigins
+    {
+        /// <summary>
+        /// The client dev servers, from the API's own registry of them:
+        /// <see cref="WebApi.Services.ClientConfigurationService"/> lists <c>http://localhost:3000</c> and
+        /// <c>http://localhost:5000</c> among the Okam theme's domains, and already validates a browser's
+        /// <c>Origin</c> header against that list on the Dintero return path. Never permitted outside
+        /// Development, whatever configuration says.
+        /// </summary>
+        public static readonly string[] DevelopmentOnlyOrigins =
+        {
+            "http://localhost:3000",
+            "http://127.0.0.1:3000",
+            "http://localhost:5000",
+            "http://127.0.0.1:5000"
+        };
+
+        public static string[] ResolveDefaultPolicyOrigins(IConfiguration configuration, IHostEnvironment environment)
+        {
+            var configured = configuration?.GetSection(Constants.CorsAllowedOrigins).Get<string[]>()
+                ?? Array.Empty<string>();
+            var isDevelopment = environment != null && environment.IsDevelopment();
+            var candidates = isDevelopment
+                ? configured.Concat(DevelopmentOnlyOrigins)
+                : configured;
+
+            var resolved = new List<string>();
+            foreach (var candidate in candidates)
+            {
+                var normalized = Normalize(candidate);
+                if (normalized == null)
+                {
+                    continue;
+                }
+
+                if (!isDevelopment && IsLoopback(normalized))
+                {
+                    continue;
+                }
+
+                if (resolved.Contains(normalized, StringComparer.Ordinal))
+                {
+                    continue;
+                }
+
+                resolved.Add(normalized);
+            }
+
+            return resolved.ToArray();
+        }
+
+        /// <summary>
+        /// An <c>Origin</c> header is scheme + host + port and nothing else, and ASP.NET Core compares it
+        /// ordinally. Entries are reduced to that form so that a trailing slash or a mixed-case host — both
+        /// of which fail to match silently — cannot cost somebody an afternoon. Anything that is not an
+        /// absolute http(s) URL is skipped rather than thrown on: one stale entry must not stop the API from
+        /// starting, and the startup log names what survived.
+        /// </summary>
+        private static string Normalize(string value)
+        {
+            if (string.IsNullOrWhiteSpace(value))
+            {
+                return null;
+            }
+
+            if (!Uri.TryCreate(value.Trim(), UriKind.Absolute, out var uri))
+            {
+                return null;
+            }
+
+            if (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)
+            {
+                return null;
+            }
+
+            return uri.GetLeftPart(UriPartial.Authority);
+        }
+
+        private static bool IsLoopback(string normalizedOrigin)
+        {
+            return Uri.TryCreate(normalizedOrigin, UriKind.Absolute, out var uri) && uri.IsLoopback;
+        }
+    }
+}
