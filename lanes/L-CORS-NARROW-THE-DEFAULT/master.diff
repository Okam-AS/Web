diff --git a/WebApi.Tests/OkamCorsDefaultPolicyTests.cs b/WebApi.Tests/OkamCorsDefaultPolicyTests.cs
new file mode 100644
index 00000000..e4e8ca85
--- /dev/null
+++ b/WebApi.Tests/OkamCorsDefaultPolicyTests.cs
@@ -0,0 +1,187 @@
+using System.Collections.Generic;
+using Microsoft.AspNetCore.Cors.Infrastructure;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.FileProviders;
+using Microsoft.Extensions.Hosting;
+using Microsoft.Extensions.Options;
+using WebApi.Helpers;
+
+namespace WebApi.Tests;
+
+/// <summary>
+/// Every assertion here reads the RESOLVED <see cref="CorsPolicy"/> off the built <see cref="CorsOptions"/>,
+/// never a settings file. A settings file cannot answer which origins are permitted: the configuration array
+/// is overridden by index, so an environment file or a <c>Cors__AllowedOrigins__0</c> app setting shadows one
+/// entry rather than replacing the list.
+/// </summary>
+public class OkamCorsDefaultPolicyTests
+{
+    private const string ProductionOrigin = "https://okam.no";
+    private const string SecondProductionOrigin = "https://shop.jungelpizza.no";
+    private const string ForeignOrigin = "https://evil.example";
+
+    [Fact]
+    public void Default_policy_permits_only_the_origins_it_names()
+    {
+        var policy = ResolveDefaultPolicy(
+            new Dictionary<string, string?>
+            {
+                ["Cors:AllowedOrigins:0"] = ProductionOrigin,
+                ["Cors:AllowedOrigins:1"] = SecondProductionOrigin
+            },
+            Environments.Production);
+
+        Assert.Equal(new[] { ProductionOrigin, SecondProductionOrigin }, policy.Origins);
+        Assert.True(policy.IsOriginAllowed(ProductionOrigin));
+        Assert.True(policy.IsOriginAllowed(SecondProductionOrigin));
+        Assert.False(policy.IsOriginAllowed(ForeignOrigin));
+    }
+
+    /// <summary>
+    /// The wildcard is what made an author-set <c>Authorization</c>, <c>X-Okam-ApiKey</c> or <c>X-API-Key</c>
+    /// response readable from any page, because such a request is not "credentialed" in the CORS sense and a
+    /// bare <c>*</c> satisfies it. This is the assertion that reds if it comes back.
+    /// </summary>
+    [Fact]
+    public void Default_policy_does_not_allow_any_origin()
+    {
+        var policy = ResolveDefaultPolicy(
+            new Dictionary<string, string?> { ["Cors:AllowedOrigins:0"] = ProductionOrigin },
+            Environments.Production);
+
+        Assert.False(policy.AllowAnyOrigin);
+    }
+
+    /// <summary>
+    /// <c>AllowAnyOrigin()</c> with <c>AllowCredentials()</c> throws at startup, so it cannot reach
+    /// production. <c>SetIsOriginAllowed(_ =&gt; true).AllowCredentials()</c> does not throw, and on the global
+    /// default policy it would open every cookie on this host to every origin. Credentials belong on a named
+    /// policy applied per action, so the default carries none and this test says so out loud.
+    /// </summary>
+    [Fact]
+    public void Default_policy_never_carries_credentials()
+    {
+        var policy = ResolveDefaultPolicy(
+            new Dictionary<string, string?> { ["Cors:AllowedOrigins:0"] = ProductionOrigin },
+            Environments.Production);
+
+        Assert.False(policy.SupportsCredentials);
+        Assert.False(policy.IsOriginAllowed(ForeignOrigin));
+    }
+
+    [Fact]
+    public void Loopback_origins_are_dropped_outside_development()
+    {
+        var policy = ResolveDefaultPolicy(
+            new Dictionary<string, string?>
+            {
+                ["Cors:AllowedOrigins:0"] = ProductionOrigin,
+                ["Cors:AllowedOrigins:1"] = "http://localhost:3000",
+                ["Cors:AllowedOrigins:2"] = "http://127.0.0.1:5000"
+            },
+            Environments.Production);
+
+        Assert.Equal(new[] { ProductionOrigin }, policy.Origins);
+        Assert.False(policy.IsOriginAllowed("http://localhost:3000"));
+    }
+
+    [Fact]
+    public void Client_dev_servers_are_permitted_in_development()
+    {
+        var policy = ResolveDefaultPolicy(
+            new Dictionary<string, string?> { ["Cors:AllowedOrigins:0"] = ProductionOrigin },
+            Environments.Development);
+
+        Assert.Contains(ProductionOrigin, policy.Origins);
+        foreach (var origin in OkamCorsOrigins.DevelopmentOnlyOrigins)
+        {
+            Assert.True(policy.IsOriginAllowed(origin), origin);
+        }
+
+        Assert.False(policy.IsOriginAllowed(ForeignOrigin));
+    }
+
+    /// <summary>
+    /// An <c>Origin</c> header is scheme + host + port, compared ordinally. A trailing slash or a
+    /// capitalised host never matches and fails silently, which is the shape of mistake that gets an
+    /// allowlist reverted rather than corrected.
+    /// </summary>
+    [Fact]
+    public void Configured_origins_are_reduced_to_the_form_a_browser_sends()
+    {
+        var policy = ResolveDefaultPolicy(
+            new Dictionary<string, string?>
+            {
+                ["Cors:AllowedOrigins:0"] = "https://okam.no/",
+                ["Cors:AllowedOrigins:1"] = "https://SHOP.Okam.no",
+                ["Cors:AllowedOrigins:2"] = "https://okam.no",
+                ["Cors:AllowedOrigins:3"] = "not-a-url",
+                ["Cors:AllowedOrigins:4"] = ""
+            },
+            Environments.Production);
+
+        Assert.Equal(new[] { "https://okam.no", "https://shop.okam.no" }, policy.Origins);
+    }
+
+    [Fact]
+    public void An_empty_configured_list_permits_nothing_rather_than_everything()
+    {
+        var policy = ResolveDefaultPolicy(new Dictionary<string, string?>(), Environments.Production);
+
+        Assert.Empty(policy.Origins);
+        Assert.False(policy.AllowAnyOrigin);
+        Assert.False(policy.IsOriginAllowed(ForeignOrigin));
+    }
+
+    /// <summary>
+    /// The MCP policy is the one policy on this API that was already scoped correctly. It moved into
+    /// <c>AddOkamCors</c> unchanged, and this asserts the move did not quietly widen it.
+    /// </summary>
+    [Fact]
+    public void Mcp_policy_still_names_its_own_origins_and_carries_no_credentials()
+    {
+        var options = BuildCorsOptions(
+            new Dictionary<string, string?>
+            {
+                ["Cors:AllowedOrigins:0"] = ProductionOrigin,
+                ["Mcp:AllowedOrigins:0"] = "http://localhost:6274"
+            },
+            Environments.Development);
+
+        var mcpPolicy = options.GetPolicy(ClaimConstants.McpCorsPolicy);
+
+        Assert.NotNull(mcpPolicy);
+        Assert.Equal(new[] { "http://localhost:6274" }, mcpPolicy!.Origins);
+        Assert.False(mcpPolicy.AllowAnyOrigin);
+        Assert.False(mcpPolicy.SupportsCredentials);
+        Assert.False(mcpPolicy.IsOriginAllowed(ForeignOrigin));
+        Assert.False(mcpPolicy.IsOriginAllowed(ProductionOrigin));
+    }
+
+    private static CorsPolicy ResolveDefaultPolicy(Dictionary<string, string?> settings, string environmentName)
+    {
+        var options = BuildCorsOptions(settings, environmentName);
+        var policy = options.GetPolicy(options.DefaultPolicyName);
+        Assert.NotNull(policy);
+        return policy!;
+    }
+
+    private static CorsOptions BuildCorsOptions(Dictionary<string, string?> settings, string environmentName)
+    {
+        var configuration = new ConfigurationBuilder().AddInMemoryCollection(settings).Build();
+        var services = new ServiceCollection();
+        services.AddOkamCors(configuration, new StubHostEnvironment(environmentName));
+        return services.BuildServiceProvider().GetRequiredService<IOptions<CorsOptions>>().Value;
+    }
+
+    private sealed class StubHostEnvironment : IHostEnvironment
+    {
+        public StubHostEnvironment(string environmentName) => EnvironmentName = environmentName;
+
+        public string EnvironmentName { get; set; }
+        public string ApplicationName { get; set; } = "WebApi";
+        public string ContentRootPath { get; set; } = string.Empty;
+        public IFileProvider ContentRootFileProvider { get; set; } = new NullFileProvider();
+    }
+}
