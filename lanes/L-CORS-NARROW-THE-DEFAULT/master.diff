diff --git a/Helpers/OkamCorsOrigins.cs b/Helpers/OkamCorsOrigins.cs
new file mode 100644
index 00000000..550e025d
--- /dev/null
+++ b/Helpers/OkamCorsOrigins.cs
@@ -0,0 +1,106 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Hosting;
+
+namespace WebApi.Helpers
+{
+    /// <summary>
+    /// Resolves the origin list for the global (default) CORS policy.
+    ///
+    /// <para>Which origins are permitted can only be answered on the RESOLVED policy, never by reading a
+    /// settings file. The configuration array is overridden BY INDEX, so an environment file or an
+    /// <c>Cors__AllowedOrigins__0</c> app setting replaces one entry rather than the list. Both the startup
+    /// log and the tests therefore read <c>CorsOptions</c>, not <c>appsettings.json</c>.</para>
+    ///
+    /// <para>Loopback origins are added HERE, in Development only, rather than configured, and are removed
+    /// from a configured list everywhere else. <c>appsettings.Development.json</c> ships in the publish
+    /// output, so a loopback entry in a settings file would otherwise be one mis-set
+    /// <c>ASPNETCORE_ENVIRONMENT</c> away from trusting whatever else is listening on the operator's
+    /// machine.</para>
+    /// </summary>
+    public static class OkamCorsOrigins
+    {
+        /// <summary>
+        /// The client dev servers, from the API's own registry of them:
+        /// <see cref="WebApi.Services.ClientConfigurationService"/> lists <c>http://localhost:3000</c> and
+        /// <c>http://localhost:5000</c> among the Okam theme's domains, and already validates a browser's
+        /// <c>Origin</c> header against that list on the Dintero return path. Never permitted outside
+        /// Development, whatever configuration says.
+        /// </summary>
+        public static readonly string[] DevelopmentOnlyOrigins =
+        {
+            "http://localhost:3000",
+            "http://127.0.0.1:3000",
+            "http://localhost:5000",
+            "http://127.0.0.1:5000"
+        };
+
+        public static string[] ResolveDefaultPolicyOrigins(IConfiguration configuration, IHostEnvironment environment)
+        {
+            var configured = configuration?.GetSection(Constants.CorsAllowedOrigins).Get<string[]>()
+                ?? Array.Empty<string>();
+            var isDevelopment = environment != null && environment.IsDevelopment();
+            var candidates = isDevelopment
+                ? configured.Concat(DevelopmentOnlyOrigins)
+                : configured;
+
+            var resolved = new List<string>();
+            foreach (var candidate in candidates)
+            {
+                var normalized = Normalize(candidate);
+                if (normalized == null)
+                {
+                    continue;
+                }
+
+                if (!isDevelopment && IsLoopback(normalized))
+                {
+                    continue;
+                }
+
+                if (resolved.Contains(normalized, StringComparer.Ordinal))
+                {
+                    continue;
+                }
+
+                resolved.Add(normalized);
+            }
+
+            return resolved.ToArray();
+        }
+
+        /// <summary>
+        /// An <c>Origin</c> header is scheme + host + port and nothing else, and ASP.NET Core compares it
+        /// ordinally. Entries are reduced to that form so that a trailing slash or a mixed-case host — both
+        /// of which fail to match silently — cannot cost somebody an afternoon. Anything that is not an
+        /// absolute http(s) URL is skipped rather than thrown on: one stale entry must not stop the API from
+        /// starting, and the startup log names what survived.
+        /// </summary>
+        private static string Normalize(string value)
+        {
+            if (string.IsNullOrWhiteSpace(value))
+            {
+                return null;
+            }
+
+            if (!Uri.TryCreate(value.Trim(), UriKind.Absolute, out var uri))
+            {
+                return null;
+            }
+
+            if (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)
+            {
+                return null;
+            }
+
+            return uri.GetLeftPart(UriPartial.Authority);
+        }
+
+        private static bool IsLoopback(string normalizedOrigin)
+        {
+            return Uri.TryCreate(normalizedOrigin, UriKind.Absolute, out var uri) && uri.IsLoopback;
+        }
+    }
+}
diff --git a/Helpers/ServiceCollectionExtensions.cs b/Helpers/ServiceCollectionExtensions.cs
index 25b0caee..5d01a17d 100644
--- a/Helpers/ServiceCollectionExtensions.cs
+++ b/Helpers/ServiceCollectionExtensions.cs
@@ -28,6 +28,64 @@ namespace WebApi.Helpers
 {
     public static class ServiceCollectionExtensions
     {
+        /// <summary>
+        /// Registers the CORS policies this API serves.
+        ///
+        /// <para>The DEFAULT policy is the global one: <c>app.UseCors()</c> in <c>Program</c> applies it to
+        /// every route, and it sits BEFORE <c>UseAuthentication()</c> in the pipeline, so it stamps its
+        /// headers on a 401 exactly as it does on a 200. It therefore names its origins rather than echoing
+        /// whatever asks.</para>
+        ///
+        /// <para>Why a wildcard was not safe here even though nothing on this API rides on a browser-attached
+        /// session: three credentials are carried in explicit request headers — <c>Authorization: Bearer</c>
+        /// on every <c>[Authorize]</c> route, <c>X-Okam-ApiKey</c> in <c>StoresController</c> and
+        /// <c>X-API-Key</c> in <c>ExternalMenuController</c>. A header the script sets itself is not
+        /// "credentials" in the CORS sense, so <c>Access-Control-Allow-Origin: *</c> satisfies such a request
+        /// completely and any page on the internet can read the response body. The two API-key headers were
+        /// open on a wildcard whatever the header policy said, because a literal <c>*</c> in
+        /// <c>Access-Control-Allow-Headers</c> covers ordinary non-safelisted headers. Only
+        /// <c>Authorization</c> has a carve-out — <c>*</c> never covers it, and the Fetch specification would
+        /// therefore have blocked cross-origin bearer calls by accident — but <c>AllowAnyHeader()</c> ECHOES
+        /// the requested headers instead of emitting <c>*</c>, which defeats that one carve-out by name.</para>
+        ///
+        /// <para>Do NOT add <c>AllowCredentials()</c> to the default policy. <c>AllowAnyOrigin()</c> together
+        /// with <c>AllowCredentials()</c> throws at startup, which is a safety net;
+        /// <c>SetIsOriginAllowed(_ => true).AllowCredentials()</c> does NOT throw, and it is the one line
+        /// somebody reaches for when a page starts answering 401. On the global default it would hand every
+        /// cookie on this host to every origin. Credentialed browser access belongs on a NAMED policy applied
+        /// per action with <c>[EnableCors]</c>, the way <see cref="ClaimConstants.McpCorsPolicy"/> is scoped
+        /// to the MCP endpoints with <c>RequireCors</c>.</para>
+        ///
+        /// <para>Methods and headers stay open on the default policy deliberately: once the origin is named,
+        /// the method and header sets carry no further authority, and narrowing them would break callers for
+        /// reasons unrelated to the exposure this closes.</para>
+        /// </summary>
+        public static IServiceCollection AddOkamCors(
+            this IServiceCollection services, IConfiguration configuration, IHostEnvironment environment)
+        {
+            var defaultOrigins = OkamCorsOrigins.ResolveDefaultPolicyOrigins(configuration, environment);
+            var mcpAllowedOrigins = configuration.GetSection(Constants.McpAllowedOrigins).Get<string[]>()
+                ?? Array.Empty<string>();
+
+            return services.AddCors(options =>
+            {
+                options.AddDefaultPolicy(policy =>
+                {
+                    policy.WithOrigins(defaultOrigins)
+                          .AllowAnyMethod()
+                          .AllowAnyHeader();
+                });
+
+                options.AddPolicy(ClaimConstants.McpCorsPolicy, policy =>
+                {
+                    policy.WithOrigins(mcpAllowedOrigins)
+                        .WithMethods("POST", "GET", "DELETE")
+                        .WithHeaders("Content-Type", "Authorization", "MCP-Protocol-Version", "Mcp-Session-Id")
+                        .WithExposedHeaders("Mcp-Session-Id");
+                });
+            });
+        }
+
         public static IServiceCollection AddCustomAuthorization(this IServiceCollection services)
         {
             // Not very happy about the way authentication works here but this is the recommended way from Microsoft -André
