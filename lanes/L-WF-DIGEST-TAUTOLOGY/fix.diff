         var file = Assert.IsType<FileContentResult>(await WorkforceTimesheetTestHost
             .Controller(h, Manager).DownloadTimesheetExport(WorkforceWorld.StoreId, periodId, sent.BatchId));
-        Assert.Equal(sent.PayloadSha256, file.FileDownloadName == null ? null : sent.PayloadSha256);
+        // The digest is recomputed HERE from the bytes that were served, never read back off the same
+        // response: a comparison between two copies of the value the export reported would pass however
+        // the payload had changed since. What this pins is the sentence WFJ-15 makes — the kill switch
+        // leaves the artifact BYTE-IDENTICAL, not merely still downloadable.
+        Assert.Equal(sent.PayloadSha256, Sha256Hex(file.FileContents));
+        Assert.False(string.IsNullOrWhiteSpace(file.FileDownloadName));
         Assert.NotEmpty(file.FileContents);
 
         // …and the W6 hours CSV, which §9.2 says this flag may never take away, still answers.
@@ -895,6 +900,9 @@ public sealed class WorkforceEndToEndJourneyTests
         Assert.IsType<FileContentResult>(hours);
     }
 
+    private static string Sha256Hex(byte[] content)
+        => Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(content)).ToLowerInvariant();
