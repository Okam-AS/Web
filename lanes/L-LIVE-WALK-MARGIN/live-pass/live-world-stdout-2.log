    cd /Users/svendaneel/okam/Web-modules-wt/L-LIVE-WALK-MARGIN
    E2E_API_BUILD="OkamAPI-wt-L-LIVE-WALK-MARGIN@6d5328004b831b3ec99424b73c4d05e1d6077dc8" \
