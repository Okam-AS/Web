  align-items:baseline}
.strip__h{font:400 12px/1.65 var(--mono);color:var(--ink-3);
  font-variant-numeric:tabular-nums;overflow-wrap:anywhere;max-width:74ch}
.strip__age{font:400 12px/1.6 var(--mono);color:var(--ink-3);
  font-variant-numeric:tabular-nums;white-space:nowrap}
@media (max-width:760px){.strip__age{white-space:normal}}
.strip__age.is-aging{color:var(--caveat)}
.strip__age.is-stale{color:var(--caveat);font-weight:600}
.rot{margin:12px 0 0;color:var(--caveat);font:400 14px/1.55 var(--sans);
  max-width:62ch}
.mode{margin:16px 0 0;display:grid;grid-template-columns:auto minmax(0,1fr);
  gap:6px 16px;align-items:baseline;max-width:74ch;
  font:400 14px/1.55 var(--sans);color:var(--ink-3);
  border-top:1px solid var(--rule);padding-top:12px}
.mode__k{color:var(--ink-2);white-space:nowrap}
.mode--serve{border-top:1px solid var(--ink)}
.mode--serve .mode__k{color:var(--ink)}
.acted{margin-top:12px;font:400 13px/1.5 var(--mono);color:var(--ink-2);
  border-left:2px solid var(--rule-2);padding-left:12px;white-space:pre-wrap;
  max-width:74ch}
.acted--bad{border-left-color:var(--caveat);color:var(--caveat)}

/* ---- §7.1 THE PASS.  Rows are modules, columns are the state machine in
   order, and the 2px ink vertical between built and verified is the wall.
   Cells sit on --inset column fields so an empty column reads as an empty
   track that was visibly provided. ---- */
.board{margin-top:24px;display:grid;
  grid-template-columns:150px repeat(4,minmax(38px,1fr)) 2px
                        repeat(2,minmax(38px,1fr));
  column-gap:4px;row-gap:1px;align-items:stretch}
.board__ch{grid-row:1;display:flex;flex-direction:column;gap:4px;
  padding:0 4px 8px;color:var(--ink-3);min-width:0}
.board__ch b{font:400 12px/1 var(--mono);font-weight:400;color:var(--ink-2);
  font-variant-numeric:tabular-nums}
.board__ch span{overflow:hidden;text-overflow:ellipsis}
.board__row,.board__cells{display:contents}
.board__tick{display:none}
.board__wall{grid-column:6;grid-row:1 / -1;background:var(--ink);
  border-radius:1px}
.board__rh{grid-column:1;display:flex;gap:10px;align-items:center;
  padding:6px 12px 6px 0;text-decoration:none;color:var(--ink-2);min-width:0;
  font:400 14px/1.3 var(--sans)}
.board__rh:hover{color:var(--ink)}
.board__rh i{font:400 12px/1 var(--mono);font-style:normal;color:var(--ink-3);
  font-variant-numeric:tabular-nums;flex:none}
.board__rh span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.slot{background:var(--inset);display:flex;flex-wrap:wrap;gap:3px;
  padding:5px;align-content:flex-start;min-height:42px}
.tk{display:block;width:22px;height:30px;flex:none;text-decoration:none}
.tk .mk{width:22px;height:30px;border-radius:2px}
.tk .mk--ready{background-image:radial-gradient(circle at 50% 50%,
  currentColor 0 2px,transparent 2.1px)}
.tk .mk--verified{background-image:radial-gradient(circle at 50% 50%,
  transparent 0 2.6px,currentColor 2.7px 5.2px,transparent 5.3px)}
.tk:hover .mk{outline:2px solid var(--accent);outline-offset:1px}
.board__park{margin-top:8px;display:flex;flex-wrap:wrap;gap:8px 12px;
  align-items:center;color:var(--ink-3)}
.wall{margin-top:24px;display:flex;flex-wrap:wrap;gap:12px 16px;
  align-items:baseline;border-top:1px solid var(--rule);padding-top:16px}
.wall p{font:400 14px/1.55 var(--sans);color:var(--ink-2);max-width:62ch}
.wall p b{color:var(--ink);font-weight:600}
.cleg{display:grid;margin-top:24px;gap:14px clamp(10px,1.6vw,22px);
  grid-template-columns:repeat(auto-fit,minmax(104px,1fr));
  border-top:1px solid var(--rule);padding-top:16px}
.cleg__i{min-width:0;display:flex;flex-direction:column;gap:6px}
.cleg__n{font:400 15px/1 var(--mono);font-variant-numeric:tabular-nums;
  color:var(--ink);display:flex;align-items:center;gap:8px}
.cleg__w{font:600 11px/1.3 var(--sans);letter-spacing:.14em;
  text-transform:uppercase;color:var(--ink-3)}
.cleg .t-verified .cleg__n{color:var(--verified)}
.cleg__i.is-zero{opacity:.4}
.cnote{margin-top:16px;font:400 14px/1.55 var(--sans);color:var(--ink-2);
  max-width:66ch}
.cnote b{color:var(--ink);font-weight:600}

/* the module strip: the same row, at local size, with id chips under it */
.strip6{margin-top:16px;display:grid;
  grid-template-columns:repeat(4,minmax(52px,1fr)) 2px repeat(2,minmax(52px,1fr));
  column-gap:4px;align-items:stretch;position:relative}
.strip6__c{display:contents}
.strip6 .board__wall{grid-column:5;grid-row:1 / -1}
.strip6 .slot{flex-direction:column;gap:6px;min-height:56px}
.strip6 .slot{overflow:hidden}
.strip6 .tkw{display:flex;flex-direction:column;gap:4px;align-items:flex-start;
  min-width:0;max-width:100%}
.strip6 .id{font-size:11px;padding:2px 4px 1px;white-space:normal;
  overflow-wrap:anywhere;max-width:100%}
.strip6__k{grid-row:2;padding:6px 4px 0;color:var(--ink-3)}

/* ---- §7.2 YOUR QUEUE ---- */
.q{border-top:1px solid var(--ink);padding:0 24px}
.q__i{border-bottom:1px solid var(--rule)}
.q__i > summary{cursor:pointer;list-style:none;display:grid;
  grid-template-columns:96px minmax(0,1fr) auto;gap:6px 16px;
  padding:16px 0;align-items:baseline}
.q__i > summary::-webkit-details-marker{display:none}
.q__i > summary:hover .q__t{color:var(--accent)}
.q__v{grid-row:1;grid-column:1}
.q__m{display:flex;flex-wrap:wrap;gap:8px 10px;align-items:baseline;
  min-width:0}
.q__t{display:block;margin-top:6px;font:400 15.5px/1.5 var(--sans);
  color:var(--ink);max-width:62ch}
.q__h{text-align:right;font:400 12px/1.5 var(--mono);color:var(--ink-3);
  max-width:24ch}
.q__h b{display:block;font:400 30px/1 var(--mono);letter-spacing:-.01em;
  color:var(--ink);font-weight:400}
.q__b{padding:0 0 24px}
.q__b .cmdw{margin-top:16px}
.rel{margin-top:16px;border-top:1px solid var(--rule);padding-top:12px}
.rel__k{display:block;color:var(--ink-3);margin-bottom:10px}
.rel__l{display:flex;flex-wrap:wrap;gap:10px 12px;align-items:center}
.rel__i{display:flex;gap:6px;align-items:center}
.rel__g{display:block;width:14px;height:14px;border:1.5px dashed var(--ink-3);
  border-radius:2px;flex:none}
.rel__n{font:400 14px/1.55 var(--sans);color:var(--ink-3);max-width:62ch}

/* ---- §7.3 IN FLIGHT: capacity as countable cells, never a bar ---- */
.caps{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));
  gap:20px 26px;margin-top:16px}
.caps__i{display:flex;flex-direction:column;gap:8px}
.caps__k{display:flex;gap:8px;align-items:baseline;color:var(--ink-3)}
.caps__k b{font:400 12px/1 var(--mono);font-weight:400;color:var(--ink-2);
  font-variant-numeric:tabular-nums}
.caps__c{display:flex;gap:3px;flex-wrap:wrap}
.caps__c i{display:block;width:10px;height:14px;border:1px solid var(--rule-2);
  border-radius:1px}
.caps__c i.on{background:var(--running);border-color:var(--running)}
.caps__c i.over{background:var(--caveat);border-color:var(--caveat)}
.caps__m{margin-top:16px;font:400 12px/1.6 var(--mono);color:var(--ink-3);
  font-variant-numeric:tabular-nums}
.stg{display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px 16px;
  padding:14px 0;border-top:1px solid var(--rule);align-items:baseline}
.stg__n{display:flex;flex-wrap:wrap;gap:8px 10px;align-items:center}
.stg__n span.pair{display:inline-flex;gap:5px;align-items:center}

/* ---- §7.4 modules ---- */
.mod__h{display:flex;flex-wrap:wrap;gap:10px 14px;align-items:baseline;
  margin-top:12px}
.mod__p{margin-top:12px}
.mod__x{margin-top:16px;display:grid;grid-template-columns:auto minmax(0,1fr);
  gap:6px 16px;align-items:baseline;max-width:74ch}
.mod__x dt{color:var(--ink-3);white-space:nowrap;margin:0}
.mod__x dd{margin:0;font:400 14px/1.55 var(--sans);color:var(--ink)}
.gate{display:flex;align-items:center;gap:12px;margin:20px 0 0;
  padding-top:16px;border-top:2px solid var(--ink)}
.gate__r{flex:1;height:2px;background:var(--ink);min-width:8px}
.gate .rev,.gate .id{flex:none}
a.gate__c{text-decoration:none}
.stops{margin-top:16px}
.stop{display:grid;grid-template-columns:22px minmax(0,1fr);gap:4px 16px;
  padding:16px 0;border-top:1px solid var(--rule)}
.stop__t{font-family:var(--disp);font-weight:500;font-size:16px;
  line-height:1.35;letter-spacing:-.012em;color:var(--ink)}
.stop__c{margin-top:6px;font:400 13px/1.5 var(--mono);color:var(--ink-2)}
.stop__m{grid-row:1;grid-column:1;display:flex;justify-content:center;
  padding-top:3px}
.walk{margin-top:16px;border-left:1px solid var(--rule);padding-left:20px}
.walk__i{position:relative;padding:12px 0;border-top:1px solid var(--rule)}
.walk__i:first-child{border-top:0}
.walk__n{position:absolute;left:-33px;top:14px;font:400 12px/1 var(--mono);
  color:var(--ink-3);font-variant-numeric:tabular-nums}
.walk__a{font:400 15.5px/1.6 var(--sans);color:var(--ink);max-width:66ch}
.walk__s{margin-top:6px;font:400 14px/1.55 var(--sans);color:var(--ink-3);
  max-width:62ch}
.walk__s code{font:400 13px/1.4 var(--mono);background:var(--inset);
  border-radius:3px;padding:2px 5px;color:var(--ink)}
.walk__m{margin-top:8px;display:flex;flex-wrap:wrap;gap:8px 10px;
  align-items:center}
.next{margin-top:20px;border-top:1px solid var(--rule);padding-top:14px;
  display:grid;grid-template-columns:auto minmax(0,1fr);gap:0 16px;
  align-items:baseline;font:400 14px/1.55 var(--sans);color:var(--ink-2);
  max-width:80ch}
.next .ui{color:var(--ink-3)}
.next .rev,.next .tag{margin-right:10px;vertical-align:1px}

/* ---- horizons ---- */
.hzn{display:grid;gap:12px;margin-top:16px}
.hzn__i{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 14px;
  align-items:baseline}
.hzn__a{font:400 14px/1.55 var(--sans);color:var(--ink-3);max-width:62ch}
.hzn__a b{color:var(--ink-2);font-weight:400}

/* ---- ledgers ---- */
.ledw{border-top:1px solid var(--rule);padding:14px 0}
.ledw:first-child{border-top:0}
.led__q{margin-top:8px;font:400 12px/1.5 var(--mono)}
.led{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:6px 16px;
  align-items:baseline;text-decoration:none;color:inherit}
.led__t{font:400 15.5px/1.5 var(--sans);color:var(--ink);min-width:0}
a.led:hover .led__t{color:var(--accent)}
.led__m{display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;
  grid-column:2;font:400 12px/1.5 var(--mono);color:var(--ink-3)}
.led__r{text-align:right;font:400 12px/1.5 var(--mono);color:var(--ink-3);
  white-space:nowrap}
.fl{display:grid;grid-template-columns:22px minmax(0,1fr) auto;gap:6px 16px;
  padding:16px 0;border-top:1px solid var(--rule);align-items:start}
.fl__b{grid-row:1 / span 3;display:flex;justify-content:center;padding-top:4px}
.fl__t{font-family:var(--disp);font-weight:500;font-size:16px;line-height:1.35;
  letter-spacing:-.012em;color:var(--ink)}
.fl__c{margin-top:6px;font:400 13px/1.5 var(--mono);color:var(--ink-2);
  max-width:70ch;grid-column:2}
.fl__w{color:var(--caveat)}
.fl__r{grid-row:1;grid-column:3;text-align:right}

/* ---- decision machinery (kept, restyled) ---- */
.blk{padding:24px 0;border-top:1px solid var(--rule)}
.blk__head{display:flex;flex-wrap:wrap;align-items:baseline;gap:10px 16px}
.blk__head .st{margin-left:auto}
.blk__t{margin-top:12px;max-width:44ch}
.blk__k{display:block;margin-top:16px;color:var(--ink-3)}
.opts{margin-top:16px;display:grid;gap:0}
.opt{display:grid;grid-template-columns:168px minmax(0,1fr) auto;gap:8px 16px;
  align-items:baseline;padding:14px 12px 14px 0;
  border-top:1px solid var(--rule);width:100%;text-align:left;background:none;
  border-left:0;border-right:0;border-bottom:0;color:inherit;font:inherit;
  appearance:none}
button.opt{cursor:pointer;transition:background-color 120ms ease}
button.opt:hover{background:var(--inset)}
button.opt[aria-pressed="true"]{background:var(--inset);padding-left:12px;
  margin-left:-12px}
.opt__slug{font:400 13px/1.4 var(--mono);color:var(--ink)}
button.opt[aria-pressed="true"] .opt__slug{font-weight:600}
.opt__body{color:var(--ink-2);font:400 14px/1.55 var(--sans);max-width:62ch}
.opt__pick{color:var(--ink-3);white-space:nowrap}
button.opt:hover .opt__pick{color:var(--accent)}
button.opt[aria-pressed="true"] .opt__pick{color:var(--ink)}
.opt--ruled .opt__slug{color:var(--ink)}
.opt__rec{margin-left:10px;color:var(--ink);border-bottom:1px solid var(--ink)}
.prose p{color:var(--ink-2);font:400 14px/1.55 var(--sans);max-width:66ch}
.prose p + p{margin-top:12px}
.bul{margin-top:4px;display:grid;gap:8px;max-width:66ch}
.bul li{position:relative;padding-left:20px;color:var(--ink-2);
  font:400 14px/1.55 var(--sans)}
.bul li::before{content:"";position:absolute;left:2px;top:.72em;width:9px;
  height:1px;background:var(--rule-2)}
.card{display:block}
.csec{margin-top:16px;display:grid;grid-template-columns:132px minmax(0,1fr);
  gap:6px 16px;align-items:start}
.csec__k{color:var(--ink-3);padding-top:3px}
.csec__b{min-width:0}
.held{display:grid;gap:8px;max-width:70ch}
.held li{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 12px;
  align-items:baseline;font:400 14px/1.55 var(--sans);color:var(--ink-2)}
.held li .dim{grid-column:2}
.fac{display:grid;grid-template-columns:58px minmax(0,1fr);gap:0 12px;
  margin-top:8px;align-items:baseline}
.fac:first-child{margin-top:0}
.fac:only-child{grid-template-columns:minmax(0,1fr)}
.fac__k{font:600 10px/1.6 var(--sans);letter-spacing:.14em;
  text-transform:uppercase;color:var(--ink-3)}
.rec{margin-top:16px;background:var(--inset);padding:16px;border-radius:3px;
  max-width:70ch}
.rec--pick{background:none;border:1px dashed var(--rule-2);
  border-left:3px solid var(--rule-2)}
.rec--pick .rec__k{color:var(--ink-3)}
.rec--pick p{color:var(--ink-2)}
.rec__k{display:block;color:var(--ink-3);margin-bottom:10px}
.rec p{font:400 14px/1.6 var(--sans);color:var(--ink)}
.rec b{font-weight:600}
.rec__who{margin-top:10px;font:400 12px/1.5 var(--mono);color:var(--ink-3)}
.rec--none{background:none;border:1px dashed var(--rule-2);padding:14px 16px}
.rec--tight{display:grid;grid-template-columns:minmax(0,1fr);gap:8px;
  margin-top:16px;padding:12px 14px}
.rec--tight .rec__k{margin:0}
.rec--none p{color:var(--ink-3);font-size:14px}
.kv{margin-top:16px;display:grid;grid-template-columns:auto minmax(0,1fr);
  gap:8px 16px;font:400 14px/1.55 var(--sans);color:var(--ink-2);max-width:74ch}
.kv dt{color:var(--ink-3)}
.kv dd{margin:0}

/* ---- pending: this browser's intention, never the plan's state ---- */
.pend{display:block;margin-top:16px;border:1px dashed var(--rule-2);
  border-left:3px solid var(--caveat);padding:12px 14px;
  font:400 13px/1.5 var(--sans);color:var(--ink-2);max-width:62ch}
.pend b{color:var(--ink);font-weight:600}
.pend__k{display:block;font:600 11px/1 var(--sans);letter-spacing:.14em;
  text-transform:uppercase;color:var(--caveat);margin-bottom:8px}
.pend__disk{display:block;margin-top:8px;color:var(--ink-3);font-size:12px}
.pend__q{display:block;margin-top:8px;font:400 13px/1.5 var(--mono);
  color:var(--ink);white-space:pre-wrap;overflow-wrap:anywhere}
.pick{appearance:none;background:none;border:1px solid var(--rule-2);
  border-radius:3px;padding:9px 13px;cursor:pointer;color:var(--ink);
  font:600 11px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;
  transition:border-color 120ms ease,background-color 120ms ease,
             color 120ms ease}
.pick:hover{border-color:var(--ink-3);background:var(--inset)}
.pick[aria-pressed="true"]{background:var(--inset);border-color:var(--ink-3)}
.picks{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:16px}
.picks .dim{font-size:12.5px}

/* ---- §5 of NOTES.md: recorded prose, in the owner's voice.  The 2px ink
   left border is the same mark the log gives his rows (§7.9) — one mark, one
   meaning: these are his words, not the document's. ---- */
.note{margin-top:16px;background:var(--inset);
  border-left:2px solid var(--ink);padding:12px 16px}
.note+.note{margin-top:8px}
.note__by{font:400 12px/1.5 var(--mono);color:var(--ink-3);
  font-variant-numeric:tabular-nums}
.note__b{font:400 14px/1.55 var(--sans);color:var(--ink);max-width:62ch;
  margin-top:6px}
.note__b p+p{margin-top:8px}

/* ---- and the surface that composes it.  A composer records nothing by
   itself in a file:// page; every word of its copy says so. ---- */
.wr{margin-top:16px}
.wr__s{font:400 13px/1.5 var(--sans);color:var(--accent);cursor:pointer;
  list-style:none;display:inline-flex;gap:8px;align-items:baseline}
.wr__s::-webkit-details-marker{display:none}
.wr__s::before{content:"+";font:400 13px/1 var(--mono);color:var(--ink-3)}
details.wr[open]>.wr__s::before{content:"\2212"}
.wr__s:hover{color:var(--ink)}
.wr__b{margin-top:12px;border-left:2px solid var(--rule-2);padding-left:14px}
.wr--inline{display:flex;flex-wrap:wrap;gap:10px 12px;align-items:center}
.wr--inline .wr__l{flex:1 0 100%}
.wr__l{font:400 13px/1.5 var(--sans);color:var(--ink-3);max-width:62ch}
.wr__t,.wr__i{display:block;width:100%;max-width:62ch;margin-top:8px;
  background:var(--surface);color:var(--ink);border:1px solid var(--rule-2);
  border-radius:3px;padding:9px 11px;font:400 14px/1.55 var(--sans);
  transition:border-color 120ms ease}
.wr--inline .wr__i{flex:1 1 320px;width:auto;margin-top:0}
.wr__t:focus-visible,.wr__i:focus-visible,.wr__g input:focus-visible,
.wr__g select:focus-visible{outline:2px solid var(--accent);outline-offset:2px;
  border-color:var(--accent)}
.wr__g{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:12px 16px;margin-top:12px}
.wr__g label{display:flex;flex-direction:column;gap:6px;
  font:600 11px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;
  color:var(--ink-3)}
.wr__g .wr__wide{grid-column:1/-1}
.wr__g input,.wr__g select{background:var(--surface);color:var(--ink);
  border:1px solid var(--rule-2);border-radius:3px;padding:8px 10px;
  font:400 14px/1.4 var(--sans);letter-spacing:0;text-transform:none}
.wr__a{display:flex;flex-wrap:wrap;gap:12px;align-items:center;
  margin-top:12px}
.wr--inline .wr__a{margin-top:0}
.wbtn{appearance:none;background:none;border:1px solid var(--rule-2);
  border-radius:3px;padding:9px 13px;cursor:pointer;color:var(--ink);
  font:600 11px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;
  transition:border-color 120ms ease,background-color 120ms ease,
             color 120ms ease}
.wbtn:hover{border-color:var(--ink-3);background:var(--inset)}
.wbtn--go{border-color:var(--accent);color:var(--accent)}
.wbtn--go:hover{background:var(--inset);border-color:var(--accent)}
.wr__say{font:400 12px/1.5 var(--mono);color:var(--ink-3)}
.wr__say.is-bad{color:var(--caveat)}
.rw{color:var(--ink)}

/* ---- the basket ---- */
.basket{position:sticky;bottom:0;z-index:12;background:var(--surface);
  border-top:1px solid var(--ink)}
.basket[hidden]{display:none}
.basket__in{max-width:1280px;margin:0 auto;
  padding:16px clamp(20px,4vw,56px) 18px}
.basket__top{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:baseline;
  justify-content:space-between}
.basket__n{font:400 14px/1.55 var(--sans);color:var(--ink-2);max-width:60ch}
