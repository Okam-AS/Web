.d3{font-family:var(--disp);font-weight:500;font-size:20px;line-height:1.3;
  letter-spacing:-.015em;text-wrap:balance;margin:0}
.b1{font:400 15.5px/1.6 var(--sans);max-width:66ch}
.b2{font:400 14px/1.55 var(--sans);max-width:62ch}
.ui{font:600 11px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase}
.ml{font:700 10px/1 var(--sans);letter-spacing:.16em;text-transform:uppercase}
.path,.m1{font:400 13px/1.5 var(--mono);letter-spacing:.01em;
  color:var(--ink-2);overflow-wrap:anywhere}
.src,.m2{font:400 12px/1.5 var(--mono);color:var(--ink-3);
