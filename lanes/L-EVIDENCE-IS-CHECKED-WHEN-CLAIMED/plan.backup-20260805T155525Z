    out.append('<h1 class="d1 mast__v">%s</h1>' % esc(disp))
    out.append('<div class="stamp">'
               '<span><b>this page</b><i>the live plan, rendered from %s</i>'
               '</span>'
               '<span><b>source</b><i>%s</i></span>'
               '<span><b>state</b><i>%d entities &middot; %d facts &middot; '
