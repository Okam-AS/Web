def ui_key(p, e):
    if e.type == "Flag":
        return "cleared" if e.state == "cleared" else "open-flag"
    if e.type == "Decision":
        return "ruled" if e.state == "ruled" else "open-decision"
    if e.type == "Horizon":
        return "horizon"
    st = e.state or "open"
    if st == "open":
        return "blocked" if blocked_by(p, e) else "ready"
    return st if st in UI_STATE else "blocked"


def disk_state(e):
    """The state as the file says it, for the one comparison the script is
    allowed to make: has this browser's pending selection been overtaken by
    what is actually written down?"""
    if e.type == "Decision":
        return "ruled" if e.state == "ruled" else "open"
    if e.type == "Flag":
        return e.state or "open"
    return e.state or "open"


def h_mark(key, extra=""):
    mark, _w, _o, tone = UI_STATE[key]
    return ('<span class="mkw %s%s"><span class="mk mk--%s" aria-hidden="true">'
            '</span></span>' % (tone, (" " + extra) if extra else "", mark))


def h_state(p, e, with_mark=False):
    """The word + who-moves-next half of the state signal.  The mark itself
    leads the row, so repeating it here would be noise, not redundancy — the
    four carriers are mark (row), word, colour and type treatment."""
    key = ui_key(p, e)
    mark, word, who, tone = UI_STATE[key]
    lead = ('<span class="mkw"><span class="mk mk--%s" aria-hidden="true">'
            '</span></span>' % mark) if with_mark else ""
    return ('<span class="st %s">%s<span class="st__t">'
            '<span class="st__word">%s</span>'
            '<span class="st__who">next move: %s</span></span></span>'
            % (tone, lead, esc(word), esc(who)))


def h_id(eid, self_link=True):
    """§2.2: an id is defined exactly once, and every other appearance is
    plain text the renderer auto-links.  The link goes to the row this page
    carries for that entity — the script switches to whichever view holds it
    and flashes it, so a dependency chip is a way through the plan rather
    than a string to search for."""
    if not self_link:
        return '<span class="id">%s</span>' % esc(eid)
    return '<a class="id" href="#e-%s">%s</a>' % (esc(eid), esc(eid))


VERB_WORD = {"accept": "accept", "rule": "rule", "review": "review",
             "re-sign": "re-sign", "write": "write"}


def mine_map(actions):
    """The one place reverse video comes from: the NEEDED set (§1.4/§5)."""
    return dict((a[1], a[0]) for a in actions)


_dep_cache = {}


def dependents(p, eid):
    """Who is waiting on this id.  Computed once per plan, not per row."""
    key = id(p)
    m = _dep_cache.get(key)
    if m is None:
        m = {}
        for i in p.order:
            for n in p.entities[i].needs:
                m.setdefault(n, []).append(i)
        _dep_cache[key] = m
    return m.get(eid, [])


