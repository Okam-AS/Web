                         or '<p class="plain"><span>None declared.</span></p>')))
    am = intent_paragraphs(it, "amendments")
    if am:
        body.append(h_sub("amendments", str(len(it.amendments)),
                          '<div class="pan"><div class="why__obj">%s</div>'
                          '<p class="sec__note">A tier-2 or tier-3 amendment '
                          'invalidates the signature until the plan is '
                          're-signed, and nothing new dispatches meanwhile.</p>'
                          '</div>'
                          % "".join('<p>%s</p>' % md_inline(x) for x in am)))
    body.append(h_sources(p))
    return h_sec("why", "Why", "%d constraints" % len(it.constraints),
                 "What this is for, the constraints that bind every agent sent "
                 "out, and the alternatives already rejected.", "".join(body))


def h_sources(p):
    files = [(p.plan_md, "plan.md", "every entity, state, dependency and fact "
                                    "span — the file this page is a projection "
                                    "of"),
             (p.intent_md, "intent.md", "the objective, the constraints and "
                                        "the rejected alternatives"),
             (p.log_md, "log.md", "append-only history: every ruling, dispatch, "
                                  "merge and state change"),
             (p.stamps, "stamps.log", "when each probe last ran and what it "
                                      "measured")]
    items = []
    for path, label, what in files:
        if not os.path.exists(path):
            continue
        items.append('<div>%s<span>%s</span></div>'
                     % (h_src(path, label=label), esc(what)))
    for d, label, word in ((p.returns, "returns/", "agent return"),
                           (p.briefs, "briefs/", "generated brief")):
        if not os.path.isdir(d):
            continue
        try:
            n = len([x for x in os.listdir(d) if x.endswith(".md")])
        except OSError:
            n = 0
        if n:
            items.append('<div>%s<span>%d %s%s</span></div>'
                         % (h_src(d, label=label), n, word,
                            "" if n == 1 else "s"))
    return h_sub("the sources", None,
                 '<div class="pan"><div class="srcs">%s</div>'
                 '<p class="sec__note">This page is a projection and never the '
                 'only readable form of the truth. Every file behind it is '
                 'Markdown you can open, diff and edit by hand; the links are '
                 'relative, so they work from a copied folder with no server.'
                 '</p></div>' % "".join(items))

