# -- §7.1 THE PASS ----------------------------------------------------------

PASS_COL = {"blocked": 2, "ready": 3, "running": 4, "built-unverified": 5,
            "verified": 7, "accepted": 8}
STRIP_COL = {"blocked": 1, "ready": 2, "running": 3, "built-unverified": 4,
             "verified": 6, "accepted": 7}


def _ticket(p, e, cls="tk"):
    key = ui_key(p, e)
    mark, word, _who, tone = UI_STATE[key]
    lbl = "%s — %s — %s" % (e.id, " ".join(str(e.title).replace("~~", "")
                                           .split()), word)
    return ('<a class="%s %s" href="#e-%s" title="%s" aria-label="%s">'
            '<span class="mk mk--%s" aria-hidden="true"></span></a>'
            % (cls, tone, esc(e.id), esc(lbl), esc(lbl), mark))


def _slots(p, row, colmap, gr=None):
    """One slot per state column, always emitted: an empty column has to read
    as a track that was visibly provided, not as an absence."""
    by = {}
    parked = []
    for e in row:
        k = ui_key(p, e)
        if k == "retracted":
            parked.append(e)
            continue
        by.setdefault(k, []).append(e)
    out = []
    for i, key in enumerate(CENSUS_ORDER):
        style = "grid-column:%d" % colmap[key]
        if gr is not None:
            style += ";grid-row:%d" % gr
        out.append('<div class="slot" style="%s">%s</div>'
                   % (style, "".join(_ticket(p, e) for e in by.get(key, []))))
        if key == "built-unverified":
            out.append('<i class="board__tick" aria-hidden="true"></i>')
    return "".join(out), parked


def h_pass(p):
    rows, estate = pass_board(p)
    items = work_items(p)
    total = len(items)
    counts = {}
    for e in items:
        counts[ui_key(p, e)] = counts.get(ui_key(p, e), 0) + 1

    board = ['<div class="board">']
    for key in CENSUS_ORDER:
        board.append('<div class="board__ch ml" style="grid-column:%d">'
                     '<span>%s</span><b class="num">%d</b></div>'
                     % (PASS_COL[key], esc(UI_STATE[key][1]),
                        counts.get(key, 0)))
    board.append('<div class="board__wall" aria-hidden="true"></div>')
    parked_all = []
    r = 2
    for ft, row in rows:
        cells, parked = _slots(p, row, PASS_COL, r)
        parked_all.extend(parked)
        board.append('<div class="board__row">'
                     '<a class="board__rh" href="#m-%s" style="grid-column:1;'
                     'grid-row:%d"><i>%02d</i><span>%s</span></a>'
                     '<div class="board__cells">%s</div></div>'
                     % (esc(module_slug(ft)), r, r - 1,
                        esc(module_name(ft)), cells))
        r += 1
    cells, parked = _slots(p, estate, PASS_COL, r)
    parked_all.extend(parked)
    board.append('<div class="board__row">'
                 '<a class="board__rh" href="#instruments" style="grid-column:1;'
                 'grid-row:%d"><i>%02d</i><span>estate</span></a>'
                 '<div class="board__cells">%s</div></div>'
                 % (r, r - 1, cells))
    board.append("</div>")
    if parked_all:
        board.append('<div class="board__park"><span class="ui">parked</span>%s'
                     '</div>' % "".join(_ticket(p, e) for e in parked_all))

    wall = ('<div class="wall"><span class="rev">the pass</span>'
            '<p>%s</p></div>' % wall_label(p))

    order = list(CENSUS_ORDER)
    if counts.get("retracted", 0):
        order.append("retracted")
    legs = []
    for key in order:
        n = counts.get(key, 0)
        legs.append('<span class="cleg__i %s%s"><span class="cleg__n">%s%d'
                    '</span><span class="cleg__w">%s</span></span>'
                    % (UI_STATE[key][3], "" if n else " is-zero",
                       h_mark(key), n, esc(UI_STATE[key][1])))
    acc = counts.get("accepted", 0)
    head = ('<b>None of the %d declared capabilities has been accepted.</b>'
            % total) if not acc else \
           ('<b>%d of %d declared capabilities have been accepted.</b>'
            % (acc, total))
    if not total:
        head = '<b>No capabilities are declared yet.</b>'
    cnote = ('%s The board is a count, not a share: every cell is a named '
             'thing you can open, and %s is what declares them.'
             % (head, h_src(p.plan_md, label="plan.md")))
    body = ("".join(board) + wall
            + '<div class="cleg">%s</div>' % "".join(legs)
            + '<p class="cnote">%s</p>' % cnote)
    return h_sec("pass", "The pass", "%d capabilities" % total,
                 "Every capability, one cell, placed by state. Work crosses "
                 "the line only when a person walks it.",
                 '<div class="pan">%s</div>' % body)


