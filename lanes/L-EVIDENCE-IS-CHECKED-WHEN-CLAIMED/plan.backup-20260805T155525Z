def node_done(p, e):
    return satisfied(p, e.id)


def clip(s, n=150):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[:n - 1].rstrip() + "…"


def next_event(p, e, mine, sched, depth=0, seen=None):
    """One falsifiable event: the next thing that could be observed to happen.
    Returns (kind, text, id-of-the-thing-that-must-move)."""
    if seen is None:
        seen = set()
    if e.id in seen or depth > 4:
        return "work", "a dependency cycle stops this rail — see `plan check`", e.id
    seen.add(e.id)
    owner = p.owner or "the owner"
    if e.type == "Decision" and e.state != "ruled":
        age = p_age(p, e.id)
        asked = ""
        if age < (1 << 62):
            asked = ", asked %s ago" % fmt_age(time.time() - age)
        return "person", ("%s rules %s%s — %s"
                          % (owner, e.id, asked, clip(e.title, 90))), e.id
    if e.type == "Flag" and e.state != "cleared":
        who = "person" if e.get("owner", "").startswith("@") else "work"
        return who, ("%s clears when %s"
                     % (e.id, clip(e.get("clears_when", "(owed)"), 110))), e.id
    if e.state == "verified":
        return "person", ("%s accepts %s — its evidence is %s"
                          % (owner, e.id,
                             clip(e.get("evidence", "none"), 70))), e.id
    if e.state == "built-unverified":
        return "work", ("%s leaves built-unverified when non-suite evidence "
                        "exists for: %s"
                        % (e.id, clip(e.get("exit", "(no exit declared)")))), e.id
    if e.state == "running":
        return "machine", ("%s returns evidence against: %s"
                           % (e.id, clip(e.get("exit", "(no exit declared)")))), e.id
    if e.state == "accepted":
        return "none", "%s is accepted" % e.id, e.id
    if e.state == "retracted":
        return "none", "%s is retracted and off the rail" % e.id, e.id
    if e.state == "open":
        unmet = blocked_by(p, e)
        if unmet:
            t = p.entities.get(unmet[0])
            if t is not None:
                kind, text, who = next_event(p, t, mine, sched, depth + 1, seen)
                return kind, "%s waits on %s: %s" % (e.id, t.id, text), who
        if e.type == "Lane":
            cap = sched.caps.get(e.cls, 0)
            run = sched.class_count.get(e.cls, 0)
            return "machine", ("%s dispatches — class %s is at %d of %d"
                               % (e.id, e.cls or "?", run, cap)), e.id
        return "work", "%s has nothing left blocking it" % e.id, e.id
    return "work", "%s — state is not readable" % e.id, e.id


def rail_frontier(p, ft, mine, sched):
    """(stop index, kind, text, blocking id, nodes, satisfied count)."""
    nodes = rail_nodes(p, ft)
    stop = None
    done = 0
    for i, nd in enumerate(nodes):
        if node_done(p, nd):
            done += 1
        elif stop is None:
            stop = i
    if stop is None:
        return None, "none", "no further event — %s is accepted" % ft.id, \
            None, nodes, done
    kind, text, who = next_event(p, nodes[stop], mine, sched)
    return stop, kind, text, who, nodes, done




