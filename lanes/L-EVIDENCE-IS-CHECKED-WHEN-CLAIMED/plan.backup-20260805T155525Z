def esc(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def ttl(s):
    """A title as prose.  `~~` is the retraction marker of §2.3, not part of
    the words; the strike itself is drawn by CSS on the retracted class."""
    return esc(str(s).replace("~~", ""))


def md_block(lines, cls="prose"):
    """Authored prose rendered as it was written: paragraphs stay paragraphs
    and a `- ` list stays a list.  A reason nobody can skim is a reason nobody
    reads, so the renderer honours the breaks the author made rather than
    flattening them into a wall."""
    out, para, bullets = [], [], []

    def flush_para():
        if para:
            out.append("<p>%s</p>" % md_inline(" ".join(para)))
            del para[:]

    def flush_bul():
        if bullets:
            out.append('<ul class="bul">%s</ul>'
                       % "".join("<li>%s</li>" % md_inline(b) for b in bullets))
            del bullets[:]

    for raw in lines:
        t = raw.strip()
        if not t:
            flush_para()
            flush_bul()
            continue
        m = re.match(r"^[-*]\s+(.*)$", t)
        if m:
            flush_para()
            bullets.append(m.group(1))
            continue
        if bullets:
            bullets[-1] = bullets[-1] + " " + t
            continue
        para.append(t)
    flush_para()
    flush_bul()
    return '<div class="%s">%s</div>' % (cls, "".join(out)) if out else ""


def prose_of(p, e):
    return [p.lines[i] for i in e.prose]


def md_inline(s):
    """The three inline marks authored prose actually uses.  Everything is
    escaped first, so this can only ever add the three tags it names."""
    out = esc(s)
    out = re.sub(r"~~(.+?)~~", r'<span class="struck">\1</span>', out)
    out = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", out)
    out = re.sub(r"`([^`]+)`", r'<code class="path">\1</code>', out)
    return out.replace("~~", "")


# -- source links: nothing on this page is the only readable form of itself --

_OUT_DIR = [None]


def url_path(s):
    out = []
    for ch in s.replace(os.sep, "/"):
        if ch in " #?%&+'\"":
            out.append("%%%02X" % ord(ch))
        else:
            out.append(ch)
    return "".join(out)


_href_memo = {}


def href_to(target):
    """A relative href from the rendered page to a file in the repo.  Relative
    so it opens from file:// with no server and survives being moved with the
    repo; never absolute, never a URL to anywhere."""
    base = _OUT_DIR[0] or os.getcwd()
    key = (base, target)
    hit = _href_memo.get(key)
    if hit is not None:
        return hit
    try:
        out = url_path(os.path.relpath(target, base))
    except ValueError:                      # different drives on Windows
        out = url_path(target)
    _href_memo[key] = out
    return out


def h_src(target, line=None, label=None, cls="src"):
    href = href_to(target)
    if line:
        href += "#L%d" % line
    if label is None:
        label = os.path.basename(target) + ((":%d" % line) if line else "")
    return '<a class="%s" href="%s">%s</a>' % (cls, esc(href), esc(label))


def h_entity_src(p, e):
    """Every entity points back at the line that produced it."""
    return h_src(p.plan_md, e.line + 1)


