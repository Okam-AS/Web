def h_why(p, it):
    obj = intent_paragraphs(it, "objective")
    pre = plan_preamble(p)
    body = ['<div class="pan"><div class="why__obj">%s</div>'
            % ("".join('<p>%s</p>' % md_inline(x) for x in obj)
               or '<p class="dim">intent.md declares no objective yet.</p>')]
    body.append('<p class="sec__note">Authored in %s and changed only by '
                'amendment.</p></div>'
                % h_src(p.intent_md, label="intent.md"))
    if pre:
        body.append(h_sub("where this started", None,
                          '<div class="pan"><div class="why__obj">%s</div>'
                          '<p class="sec__note">The opening of %s, verbatim.'
                          '</p></div>'
                          % ("".join('<p>%s</p>' % md_inline(x) for x in pre),
                             h_src(p.plan_md, label="plan.md"))))
    rows = []
    for c in it.constraints:
        rows.append('<div class="cst"><div class="blk__head">'
                    '<span class="id">%s</span>%s</div>'
                    '<p class="d3 cst__t">%s</p><dl class="cst__f">'
                    '<dt>holds because</dt><dd>%s</dd>'
                    '<dt>violated when</dt><dd>%s</dd></dl></div>'
                    % (esc(c["id"]), h_src(p.intent_md, c["line"] + 1),
                       md_inline(c["text"]),
                       md_inline(c["fields"].get("holds_because", "—")),
                       md_inline(c["fields"].get("violated_when", "—"))))
    body.append(h_sub("constraints in force", str(len(it.constraints)),
                      '<div class="pan">%s<p class="sec__note">Every '
                      'constraint is copied verbatim into every brief, so an '
                      'agent cannot be sent out without them. <b>violated_when'
                      '</b> is the symptom a reviewer can check against a diff; '
                      'a constraint without one is decoration.</p></div>'
                      % ("".join(rows)
                         or '<p class="plain"><span>None declared.</span></p>')))
    rej = []
    for r in it.rejected:
        rej.append('<div class="cst"><div class="blk__head">'
                   '<span class="id">%s</span>%s</div>'
                   '<p class="d3 cst__t">%s</p><dl class="cst__f">'
                   '<dt>reopen when</dt><dd>%s</dd></dl></div>'
                   % (esc(r["id"]), h_src(p.intent_md, r["line"] + 1),
                      md_inline(r["text"]),
                      md_inline(r["fields"].get("reopen_when",
                                                "(owed — `plan check` warns)"))))
    body.append(h_sub("roads not taken", str(len(it.rejected)),
                      '<div class="pan">%s<p class="sec__note">Each one carries '
                      'the condition that would put it back on the table. This '
                      'is the section that stops a settled argument from being '
                      'had twice.</p></div>'
