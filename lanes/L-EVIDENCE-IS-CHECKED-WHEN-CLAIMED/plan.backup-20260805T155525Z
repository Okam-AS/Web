        return ('<p class="rec rec--tight rec--pick"><span class="ui rec__k">'
                '%s</span>'
                '<span>Take <b>%s</b>.%s</span>'
                '<span class="rec__who">%s</span></p>'
                % (rec_label(p), esc(rec[0]),
                   (" " + md_inline(rec[1])) if rec[1] else "",
                   esc(rec_who(p))))
    if rec is None:
        return ('<div class="rec rec--none"><span class="ui rec__k">no '
                'recommendation recorded</span><p>The plan carries no view on '
                'this one. If the work has formed one it belongs in %s as '
                '<span class="path">recommend: &lt;slug&gt; %s why</span> '
