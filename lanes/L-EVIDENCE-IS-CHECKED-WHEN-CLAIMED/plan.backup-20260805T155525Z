                    and LOG_RE.match(l.strip())]
    except IOError:
        rows = []
    out.append("## Log " + EMDASH + " %d entries, oldest first" % len(rows))
    out.append("")
    out.append("Append-only. Nothing here is ever edited " + EMDASH + " see %s."
               % md_link(p, p.log_md, "log.md"))
    out.append("")
    out.extend(rows[-500:])
    out.append("")
    out.append("## Probe runs")
    out.append("")
    out.append("%s " % md_link(p, p.stamps, "stamps.log") + EMDASH +
               " the ledger the hand-edit detector compares against.")
    out.append("")
    try:
        with open(p.stamps, "r", encoding="utf-8") as fh:
            srows = [l.rstrip("\n") for l in fh if l.strip()]
    except IOError:
        srows = []
    out.append("```")
    out.extend(srows[-200:])
    out.append("```")
    out.append("")
    return "\n".join(out) + "\n"


def cmd_render(p, args):
    it = load_intent(p)
    sched = Sched(p)
    view = args.get("view", "cockpit")
    if args.get("html"):
        # §1.4: the HTML page is ONE document — nothing is behind a switch,
        # so `--view` no longer opens a tab; it names the section the page
        # opens scrolled to, and an unknown name is still refused.
        if view not in HTML_VIEWS:
            die(EX_REFUSED, "unknown view `%s` (%s)"
                % (view, "|".join(HTML_VIEWS)))
        # the markdown cockpit stays the R-1 anchor `plan check` reads
        render_views(p, sched, it, ["cockpit"])
        out = args.get("out") or os.path.join(p.render_dir, "plan.html")
        out = os.path.abspath(out)
        d = os.path.dirname(out)
        if d and not os.path.isdir(d):
            os.makedirs(d)
        write_atomic(out, html_document(p, sched, it, view,
                                        out_dir=os.path.dirname(out)))
        shown = rel(out, p.repo_root)
        print("wrote %s" % (out if shown.startswith("..") else shown))
        print("wrote %s" % os.path.join(rel(p.render_dir, p.repo_root),
                                        "COCKPIT.md"))
        return EX_OK
    views = ["cockpit"] if view == "cockpit" else ["cockpit", view]
    written = render_views(p, sched, it, views)
    for w in written:
        print("wrote %s" % w)
    return EX_OK




# ---------------------------------------------------------------------------
# 13b. The HTML view — one scrolling document, read down a side rail
#
# DESIGN.md v1.0 is authoritative over everything visual, structural and verbal
# in this section.  The rules it decides, so that changing this file does not
# quietly undo them:
#
#   * ONE DOCUMENT (§5.1).  There are no tabs and no switched views, so R-1 is
#     satisfied structurally: nothing needed can hide behind a switch because
#     there are no switches.  Navigation is a sticky rail of real `<a href="#…">`
#     links with a scrollspy.
#   * THE RENDERER NEVER ORIGINATES (§10).  Every number, order, state and
#     relationship is a projection of plan.md, log.md, intent.md or the
#     scheduler.  Where the design needs a fact the plan does not hold, the
#     stated fallback is implemented and the guess is not: module attribution
#     falls back to the `cleared_by`/`blocks` chain and then to nothing, the
#     wall label falls back to the standing law sentence, the walkthrough block
#     renders nothing at all until its artifact exists.
#   * ONE MARK PER MEANING (§6).  The square vocabulary is the only one; the
#     board cell, the row mark and the rail mark are the same drawing at three
#     sizes.  Every state carries a shape, a word and a colour; every severity a
#     bar length.  Print the page greyscale and all of it survives.
#   * REVERSE VIDEO MEANS YOU.  It is emitted from `needed_actions()` and
#     nowhere else.
#   * THE PAGE IS A SNAPSHOT AND SAYS SO.  Three justified motions (§8), no
#     transforms outside them, nothing that implies liveness.
#   * NO NETWORK.  No CDN, no webfont request, no image, no fetch.  The display
#     face is embedded as a data: URI or it is not used at all.
# ---------------------------------------------------------------------------

# `--view` no longer chooses a tab — there are none.  It chooses which section
# the page opens scrolled to, and an unknown name is still refused.
