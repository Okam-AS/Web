# 12. tick (§3)
# ---------------------------------------------------------------------------

def cmd_tick(p, args):
    it = load_intent(p)
    changed = False

    # -- self-ruling decisions (§2.2 default_if_unruled) ---------------
    # Only in cockpit: §2.1 makes `draft` the phase where the tool writes no
    # state at all, and a plan that is not live must not rule itself.
    today = today_iso()
    for eid in (list(p.order) if p.phase == "cockpit" else []):
        e = p.entities[eid]
        if e.type != "Decision" or e.state == "ruled":
            continue
        dfl = e.get("default_if_unruled", "")
        m = re.match(r"^(\S+) after (\d{4}-\d{2}-\d{2})$", dfl or "")
        if m and today > m.group(2):
            set_block_field(p, e, "ruled", "%s %s by tool"
                            % (m.group(1), today))
            set_block_field(p, e, "state", "ruled")
            e.state = "ruled"
            p.log("ruled %s = %s by default_if_unruled (elapsed %s)"
                  % (eid, m.group(1), m.group(2)))
            print("SELF-RULED %s = %s (default elapsed %s)"
                  % (eid, m.group(1), m.group(2)))
            changed = True

    # -- stage flips (§2.2 — the single case where tick mutates state) --
    for eid in (list(p.order) if p.phase == "cockpit" else []):
        e = p.entities[eid]
        if e.type != "Stage" or e.state == "accepted":
            continue
        needs = e.needs
        if needs and all(satisfied(p, n) for n in needs):
            if e.kind == "block":
                set_block_field(p, e, "state", "accepted")
            else:
                set_state(p, e, "accepted")
            e.state = "accepted"
            p.log("stage %s accepted (all needs accepted)" % eid)
            print("STAGE %s accepted " % eid + EMDASH +
                  " everything needing it recomputes ready")
            changed = True

    if changed:
        p.write_plan()
        _chain_memo.clear()

    sched = Sched(p)
    actions = needed_actions(p, sched)
    write_briefs(p, it, sched.orders + sched.running)

    print(headline(p, sched, after_dispatch=True, actions=actions))

    # -- §3.4: lane summaries above the dispatch orders -----------------
    for line in pending_reports(p):
        print(line)

    if p.phase != "cockpit":
        print("PHASE draft " + EMDASH + " tick dispatches nothing until "
              "`plan sign-off`")
    elif intent_drift(p):
        print("INTENT-DRIFT " + EMDASH + " tick dispatches nothing new until "
              "`plan sign-off --by %s`" % (p.owner or "@owner"))

    for e in sched.orders:
        # An order is advice until the operator acts on it; `plan start` is the
        # event that gets logged (§7 anti-goal 2 — the plan is state, not a
        # diary, and tick is run reflexively).
        print("DISPATCH %s class=%s pts=%s brief=%s"
              % (e.id, e.cls, fmt_num(e.pts),
                 os.path.join("briefs", "%s.md" % e.id)))
    print(sched.class_line())
    for e in sched.held:
        print("HELD %s " % e.id + EMDASH + " passes every capacity gate; the "
              "phase/sign-off lock is shut")
    for e in sched.unauthored:
        print("QUARANTINED %s " % e.id + EMDASH +
              " ready but missing class:/exit: " + EMDASH + " see `plan check`")
    # §2.2: a flag whose clears_when names a fact tick can test — propose it.
    for eid in p.order:
        e = p.entities[eid]
        if e.type == "Flag" and e.state != "cleared":
            verdict, why = flag_condition_met(p, e)
            if verdict == "met":
                print("CLEARABLE %s " % eid + EMDASH + " %s is satisfied "
                      % e.get("clears_when", "") + EMDASH +
                      " `plan flag clear %s`" % eid)
            elif verdict == "owner":
                # Not CLEARABLE: quoting the whole sentence as "satisfied"
                # when half of it was never read is the lie this line used
                # to tell.
                print("OWNER-OWED %s " % eid + EMDASH + " %s " % why +
                      EMDASH + " `plan flag clear %s --override --by %s`"
                      % (eid, p.owner or "@owner"))

    render_views(p, sched, it, ["cockpit"])

    code = EX_OK
    if sched.orders:
        code = EX_DISPATCH
    if actions:
        code = EX_BOTH if sched.orders else EX_OWNER
    return code


def pending_reports(p):
    """§3.4 information fusion: the ≤15-line summaries land above dispatch."""
    out = []
    if not os.path.isdir(p.returns):
        return out
    by_lane = {}
    for name in sorted(os.listdir(p.returns)):
        if not name.endswith(".md"):
            continue
        path = os.path.join(p.returns, name)
        try:
            with open(path, "r", encoding="utf-8") as fh:
                text = fh.read()
        except IOError:
            continue
        m = re.search(r"^RETURN:\s*(\S+)\s*$", text, re.M)
        if not m:
            continue
        lane = m.group(1)
        v = re.search(r"^verdict:\s*(\S+)\s*$", text, re.M)
        # §2.11 continuation: a wrapped `log:` used to be cut at the wrap,
        # so the summary the operator reads stopped mid-sentence.
        lg = re.search(r"^log:[ \t]*(.*(?:\n[ \t]+\S.*)*)", text, re.M)
        summary = " ".join(x.strip() for x in lg.group(1).split("\n")) \
            if lg else ""
        by_lane[lane] = (name, v.group(1) if v else "?", summary.strip())
    for lane, (name, verdict, summary) in sorted(by_lane.items()):
        e = p.entities.get(lane)
        if e is None or e.state not in ("built-unverified", "verified"):
            continue
        out.append("REPORT %s %s " % (lane, e.state) + MDOT +
                   " returns/%s " % name + MDOT + " %s" % summary[:200])
    return out[:15]


