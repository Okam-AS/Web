def view_decisions(p, head):
    out = _head(head, "Decisions", p,
                lede="Forks that need a named human. Each carries what is being "
                     "chosen, what it blocks, its options with one consequence "
                     "per line, the plan's recommendation where it has one, and "
                     "what happens if nobody rules.")
    for phase in ("open", "ruled"):
        rows = [p.entities[i] for i in p.order
                if p.entities[i].type == "Decision"
                and (p.entities[i].state == "ruled") == (phase == "ruled")]
        if not rows:
            continue
        out.append("## %s " % phase.capitalize() + EMDASH + " %d" % len(rows))
        out.append("")
        for e in rows:
            out.append("### %s " % e.id + EMDASH + " %s" % e.title)
            out.append("")
            out.append("%s:%d" % (os.path.basename(p.plan_md), e.line + 1))
            out.append("")
            prose = [p.lines[i] for i in e.prose if p.lines[i].strip()]
            if prose:
                out.append("**Why it is open**")
                out.append("")
                out.extend(prose)
                out.append("")
            held, flags = decision_cost(p, e.id)
            if held or flags:
                out.append("**What it is blocking**")
                out.append("")
                for h in held:
                    out.append("- %s " % h.id + EMDASH + " %s (%s)"
                               % (h.title, UI_STATE[ui_key(p, h)][1]))
                for f in flags:
                    out.append("- %s " % f.id + EMDASH + " %s " % f.title +
                               MDOT + " stays open while that lane waits")
                out.append("")
            out.append("**The options**")
            out.append("")
            rec = recommendation(e)
            for slug, body in option_pairs(e):
                mark = "  **(recommended)**" if rec and rec[0] == slug else ""
                out.append("- `%s`%s" % (slug, mark))
                for label, text in option_facets(body):
                    out.append("  - %s%s" % (("**%s:** " % label) if label
                                             else "", text))
            out.append("")
            if e.state == "ruled":
                out.append("Ruled: %s" % e.get("ruled", "-"))
                out.append("")
                out.append("Reopen when: %s"
                           % (e.get("reopen_when") or "**owed**"))
                out.append("")
                continue
            if rec:
                out.append("**Recommendation** " + EMDASH + " the plan's, not "
                           "a fact: take `%s`. %s" % (rec[0], rec[1]))
            else:
                out.append("**No recommendation is recorded** for this one.")
            out.append("")
            dfl = (e.get("default_if_unruled", "") or "none").strip()
            m = re.match(r"^(\S+) after (\d{4}-\d{2}-\d{2})$", dfl)
            if m:
                out.append("If you do nothing: on %s the tool rules `%s` by "
                           "itself and logs it." % (m.group(2), m.group(1)))
            else:
                out.append("If you do nothing: nothing moves " + EMDASH +
                           " there is no default.")
            out.append("")
            age = p_age(p, e.id)
            if age < (1 << 62):
                out.append("Asked %s ago." % fmt_age(time.time() - age))
                out.append("")
            out.append("```")
            out.append(cmd_for(p, "rule", e))
            out.append("```")
            out.append("")
    return "\n".join(out) + "\n"


