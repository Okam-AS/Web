def view_history(p, head):
    out = _head(head, "History", p,
                lede="What was measured and when, and everything that has "
                     "happened. The plan is state; this is history.")
    now = time.time()
    out.append("## Facts " + EMDASH + " %d" % len(p.facts))
    out.append("")
    if p.facts:
        out.append("| fact | value | age | state | probe |")
        out.append("|---|---|---|---|---|")
        for key in sorted(p.facts):
            f = p.facts[key]
            ts = parse_iso(f.ts)
            pr = p.probes.get(key)
            out.append("| `%s` | %s | %s | %s | %s |"
                       % (key, f.content, fmt_age(now - ts) if ts else "?",
                          "ok" if f.status == "ok" else "**unconf**",
                          ("%s " % pr.kind + MDOT + " %s" % pr.extractor)
                          if pr else "no probe"))
    else:
        out.append("None declared.")
    out.append("")
    try:
        with open(p.log_md, "r", encoding="utf-8") as fh:
