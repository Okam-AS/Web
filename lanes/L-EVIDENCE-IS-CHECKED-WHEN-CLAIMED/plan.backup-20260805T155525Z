/* ---- §5.2 grid ---- */
.page{max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px) 120px}
.shell{display:block}
.doc{min-width:0}
.doc > .sec:first-child{margin-top:0}

