.mk--retracted{background-image:linear-gradient(to top right,
  transparent calc(50% - .9px),currentColor calc(50% - .9px) calc(50% + .9px),
  transparent calc(50% + .9px))}
.t-accepted{color:var(--ink)}
.t-built{color:var(--ink-2)}
.t-verified{color:var(--verified)}
.t-running{color:var(--running)}
.t-ready{color:var(--ink-2)}
.t-open{color:var(--ink-3)}
.t-retracted{color:var(--ink-3)}
