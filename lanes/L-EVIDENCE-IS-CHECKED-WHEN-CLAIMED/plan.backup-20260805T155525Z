# -- §5 of NOTES.md: the owner's prose, and the surface that composes it ----
#
# Two halves that must not be confused.  A *recorded* note is the file talking
# and renders in his voice — the `--inset` well and the 2px ink left border the
# log already gives `@sven` rows (DESIGN §7.9), so the mark means the same
# thing in both places.  A *composer* is this browser talking and records
# nothing by itself: served it POSTs to the same verbs a terminal would run,
# static it can only collect words, and it says which of those it is.

_SERVE = [False]
_WR_N = [0]


def note_paragraphs(text):
    """A note body as paragraphs.  A blank line inside a note is written `>`
    and comes back as an empty line, so the grouping is the author's."""
    paras, cur = [], []
    for row in text.split("\n"):
        if row.strip():
            cur.append(row)
        elif cur:
            paras.append(cur)
            cur = []
    if cur:
        paras.append(cur)
    return paras


def h_note(nt):
    """One recorded note.  Attribution in `data-2` mono, body in `body-2`, and
    `data-note-body` carries the whitespace-normalised words so a pending draft
    in some browser can recognise itself as recorded and delete itself."""
    body = "".join('<p>%s</p>' % md_inline(" ".join(pa))
                   for pa in note_paragraphs(nt.text)) or "<p></p>"
    return ('<div class="note" data-note-for="%s" data-note-body="%s">'
            '<p class="note__by">%s &middot; %s</p>'
            '<div class="note__b">%s</div></div>'
            % (esc(nt.target), esc(" ".join(nt.text.split())),
               esc(nt.actor), esc(nt.date), body))


def h_notes(p, eid):
    return "".join(h_note(nt) for nt in notes_for(p, eid))


def h_write(eid, verb, summary, lede, rows="", placeholder="",
            inline=False, text=True):
    """The composer.  One text field, one button, one status line, plus the
    extra fields a flag needs.

    Served, the button runs the verb through the same CLI a terminal would and
    the page reloads from the file.  Static, it can only put words in the
    basket — and every word of its own copy says so.  That is the whole
    honesty of this control: it must never look like it saved something."""
    serve = _SERVE[0]
    # one document may open the same composer twice (a card in the queue and
    # the same entity in a ledger); the field id has to stay unique or the
    # label points at the wrong box
    _WR_N[0] += 1
    fid = "wr-%s-%s-%d" % (verb, eid, _WR_N[0])
    field = ""
    if text:
        if inline and serve:
            field = ('<input class="wr__i" type="text" id="%s" '
                     'data-write-text="1" placeholder="%s">'
                     % (esc(fid), esc(placeholder)))
        else:
            field = ('<textarea class="wr__t" id="%s" rows="3" '
                     'data-write-text="1" placeholder="%s"></textarea>'
                     % (esc(fid), esc(placeholder)))
    label = (('<label for="%s">%s</label>' % (esc(fid), esc(lede))) if text
             else esc(lede))
    inner = ('<p class="wr__l">%s</p>%s%s'
             '<div class="wr__a"><button class="wbtn%s" type="button" '
             'data-write="%s" data-entity="%s" data-verb="%s">%s</button>'
             '<span class="said wr__say" role="status"></span></div>%s'
             % (label, rows, field,
                " wbtn--go" if serve else "", esc(verb), esc(eid), esc(verb),
                "record" if serve else "add to basket",
                h_slot("%s#%s" % (eid, verb))))
    if inline and serve:
        return ('<div class="wr wr--inline" data-write-for="%s">%s</div>'
                % (esc(eid), inner))
    return ('<details class="wr" data-write-for="%s"><summary class="wr__s">'
            '%s</summary><div class="wr__b">%s</div></details>'
            % (esc(eid), summary, inner))


def h_write_note(p, eid, summary=None):
    """The note composer.  One wording wherever it opens (§5): the label is
    the promise, and it is the promise the tool keeps."""
    return h_write(eid, "note", summary or ("note on " + esc(eid)),
