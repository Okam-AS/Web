#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""plan — reference implementation of THE PLAN STANDARD v1.0.

Binding standard: ../reference/SPEC.md.  Every "§n" in this file cites it.
Where the spec is genuinely silent, the choice is marked  CHOICE(§n): ...
naming the section being extended.

Constraints this file honours (§5):
  * standard library only, no third-party import, single file, Python 3.9+
  * no outbound network, ever; no suite execution, ever (the extractor
    vocabulary in §2.6 is closed and has no exec form — that is the
    enforcement).  CHOICE(§5): `plan serve` binds a loopback listener while it
    runs and is the only socket in the file; it makes no request of anything,
    and the rendered file it replaces stays network-free.
  * no git subprocess on the hot path (tick/headline/refresh)
  * single-pass line-oriented parse; no YAML library
  * the tool never writes outside its territory (§1.2): refresh touches only
    the inside of fact spans; mutation verbs touch only state: fields, the
    lines they own, and the log.  Human prose is never deleted or reflowed.
"""

import os
import re
import sys
import time

