def render_views(p, sched, it, views):
    if not os.path.isdir(p.render_dir):
        os.makedirs(p.render_dir)
    actions = needed_actions(p, sched)
    head = headline(p, sched, actions=actions)
    written = []
    for v in views:
        if v == "cockpit":
            text = view_cockpit(p, sched, it, head, actions)
            name = "COCKPIT.md"
        elif v == "roadmap":
            text = view_roadmap(p, sched, head)
            name = "ROADMAP.md"
        elif v == "lanes":
            text = view_lanes(p, sched, head)
            name = "LANES.md"
        elif v == "decisions":
            text = view_decisions(p, head)
            name = "DECISIONS.md"
        elif v == "flags":
            text = view_flags(p, head)
            name = "FLAGS.md"
        elif v == "why":
            text = view_why(p, it, head)
            name = "WHY.md"
        elif v == "history":
            text = view_history(p, head)
            name = "HISTORY.md"
        else:
            die(EX_REFUSED, "unknown view `%s` (cockpit|roadmap|lanes|"
                            "decisions|flags|why|history)" % v)
        write_atomic(os.path.join(p.render_dir, name), text)
        written.append(os.path.join(rel(p.render_dir, p.repo_root), name))
    return written


def md_rel(p, target):
    """A relative link from render/ to a file in the repo, so the Markdown
    views open their own sources from a checkout, a terminal or GitHub."""
    try:
        return os.path.relpath(target, p.render_dir).replace(os.sep, "/")
    except ValueError:
        return target


def md_link(p, target, label=None):
    return "[%s](%s)" % (label or os.path.basename(target), md_rel(p, target))


def _head(head, title, p, lede=None):
    # §1.2 wants the GENERATED marker first; §1.4 R-1 wants the headline first.
    # RESOLUTION: the marker is an HTML comment and renders to nothing, so the
    # headline is the first line of the *view*; the marker is line 1 of the
    # file.  Both survive.
    out = [GEN_MARK, head, "",
           "# %s " % title + EMDASH + " %s" % p.name, ""]
    out.append("**%s** %s phase %s %s generated %s"
               % (p.owner or "no owner", MDOT, p.phase, MDOT, now_iso()))
    out.append("")
    out.append("Sources: %s %s %s %s %s %s %s"
               % (md_link(p, p.plan_md, "plan.md"), MDOT,
                  md_link(p, p.intent_md, "intent.md"), MDOT,
                  md_link(p, p.log_md, "log.md"), MDOT,
                  "[plan.html](plan.html) (the same thing, operable)"))
    out.append("")
    if lede:
        out.append("> %s" % lede)
        out.append("")
    return out


def state_chip(e):
    return "[%s]" % (STATE_CHAR.get(e.state, "?") if e.state else "?")


def md_objective(it):
    """One sentence of WHY at the top of the fallback view, so the Markdown is
    not a worse document than the page."""
    paras = intent_paragraphs(it, "objective")
    return first_sentence(paras[0], 300) if paras else ""


def md_needed_block(p, actions):
    """The one section that may never be incomplete (§1.4 R-1)."""
    out = ["## What needs you " + EMDASH + " %d" % len(actions), ""]
    if not actions:
        out.append("Nothing is waiting on %s. Every open item is owned by the "
                   "machine, by upstream work, or by nobody." % (p.owner
                                                                 or "the owner"))
        out.append("")
        return out
    out.append("Everything here waits on %s and on nobody else."
               % (p.owner or "the owner"))
    out.append("")
    for n, (verb, eid, title) in enumerate(actions, 1):
        e = p.entities.get(eid)
        out.append("%d. **%s %s** " % (n, verb, eid) + EMDASH + " %s" % title)
        detail = []
        if e is not None and e.type == "Decision" and e.state != "ruled":
            age = p_age(p, eid)
            if age < (1 << 62):
                detail.append("asked %s ago" % fmt_age(time.time() - age))
            slugs = [x for x, _b in option_pairs(e)]
            if slugs:
                detail.append("options `%s`" % "` `".join(slugs))
            rec = recommendation(e)
            if rec:
                detail.append("**recommended: %s** (the plan's view, not a "
                              "ruling)" % rec[0])
            else:
                detail.append("no recommendation recorded")
        if verb == "write" and e is not None:
            detail.append("ruled %s" % e.get("ruled", "-"))
            detail.append("`reopen_when:` is owed " + EMDASH + " one sentence, "
                          "and only the owner may write it")
        if e is not None and e.type == "Flag":
            detail.append("clears when %s" % e.get("clears_when", "(owed)"))
        if e is not None and e.state == "verified":
            detail.append("evidence %s" % e.get("evidence", "none"))
        if e is not None:
            waiting = [i for i in p.order if eid in p.entities[i].needs]
            if waiting:
                detail.append("holds %s" % ", ".join(waiting))
            detail.append("%s:%d" % (os.path.basename(p.plan_md), e.line + 1))
        if verb == "re-sign":
            detail.append("intent.md hashes to %s, plan signed %s"
                          % (intent_hash(p), p.front.get("signed", "-")))
        if detail:
            out.append("   %s" % (" " + MDOT + " ").join(detail))
        out.append("")
        out.append("   ```")
        out.append("   %s" % (cmd_for(p, verb, e) if e is not None
                              else "plan sign-off --by %s" % (p.owner
                                                              or "@owner")))
        out.append("   ```")
        out.append("")
    return out


def md_evidence_block(p):
    ep = evidence_picture(p)
    st = ep["states"]
    out = ["## Evidence " + EMDASH + " how anything here becomes true", ""]
    out.append("| state | count | who moves next |")
    out.append("|---|---:|---|")
    for key, who in (("accepted", "nobody"), ("verified", "you"),
                     ("built-unverified", "the builder"),
                     ("running", "the machine"), ("ready", "the scheduler"),
                     ("blocked", "upstream"), ("retracted", "the record")):
        if st.get(key):
            out.append("| %s | %d | %s |" % (key, st[key], who))
    out.append("")
    nb = st.get("built-unverified", 0)
    if nb:
        out.append("%d of %d capabilities are built and unverified. `plan "
                   "verify` refuses a test-suite count as evidence (guard 1), "
                   "so an item leaves that state only when a non-suite "
                   "instrument exists and is named." % (nb, ep["n"]))
        if ep["inadmissible"]:
            out.append("")
            out.append("%d of them currently point at suite output, which is "
                       "exactly what the guard refuses." % ep["inadmissible"])
    elif ep["n"]:
        out.append("Nothing is sitting in built-unverified.")
    out.append("")
    kinds = ", ".join("%d %s" % (v, k) for k, v in sorted(ep["kinds"].items()))
    out.append("Probes: %s. Unconfirmed facts right now: %d."
               % (kinds or "none declared", ep["unconf"]))
    out.append("")
    if ep["blockers"]:
        out.append("Blocker flags that say why:")
        out.append("")
        for f in ep["blockers"]:
            out.append("- **%s** " % f.id + EMDASH + " %s" % f.title)
            out.append("  clears when %s%s"
                       % (f.get("clears_when", "(owed)"),
                          (" " + MDOT + " the lane that would do it is %s"
                           % f.get("cleared_by")) if f.get("cleared_by", "")
                          else ""))
        out.append("")
    return out


def view_cockpit(p, sched, it, head, actions):
    out = _head(head, "Cockpit", p, lede=md_objective(it))
    out.extend(md_needed_block(p, actions))
    out.extend(md_evidence_block(p))

    out.append("## In flight " + EMDASH + " %d of %d"
               % (len(sched.running), sched.caps["global"]))
    out.append("")
    out.append("Past tense on purpose: these are the last events written to "
               "log.md before this file was generated, not a signal that "
               "anything is alive now.")
    out.append("")
    for e in sched.running:
        out.append("- **%s** " % e.id + EMDASH + " %s " % e.title + MDOT +
                   " %s " % (e.cls or "no class") + MDOT + " exit: %s"
                   % e.get("exit", "(none declared)"))
    if not sched.running:
        out.append("- no lane is running")
    out.append("")

    out.append("## Ready " + EMDASH + " %d" % len(sched.ready))
    out.append("")
    out.append("Readiness is computed on every invocation and stored nowhere.")
    out.append("")
    if sched.orders:
        for e in sched.orders:
            out.append("- **DISPATCH %s** " % e.id + EMDASH + " %s " % e.title)
            out.append("  class %s " % e.cls + MDOT + " pts %s "
                       % fmt_num(e.pts) + MDOT + " brief `briefs/%s.md`" % e.id)
    else:
        out.append("- nothing dispatches: %s"
                   % ("the %d ready lane(s) are all cap-waiting"
                      % len(sched.capwait) if sched.capwait
                      else "nothing is ready"))
    for e in sched.capwait:
        out.append("- CAP-WAIT %s " % e.id + EMDASH + " ready, and the %s pool "
                   "is full" % (e.cls or "?"))
    out.append("")
    out.append("`%s`" % sched.class_line())
    out.append("")

    blocked = [e for e in lanes(p)
               if e.state == "open" and not is_ready(p, e) and not e.is_micro]
    out.append("## Blocked " + EMDASH + " %d" % len(blocked))
    out.append("")
    for e in blocked:
        out.append("- **%s** " % e.id + EMDASH + " %s " % e.title + MDOT +
                   " waiting on %s" % ", ".join(blocked_by(p, e)))
    if not blocked:
        out.append("- nothing is blocked")
    out.append("")

    out.append("## Flags")
    out.append("")
    for sev in ("blocker", "warn", "info"):
        rows = [p.entities[i] for i in p.order
                if p.entities[i].type == "Flag"
                and p.entities[i].get("severity", "") == sev]
        if not rows:
            continue
        out.append("**%s**" % sev)
        out.append("")
        for e in rows:
            out.append("- %s [%s] " % (e.id, (e.state or "?")) + EMDASH +
                       " %s" % e.title)
            out.append("  clears when: %s" % e.get("clears_when", "-"))
        out.append("")

    out.append("## Decisions")
    out.append("")
    for eid in p.order:
        e = p.entities[eid]
        if e.type != "Decision":
            continue
        if e.state == "ruled":
            out.append("- %s " % eid + EMDASH + " ruled %s"
                       % e.get("ruled", "-"))
        else:
            out.append("- **%s** " % eid + EMDASH + " open " + MDOT + " %s"
                       % e.title)
            slugs = [x for x, _b in option_pairs(e)]
            if slugs:
                out.append("  options: `%s`" % "` `".join(slugs))
    out.append("")

    out.append("## Facts")
    out.append("")
    now = time.time()
    if p.facts:
        out.append("| fact | value | age | state |")
        out.append("|---|---|---|---|")
        for key in sorted(p.facts):
            f = p.facts[key]
            ts = parse_iso(f.ts)
            age = fmt_age(now - ts) if ts else "?"
            out.append("| `%s` | %s | %s | %s |"
                       % (key, f.content, age,
                          "ok" if f.status == "ok" else "**unconf**"))
    else:
        out.append("None declared.")
    out.append("")

    disputes = compute_disputes(p)
    out.append("## Disputes " + EMDASH + " %d" % len(disputes))
    out.append("")
    if not disputes:
        out.append("None. No authored claim contradicts a probed fact.")
    for d in disputes:
        out.append("- %s" % d)
    out.append("")

    stages = [p.entities[i] for i in p.order if p.entities[i].type == "Stage"]
    if stages:
        out.append("## Stages")
        out.append("")
        for e in stages:
            out.append("- %s [%s] " % (e.id, e.state) + EMDASH + " %s"
                       % e.title)
        out.append("")

    out.append("---")
    out.append("")
    out.append("This file is a projection of %s and is rewritten on every "
               "`plan render`; edits here are discarded. The authored truth "
               "lives in %s, %s and %s."
               % (md_link(p, p.plan_md, "plan.md"),
                  md_link(p, p.plan_md, "plan.md"),
                  md_link(p, p.intent_md, "intent.md"),
                  md_link(p, p.log_md, "log.md")))
    out.append("")
    return "\n".join(out) + "\n"


def compute_disputes(p):
    """§2.5/§5: a verified/accepted entity whose exit rests on a fact that is
    now unconf (or was hand-edited).  The renderer never edits the text."""
    out = []
    for eid in p.order:
        e = p.entities[eid]
        if e.state not in ("verified", "accepted"):
            continue
        for k in re.findall(r"fact:([A-Za-z0-9_.-]+)", e.get("exit", "")):
            f = p.facts.get(k)
            if f is None:
                out.append("%s is %s but fact:%s has no span" % (eid, e.state, k))
            elif f.status != "ok":
                out.append("%s is %s but fact:%s is unconf since %s"
                           % (eid, e.state, k, f.ts))
    return out


def view_roadmap(p, sched, head):
    out = _head(head, "Roadmap", p,
                lede="Topology, not time. Each feature's own steps, where the "
                     "chain stops, and the next thing that could be observed "
                     "to happen. Nothing here is a duration or a date.")
    actions = needed_actions(p, sched)
    mine = mine_map(actions)
    feats = [p.entities[i] for i in p.order if p.entities[i].type == "Feature"]
    if not feats:
        out.append("No Feature entities are declared.")
        out.append("")
    for n, ft in enumerate(feats, 1):
        stop, kind, nxt, who, nodes, done = rail_frontier(p, ft, mine, sched)
        out.append("## %02d " % n + EMDASH + " %s" % ft.title)
        out.append("")
        out.append("%s " % ft.id + MDOT + " %s:%d "
                   % (os.path.basename(p.plan_md), ft.line + 1) + MDOT +
                   " %s" % ("all %d steps closed" % len(nodes) if stop is None
                            else "%d steps, %d closed, stopped at step %d"
                            % (len(nodes), done, stop + 1)))
        out.append("")
        for i, nd in enumerate(nodes):
            word = UI_STATE[ui_key(p, nd)][1]
            here = " " + EMDASH + " **stopped here**" if i == stop else ""
            out.append("%d. `[%s]` %s " % (i + 1, word, nd.id) + MDOT + " %s%s"
                       % (nd.title if nd is not ft
                          else "%s accepts it" % (p.owner or "the owner"),
                          here))
        out.append("")
        label = {"person": "waiting on a person", "machine": "in flight",
                 "work": "waiting on work", "none": "finished"}.get(kind, kind)
        out.append("**Next (%s):** %s" % (label, nxt))
        out.append("")
    return "\n".join(out) + "\n"


