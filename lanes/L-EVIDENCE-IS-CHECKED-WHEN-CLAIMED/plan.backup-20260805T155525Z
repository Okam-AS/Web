def decide_utterance(p, e, slug):
    return "plan decide %s --choose %s --by %s" % (e.id, slug,
                                                   p.owner or "@owner")


def option_pairs(e):
    """[(slug, rationale)] in the order the decision declares them."""
    out = []
    for o in e.get("options", "").split("\n"):
        o = o.strip()
        if not o:
            continue
        parts = re.split(r"\s+" + EMDASH + r"\s+|\s+-\s+", o, maxsplit=1)
        out.append((parts[0].strip(),
                    parts[1].strip() if len(parts) > 1 else ""))
    return out


FACET_SPLIT = re.compile(r"\s*;\s+(?=[a-z][a-z /-]{0,18}:)")
FACET_KEY = re.compile(r"^([a-z][a-z /-]{0,18}):\s*(.*)$")


def option_facets(body):
    """`pro: x; con: y; cost: z` becomes three lines, because a pro and a con
    run together in one sentence is a sentence nobody weighs.  Text that
    carries no `label:` is left exactly as written."""
    out = []
    for chunk in FACET_SPLIT.split(body):
        chunk = chunk.strip()
        if not chunk:
            continue
        m = FACET_KEY.match(chunk)
        if m:
            out.append((m.group(1), m.group(2).strip()))
        else:
            out.append(("", chunk))
    return out


def h_facets(body):
    facets = option_facets(body)
    if not facets:
        return ""
    rows = []
    for label, text in facets:
        rows.append('<span class="fac">%s<span>%s</span></span>'
                    % (('<b class="fac__k">%s</b>' % esc(label)) if label
                       else "", esc(text)))
    return '<span class="opt__body">%s</span>' % "".join(rows)


def recommendation(e):
    """(slug, reasoning) or None.  Authored in plan.md and nowhere else."""
    rec = (e.get("recommend", "") or "").strip()
    if not rec:
        return None
    parts = re.split(r"\s+" + EMDASH + r"\s+|\s+-\s+", rec, maxsplit=1)
    return (parts[0].strip(), parts[1].strip() if len(parts) > 1 else "")


def decision_cost(p, eid):
    """What is standing still while this is unruled: the entities that name it,
    and the flags those entities would have cleared."""
    held = [p.entities[i] for i in dependents(p, eid)]
    ids = set(x.id for x in held)
    flags = [p.entities[i] for i in p.order
             if p.entities[i].type == "Flag"
             and p.entities[i].state != "cleared"
             and p.entities[i].get("cleared_by", "") in ids]
    return held, flags




def h_options(p, e, ruled_slug=None, compact=False):
    """A decision card ends with the literal words that resolve it.  Each
    option is a button whose only effect is to put those words in the basket
    and mark this browser's intention as pending."""
    pairs = option_pairs(e)
    if not pairs:
        return ""
    rec = recommendation(e)
    rows = []
    for slug, body in pairs:
        tag = ""
        if rec and rec[0] == slug:
            # a name, not an imprimatur: whoever wrote the line owns it
            who = rec_provenance(p)
            tag = ('<span class="opt__rec ui">recommended%s</span>'
                   % ((" by " + esc(who[0])) if who else ""))
        if ruled_slug is not None:
            rows.append('<div class="opt opt--ruled"><span class="opt__slug">'
                        '%s%s</span>%s<span class="opt__pick ui">%s</span>'
                        '</div>'
                        % (esc(slug), tag, h_facets(body),
                           "ruled" if slug == ruled_slug else ""))
            continue
        rows.append('<button class="opt" type="button" data-utter="%s" '
                    'data-entity="%s" data-verb="decide" data-choice="%s" '
                    'aria-pressed="false"><span class="opt__slug">%s%s</span>'
                    '%s<span class="opt__pick ui">choose</span></button>'
                    % (esc(decide_utterance(p, e, slug)), esc(e.id), esc(slug),
                       esc(slug), tag, "" if compact else h_facets(body)))
    return '<div class="opts">%s</div>' % "".join(rows)


def h_card_sec(label, body):
