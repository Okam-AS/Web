def h_decision_cost(p, e, compact=False):
    held, flags = decision_cost(p, e.id)
    if compact:
        if not held and not flags:
            return ('<p class="row__sub dim">Nothing in the plan names this '
                    'decision.</p>')
        bits = []
        if held:
            bits.append("holds " + ", ".join(h_id(h.id) for h in held))
        if flags:
            bits.append(", ".join(h_id(f.id) for f in flags) +
                        (" stays open" if len(flags) == 1 else " stay open")
                        + " until it lands")
        return '<p class="row__sub">%s</p>' % " · ".join(bits)
    if not held and not flags:
        return h_card_sec("what it is blocking",
                          '<p class="dim">Nothing in the plan names this '
                          'decision, so nothing is standing still on it.</p>')
    rows = []
    for h in held:
        rows.append('<li>%s <span>%s</span> <span class="dim">%s</span></li>'
                    % (h_id(h.id), ttl(clip(h.title, 96)),
                       esc(UI_STATE[ui_key(p, h)][1])))
    for f in flags:
        rows.append('<li>%s <span>%s stays open while that lane waits</span>'
                    '</li>' % (h_id(f.id), ttl(clip(f.title, 88))))
    return h_card_sec("what it is blocking",
                      '<ul class="held">%s</ul>' % "".join(rows))


_rec_who_memo = {}


def rec_provenance(p):
    """Who authored the `recommend:` lines, from log.md rather than from a
    phrase in the renderer.  "the plan's view" launders authorship: a
    recommendation has an author and a date, and the log already holds them."""
    key = id(p)
    if key in _rec_who_memo:
        return _rec_who_memo[key]
    out = None
    try:
        with open(p.log_md, "r", encoding="utf-8") as fh:
            for raw in fh:
                m = LOG_RE.match(raw.strip())
                if m and "recommend" in m.group(3).lower():
                    out = (m.group(2), m.group(1)[:10])
    except IOError:
        pass
    _rec_who_memo[key] = out
    return out


def rec_who(p):
    who = rec_provenance(p)
    if who is None:
        return ("a recommendation authored in plan.md; no log entry records "
                "who wrote it or when — a position, not a ruling and not a "
                "fact")
    return ("a recommendation %s wrote on %s, from reading the plan — one "
            "pass, not a ruling and not a fact" % (who[0], who[1]))


def rec_label(p):
    """A name, not an imprimatur: whoever wrote the line owns it."""
    who = rec_provenance(p)
    return ("%s&rsquo;s pick" % esc(who[0])) if who \
        else "an unattributed recommendation"


def h_decision_rec(p, e, compact=False):
