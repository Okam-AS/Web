# 18. CLI
# ---------------------------------------------------------------------------

BOOL_FLAGS = ("fresh", "accept-stale", "override", "help", "version", "html",
               "open")

# The closed flag vocabulary (§7 anti-goal 1).  Without it an unknown flag was
# assumed to take a value, so `plan sign-off --force` reported "--force needs a
# value" — which reads as "supply one" and sent a trial user hunting for the
# argument to a flag that does not exist.
VALUE_FLAGS = ("dir", "by", "agent", "evidence", "reason", "choose",
               "severity", "clears-when", "clears_when", "title", "owner",
               "cleared-by", "port", "view", "out",
               # NOTES.md §2
               "text", "reopen-when", "reopen_when")

USAGE = """plan — THE PLAN STANDARD v%s

  plan init [--dir D]                     scaffold docs/plan/ (starts in draft)
  plan sign-off --by @h                   hash intent.md, enter cockpit
  plan check [--fresh]                    full sweep; file:line severity rule msg
  plan refresh                            re-probe every fact span
  plan tick                               readiness, caps, briefs, dispatch
  plan render [--view V]                  cockpit|roadmap|lanes|decisions|flags|why|history
  plan render --html [--out F] [--view V] one self-contained page, all views,
                                          no network — opens from file://
  plan serve [--port N] [--open]          the same page on loopback, where the
                                          buttons run the verbs themselves
  plan headline                           the one line
  plan start ID --agent N                 open -> running
  plan built ID --evidence E              running -> built-unverified
  plan verify ID --evidence E             built-unverified -> verified
  plan unverify ID --reason R             verified -> built-unverified (undo)
  plan accept ID --by @h                  verified -> accepted (owner only)
  plan retract ID --reason R              any state -> retracted
  plan decide D --choose S --by @h        rule a decision (owner only)
  plan flag add|clear F [...]             raise or clear a flag
  plan note ID --by @h [--text "…"]       record the owner's words beside an
                                          entity; no --text reads stdin
  plan return FILE [--accept-stale]       merge a RETURN block
  plan log "TEXT" --by A                  append to log.md
  plan compact                            truncate stamps.log

  global: --dir D   operate on this plan directory instead of walking up

exit: 0 ok · 1 check violations · 2 parse-fatal · 3 precondition refused ·
      4 unconfirmed facts · 5 RETURN rejected · 6 evidence inadmissible ·
      10 dispatch orders · 11 owner needed · 12 both
""" % VERSION


def parse_argv(argv):
    args = {}
    pos = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--"):
            key = a[2:]
            if "=" in key:
                key, val = key.split("=", 1)
                args[key] = val
            elif key in BOOL_FLAGS:
                args[key] = True
            elif key not in VALUE_FLAGS:
                die(EX_REFUSED, "unknown flag `--%s` " % key + EMDASH +
                    " the flag vocabulary is closed (try `plan help`)")
            else:
                if i + 1 >= len(argv):
                    die(EX_REFUSED, "--%s needs a value" % key)
                args[key] = argv[i + 1]
                i += 1
        else:
            pos.append(a)
        i += 1
    for n, v in enumerate(pos[1:], start=1):
        args["_%d" % n] = v
    args["_cmd"] = pos[0] if pos else None
    return args


NEEDS_PLAN = {
    "sign-off": cmd_sign_off, "check": cmd_check, "refresh": cmd_refresh,
    "tick": cmd_tick, "render": cmd_render, "headline": cmd_headline,
    "start": cmd_start, "built": cmd_built, "verify": cmd_verify,
    "unverify": cmd_unverify,
    "accept": cmd_accept, "retract": cmd_retract, "decide": cmd_decide,
    "flag": cmd_flag, "return": cmd_return, "log": cmd_log,
    "note": cmd_note,
    "compact": cmd_compact, "serve": cmd_serve,
}


def main(argv):
    args = parse_argv(argv)
    cmd = args.get("_cmd")
    # `--version` before the no-command branch: `plan --version` has no
    # positional word, so it used to fall through to USAGE and print the help.
    if args.get("version") or cmd == "version":
        print("plan %s" % VERSION)
        return EX_OK
    if not cmd or args.get("help") or cmd in ("help", "-h", "--help"):
        sys.stdout.write(USAGE)
        return EX_OK
    if cmd == "init":
        return cmd_init(None, args)
    fn = NEEDS_PLAN.get(cmd)
    if fn is None:
        die(EX_REFUSED, "unknown command `%s` (try `plan help`)" % cmd)
    plan_dir = discover(args.get("dir"))
    p = load(plan_dir)
    if p.fatal:
        line, msg = p.fatal
        eprint("%s:%d parse-fatal %s" % (rel(p.plan_md, p.repo_root),
                                         line + 1, msg))
        return EX_PARSE
    return fn(p, args)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(EX_OK)
    except KeyboardInterrupt:
        sys.exit(130)
