def option_slugs(p):
    """Every option slug this plan declares, longest first.

    Read from `p.lines` rather than a parsed field, because the option block
    is a continuation whose stored shape is an implementation detail; the
    literal `| <slug> ' + chr(0x2014) + '` opener is the standard's own grammar."""
    out = set()
    for line in p.lines:
        m = re.match(r"\s*\|\s*([a-z0-9][a-z0-9-]*)\s", line)
        if m:
            out.add(m.group(1))
    return sorted(out, key=len, reverse=True)

NOTE_RE = re.compile(
    r"^> (@[A-Za-z0-9_.-]+) " + MDOT + r" (\d{4}-\d{2}-\d{2}) " + MDOT +
    r" (\S+) (?:" + EMDASH + r"|\u2013|-) (.*)$")
ACTOR_RE = re.compile(r"^(@[A-Za-z0-9_.-]+|tool|agent:[A-Za-z0-9_.:/-]+)$")
