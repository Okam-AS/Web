def require_cockpit(p):
    if p.phase != "cockpit":
        die(EX_REFUSED, "phase is `draft` " + EMDASH +
            " mutation verbs refuse until `plan sign-off`")


def get_entity(p, eid):
    e = p.entities.get(eid)
    if e is None:
        die(EX_REFUSED, "no entity `%s` in the plan" % eid)
    return e


def cmd_start(p, args):
    require_cockpit(p)
    eid = args["_1"]
    e = get_entity(p, eid)
    agent = args.get("agent")
    if not agent:
        die(EX_REFUSED, "`start` needs --agent <name>")
    if e.state != "open":
        die(EX_REFUSED, "%s is `%s`; start requires `open` " % (eid, e.state) +
            EMDASH + " no skips (§2.4 guard 3)")
    if not is_ready(p, e):
        die(EX_REFUSED, "%s is not ready " % eid + EMDASH + " unmet: %s"
            % ", ".join(blocked_by(p, e)))
    set_state(p, e, "running")
    if e.kind == "block":
        set_block_field(p, e, "agent", agent)
    p.write_plan()
    p.log("started %s" % eid, actor="agent:%s" % agent)
    print("%s open -> running (agent:%s)" % (eid, agent))
    return EX_OK


def cmd_built(p, args):
    require_cockpit(p)
    eid = args["_1"]
    e = get_entity(p, eid)
    ev = args.get("evidence")
    if not ev:
        die(EX_REFUSED, "`built` needs --evidence")
    if e.state != "running":
        die(EX_REFUSED, "%s is `%s`; built requires `running` " % (eid, e.state)
            + EMDASH + " no skips (§2.4 guard 3)")
    openk = [c.id for c in micro_children(p, e) if c.state in ("open",
                                                               "running")]
    if openk:
        die(EX_REFUSED, "%s has unfinished micro-items: %s " % (eid,
            ", ".join(openk)) + EMDASH + " they participate in readiness")
    set_state(p, e, "built-unverified")
    set_evidence(p, e, ev)
    p.write_plan()
    p.log("%s running -> built-unverified, evidence %s" % (eid, ev))
    print("%s running -> built-unverified" % eid)
    return EX_OK


def exit_tokens(ex):
    """The instruments an exit criterion names: its `fact:` references (with
    any `=value` demand) and its path-shaped words."""
    facts = re.findall(r"fact:[A-Za-z0-9_.-]+(?:=[^\s\"']+)?", ex)
    paths = [t.strip("\"'`,;()") for t in re.split(r"\s+", ex)
             if "/" in t and not t.startswith("fact:")]
    return facts, [t for t in paths if t]


def names_the_instrument(p, ev, ent):
    """§6.1 has demanded "observable + instrument" since v1.0 and nothing
    consumed it: `touch lanes/L-X/note.txt` verified any lane.  The exit is
    the contract, so the evidence has to be something the exit named."""
    ex = ent.get("exit", "")
    if not ex.strip():
        return False, ("%s has no `exit:` " % ent.id + EMDASH +
                       " there is no instrument to measure the evidence "
                       "against (§6.1)")
    facts, paths = exit_tokens(ex)
    if ev.startswith("fact:"):
        key = ev[5:].split("=", 1)[0]
        for tok in facts:
            tkey, _, tval = tok[5:].partition("=")
            if tkey != key:
                continue
            if tval and "=" not in ev:
                return False, ("exit: names `%s`; evidence `%s` does not say "
                               "what the fact must read" % (tok, ev))
            return True, ""
        return False, ("exit: “%s” does not name fact:%s" % (ex.strip(), key))
    for tok in paths:
        if ev.startswith(tok) or tok.startswith(ev):
            return True, ""
    return False, ("exit: “%s” does not name %s" % (ex.strip(), ev))


def evidence_admissible(p, ev, ent=None):
    """§2.4 guard 1.  Returns (ok, reason).  With `ent`, also enforces §6.1:
    the evidence must be the instrument that entity's `exit:` named."""
    # Kind and status first: "this is the wrong sort of evidence" is a more
    # fundamental refusal than "your exit did not ask for it", and it is the
    # sentence the author needs to read.
    good, why = _evidence_kind_ok(p, ev)
    if not good:
        return False, why
    if ent is not None:
        return names_the_instrument(p, ev, ent)
    return True, ""


def _evidence_kind_ok(p, ev):
    if ev.startswith("fact:"):
        key, _, want = ev[5:].partition("=")
        pr = p.probes.get(key)
        if pr is None:
            return False, "no probe declares fact:%s" % key
        if pr.kind == "suite":
            return False, ("fact:%s is a suite-kind probe " % key + EMDASH +
                           " a green test suite does not exit "
                           "built-unverified")
        if pr.kind not in ADMISSIBLE_KINDS:
            return False, "probe kind `%s` is not admissible" % pr.kind
        if pr.extractor == "exists":
            # `exists` reports that a file is there and nothing about what it
            # says, so it can only ever read "present" — a probe that cannot
            # fail is not evidence (§7 anti-goal 5).
            return False, ("fact:%s uses the `exists` extractor " % key +
                           EMDASH + " a file being there is not a claim "
                           "about what it says")
        f = p.facts.get(key)
        if f is None:
            return False, "fact:%s has no span in plan.md" % key
        if f.status != "ok":
            return False, "fact:%s is `%s`, not `ok`" % (key, f.status)
        if want and f.content.strip() != want:
            # `status: ok` only means the probe read the file.  A journey
            # probe extracting the word "failed" was admissible until now.
            return False, ("fact:%s reads `%s`, not `%s`"
                           % (key, f.content.strip(), want))
        return True, ""
    path = ev if os.path.isabs(ev) else os.path.join(p.repo_root, ev)
    if not os.path.exists(path):
        return False, "evidence path does not exist: %s" % ev
    # §2.4 says "an existing repo path", which would admit a .trx by the back
    # door while the same file is inadmissible as fact:.  Closing that hole:
    # a path that a suite-kind probe already claims is suite-kind evidence.
    import fnmatch
    for pr in p.probes.values():
        if pr.kind != "suite":
            continue
        pat = pr.source if os.path.isabs(pr.source) \
            else os.path.join(p.repo_root, pr.source)
        if fnmatch.fnmatch(os.path.abspath(path), pat):
            return False, ("%s is the artifact of suite-kind probe `%s` "
                           % (ev, pr.key) + EMDASH + " inadmissible")
    return True, ""


def cmd_verify(p, args):
    require_cockpit(p)
    eid = args["_1"]
    e = get_entity(p, eid)
    ev = args.get("evidence")
    if not ev:
        die(EX_REFUSED, "`verify` needs --evidence")
    if e.state != "built-unverified":
        die(EX_REFUSED, "%s is `%s`; verify requires `built-unverified` "
            % (eid, e.state) + EMDASH + " no skips (§2.4 guard 3)")
    ok, why = evidence_admissible(p, ev, ent=e)
    if not ok:
        eprint("plan: evidence inadmissible " + EMDASH + " " + why)
        sys.exit(EX_EVIDENCE)
    set_state(p, e, "verified")
    set_evidence(p, e, ev)
    p.write_plan()
    p.log("%s built-unverified -> verified, evidence %s" % (eid, ev))
    print("%s built-unverified -> verified" % eid)
    return EX_OK


def cmd_unverify(p, args):
    """`verified -> built-unverified` — the correction path (§2.4).

    Guard 3 forbids skips, so verifying against the wrong artifact used to be
    permanent: a second `verify` was refused, `retract` means abandoned, and
    the record read `evidence: README.md` forever.  A guard that has no
    correction path teaches people to route around it.

    Not owner-locked, deliberately: this verb only ever *withdraws* a claim,
    and an agent that overclaimed must be able to take it back without
    waiting for the owner.  `accepted` is out of scope — undoing the owner's
    own act is the owner's call, through `retract`."""
    require_cockpit(p)
    eid = args["_1"]
    reason = args.get("reason")
    if not reason:
        die(EX_REFUSED, "`unverify` needs --reason " + EMDASH +
            " the record keeps what was withdrawn and why")
    e = get_entity(p, eid)
    if e.state != "verified":
        die(EX_REFUSED, "%s is `%s`; unverify requires `verified`"
            % (eid, e.state) + (" " + EMDASH + " an accepted item is the "
                                "owner's to `retract`"
                                if e.state == "accepted" else ""))
    was = e.get("evidence", "") or "(none)"
    set_state(p, e, "built-unverified")
    set_evidence(p, e, "")
    p.write_plan()
    p.log("%s verified -> built-unverified, evidence %s withdrawn: %s"
          % (eid, was, reason))
    print("%s verified -> built-unverified (evidence %s withdrawn)"
          % (eid, was))
    return EX_OK


def owner_lock(p, by, verb):
    """§2.4 guard 2 — the physical lock that stops an agent accepting."""
    actor = os.environ.get("PLAN_ACTOR")
    if actor:
        die(EX_REFUSED, "`%s` refuses: PLAN_ACTOR=%s is set " % (verb, actor) +
            EMDASH + " an agent cannot %s its own work (§2.4 guard 2)" % verb)
    if not by:
        die(EX_REFUSED, "`%s` needs --by @handle" % verb)
    if by != p.owner:
        die(EX_REFUSED, "`%s` refuses: --by %s is not the plan owner %s"
            % (verb, by, p.owner or "(unset)"))


def cmd_accept(p, args):
    require_cockpit(p)
    eid = args["_1"]
    by = norm_handle(args.get("by"))
    owner_lock(p, by, "accept")
    e = get_entity(p, eid)
    if e.state != "verified":
        die(EX_REFUSED, "%s is `%s`; accept requires `verified` "
            % (eid, e.state) + EMDASH + " no skips (§2.4 guard 3)")
    set_state(p, e, "accepted")
    p.write_plan()
    p.log("%s verified -> accepted" % eid, actor=by)
    print("%s verified -> accepted (by %s)" % (eid, by))
    return EX_OK


def cmd_retract(p, args):
    require_cockpit(p)
    eid = args["_1"]
    reason = args.get("reason")
    if not reason:
        die(EX_REFUSED, "`retract` needs --reason")
    e = get_entity(p, eid)
    if e.state == "retracted":
        die(EX_REFUSED, "%s is already retracted" % eid)
    prev = e.state
    # §2.4 guard 2's third door.  `retract` from any state is the escape hatch
    # (rule 3) and had no gate at all, so an agent could erase the owner's own
    # act with a --reason.  Retracting work the owner verified or accepted is
    # the owner's call; everything earlier is the agent's own to withdraw.
    actor = os.environ.get("PLAN_ACTOR")
    if actor and prev in ("verified", "accepted"):
        die(EX_REFUSED, "`retract` refuses: PLAN_ACTOR=%s is set and %s is "
            "`%s` " % (actor, eid, prev) + EMDASH +
            " withdrawing work the owner verified is the owner's call "
            "(§2.4 guard 2)")
    set_state(p, e, "retracted")
    strike_title(p, e)
    if e.kind == "item":
        line = p.lines[e.line]
        if "retracted:" not in line:
            p.lines[e.line] = line + SEP + "retracted: %s" % reason
    else:
        set_block_field(p, e, "retracted", reason)
    p.write_plan()
    p.log("%s %s -> retracted: %s" % (eid, prev, reason))
    print("%s %s -> retracted" % (eid, prev))
    return EX_OK


def cmd_decide(p, args):
    require_cockpit(p)
    eid = args["_1"]
    by = norm_handle(args.get("by"))
    owner_lock(p, by, "decide")
    choose = args.get("choose")
    # NOTES.md §2: the owed `reopen_when:` is a field, not prose — a testable
    # condition Flow D consumes — and it is written by the verb that already
    # wears this lock, exactly the precedent of `ruled:`.
    reopen = args.get("reopen-when")
    if reopen is None:
        reopen = args.get("reopen_when")
    if not choose and reopen is None:
        die(EX_REFUSED, "`decide` needs --choose <slug>, or --reopen-when "
            "\"…\" on a decision already ruled")
    e = get_entity(p, eid)
    if e.type != "Decision":
        die(EX_REFUSED, "%s is a %s, not a Decision" % (eid, e.type))
    if choose:
        if e.state == "ruled":
            die(EX_REFUSED, "%s is already ruled (%s)"
                % (eid, e.get("ruled", "")))
        slugs = []
        for o in e.get("options", "").split("\n"):
            o = o.strip()
            if o:
                slugs.append(re.split(r"\s+" + EMDASH + r"\s+|\s+-\s+",
                                      o)[0].strip())
        if slugs and choose not in slugs:
            die(EX_REFUSED, "`%s` is not one of the declared options: %s"
                % (choose, ", ".join(slugs)))
        set_block_field(p, e, "ruled", "%s %s by %s"
                        % (choose, today_iso(), by))
        set_block_field(p, e, "state", "ruled")
        e.state = "ruled"
    old = ""
    if reopen is not None:
        if reopen == "-":
            reopen = read_stdin()
        # a field is one line, so a wrapped condition joins with one space
        reopen = " ".join(normalise_eol(reopen).split())
        if not reopen:
            die(EX_REFUSED, "`--reopen-when` needs a condition")
        if e.state != "ruled":
            die(EX_REFUSED, "%s is `%s` " % (eid, e.state) + EMDASH +
                " `reopen_when:` says what would make a *ruled* decision live "
                "again, so it is legal only once ruled")
        old = e.get("reopen_when", "")
        set_block_field(p, e, "reopen_when", reopen)
        e.fields["reopen_when"] = reopen
    p.write_plan()
    if choose:
        p.log("ruled %s = %s" % (eid, choose), actor=by)
        print("%s ruled: %s" % (eid, choose))
    if reopen is not None:
        p.log("set reopen_when on %s: %s%s"
              % (eid, reopen, (" (was: %s)" % old) if old else ""), actor=by)
        print("%s reopen_when: %s" % (eid, reopen))
    elif choose:
        print("owed: `reopen_when:` on %s " % eid + EMDASH +
              " write what would make this decision live again")
    return EX_OK


def cmd_flag(p, args):
    require_cockpit(p)
    sub = args["_1"]
    eid = args.get("_2")
    if sub not in ("add", "clear") or not eid:
        die(EX_REFUSED, "usage: plan flag add|clear F-<ID> [...]")
    if sub == "add":
        return flag_add(p, eid, args)
    return flag_clear(p, eid, args)


def flag_add(p, eid, args):
    if not ID_RE.match(eid) or not eid.startswith("F-"):
        die(EX_REFUSED, "flag id `%s` must match ^F-[A-Z0-9][A-Z0-9-]*$" % eid)
    e = p.entities.get(eid)
    sev = args.get("severity")
    cw = args.get("clears-when") or args.get("clears_when")
    title = args.get("title")
    if e is None and not (title and cw):
        # NOTES.md §2: `flag add` learns a stdin form — `title:` /
        # `clears_when:` in the plan's own field grammar — used when the flags
        # aren't given, so a composed flag needs no shell quoting either.
        got = parse_field_stdin(read_stdin(), ("title", "clears_when"))
        title = title or got.get("title")
        cw = cw or got.get("clears_when")
    if e is not None:
        if e.type != "Flag":
            die(EX_REFUSED, "%s is a %s, not a Flag" % (eid, e.type))
        if sev:
            set_block_field(p, e, "severity", sev)
        if cw:
            set_block_field(p, e, "clears_when", cw)
        if not e.get("clears_when", "") and not cw:
            die(EX_REFUSED, "%s has no `clears_when:` " % eid + EMDASH +
                " a flag without it is a complaint")
        set_block_field(p, e, "state", "open")
        p.write_plan()
        p.log("raised %s (%s)" % (eid, e.get("severity", "?")))
        print("%s raised (existing block)" % eid)
        return EX_OK
    if not (sev and cw and title):
        die(EX_REFUSED, "new flag needs --severity, --clears-when and --title "
            "(the last two may arrive on stdin as `title:` / `clears_when:`)")
    if sev not in ("info", "warn", "blocker"):
        die(EX_REFUSED, "--severity must be info|warn|blocker")
    at = section_insert_point(p, "Flags")
    block = ["### Flag %s " % eid + EMDASH + " %s" % title,
             "state: open",
             "severity: %s" % sev,
             "owner: %s" % (args.get("owner") or p.owner),
             "clears_when: %s" % cw]
    if args.get("cleared-by"):
        block.append("cleared_by: %s" % args.get("cleared-by"))
    block.append("")
    p.lines[at:at] = block
    p.write_plan()
    p.log("raised %s (%s): %s" % (eid, sev, title))
    print("%s raised (%s)" % (eid, sev))
    return EX_OK


def clears_when_residue(cw):
    """The part of a `clears_when` sentence that is not a fact reference and
    not one of the connectives that carry no condition of their own.

    RULING(§2.2): the tool cannot read English, so it must not pretend the
    English half of a mixed condition was checked.  It also must not guess
    that the half is *unimportant*.  The reduction below decides only **who is
    asked**, never what is true, and every word it fails to recognise routes
    to the owner — so a too-small vocabulary degrades toward the human, which
    is the safe direction (§2.3's degradation principle, law 4)."""
    rest = re.sub(r"fact:[A-Za-z0-9_.-]+(?:=\S+)?", " ", cw)
    rest = re.sub(r"[,;.&+()\"'`]", " ", rest)
    return [w for w in rest.lower().split() if w not in CLEARS_CONNECTIVES]


def flag_condition_met(p, e):
    """Three-valued (§2.2).  Returns (verdict, why) with verdict in:

      "met"    every conjunct is a fact reference and every fact is ok
      "unmet"  a named fact is missing/unconf/empty, or none is named at all
      "owner"  the facts are ok but the sentence carries prose the tool
               cannot test — machine-satisfied, owner-owed

    The old two-valued form failed *closed* on a prose-only condition and
    *open* on a mixed one, which is the wrong way round: the mixed form is
    the one that reads like a checked condition."""
    cw = e.get("clears_when", "")
    keys = re.findall(r"fact:([A-Za-z0-9_.-]+)", cw)
    if not keys:
        return "unmet", ("clears_when names no fact: key, so the tool cannot "
                         "test it")
    for k in keys:
        f = p.facts.get(k)
        if f is None:
            return "unmet", "fact:%s has no span" % k
        if f.status != "ok":
            return "unmet", "fact:%s is %s" % (k, f.status)
        if not f.content.strip():
            return "unmet", "fact:%s is empty" % k
    if clears_when_residue(cw):
        return "owner", ("machine-checked: %s " % ", ".join(
            "fact:%s ok" % k for k in keys) + EMDASH +
            " untested: “%s”" % cw)
    return "met", ""


def flag_clear(p, eid, args):
    e = get_entity(p, eid)
    if e.type != "Flag":
        die(EX_REFUSED, "%s is a %s, not a Flag" % (eid, e.type))
    if e.state == "cleared":
        die(EX_REFUSED, "%s is already cleared" % eid)
    verdict, why = flag_condition_met(p, e)
    if verdict != "met":
        if not args.get("override"):
            if verdict == "owner":
                eprint("plan: %s: %s." % (eid, why))
                eprint("      the untested half is an attestation, not a "
                       "measurement " + EMDASH +
                       " `plan flag clear %s --override --by %s`"
                       % (eid, p.owner or "@owner"))
                sys.exit(EX_OWNER)
            die(EX_REFUSED, "%s: condition not satisfied " % eid + EMDASH +
                " %s. Fix the world, not the flag " % why + EMDASH +
                " or `--override --by %s`" % (p.owner or "@owner"))
        # §2.4 guard 2: an override is the owner's act, so it wears the same
        # lock as `accept` and `decide`.  It did not, and an agent inside its
        # own brief shell could clear a blocker as an "owner override".
        by = norm_handle(args.get("by"))
        owner_lock(p, by, "flag clear --override")
        set_block_field(p, e, "state", "cleared")
        p.write_plan()
        p.log("cleared %s by owner override (%s)" % (eid, why), actor=by)
        print("%s cleared (owner override)" % eid)
        return EX_OK
    set_block_field(p, e, "state", "cleared")
    p.write_plan()
    p.log("cleared %s (%s)" % (eid, e.get("clears_when", "")))
    print("%s cleared" % eid)
    return EX_OK


def cmd_log(p, args):
    text = args.get("_1")
    if not text:
        die(EX_REFUSED, 'usage: plan log "TEXT" --by <actor>')
    # §2.9 / law 1.  Observed under pressure: whole lanes of work bypassed the
    # state machine and their SHAs and counts arrived here instead, signed
    # `tool` — a model originating numbers into the record the owner reads,
    # attributed to the machine.  Three closures:
    #   1. `tool` is the tool's own signature and cannot be borrowed;
    #   2. inside a brief shell, PLAN_ACTOR is the signature, whatever --by says;
    #   3. a line long enough to carry a result is a RETURN, not an event.
    actor = os.environ.get("PLAN_ACTOR")
    if actor:
        by = args.get("by")
        if by and norm_handle(by) != actor:
            print("plan: log signed %s (PLAN_ACTOR), not %s" % (actor, by))
    else:
        actor = args.get("by") or ""
        if not actor:
            die(EX_REFUSED, "`log` needs --by @handle")
        if actor == "tool":
            die(EX_REFUSED, "`--by tool` is the tool's own signature " +
                EMDASH + " sign with your handle, and send results as a "
                "RETURN block (§2.11) so they pass the merge guards")
    if not ACTOR_RE.match(actor):
        die(EX_REFUSED, "actor must be @handle | agent:<name>")
    if len(text) > LOG_LINE_MAX:
        die(EX_REFUSED, "log line is %d chars (max %d) " % (len(text),
                                                            LOG_LINE_MAX) +
            EMDASH + " log.md holds events, not reports; a result travels as "
            "a RETURN block (§2.11)")
    hits = banned_hits(text)
    if hits:
        die(EX_REFUSED, "banned vocabulary in a log line: %s"
            % ", ".join(hits))
    p.log(text, actor=actor)
    print("logged")
    return EX_OK


def cmd_note(p, args):
    """NOTES.md §2/§3 — the owner writes a sentence beside an entity.

    Owner-locked, and the reason matters: an unguarded note verb is the
    `cmd_log` results-bypass reborn **without the 200-character cap** — a
    model originating unbounded prose into the very surface the owner reads.
    Agents already have two channels (a RETURN block, an agent-signed log
    line); this one exists precisely because prose is the one thing a *human*
    may author.  Same honest claim as `accept`: `env -u PLAN_ACTOR` defeats
    it, at the cost of lying twice, diffably."""
    require_cockpit(p)
    eid = args.get("_1")
    if not eid:
        die(EX_REFUSED, 'usage: plan note <ID> --by @owner [--text "…"]')
    by = norm_handle(args.get("by"))
    owner_lock(p, by, "note")
    e = get_entity(p, eid)
    text = args.get("text")
    if text is None:
        text = read_stdin()
    text = normalise_eol(text).strip("\n")
    if not text.strip():
        die(EX_REFUSED, "`note` needs --text, or the note on stdin " + EMDASH +
            " a note with nothing in it is not a note")
    if "<!--" in text:
        die(EX_REFUSED, "a note may not carry `<!--` " + EMDASH +
            " span syntax is machine territory (§2.5) and a note is prose")
    date = today_iso()
    write_note(p, e, by, date, text)
    p.write_plan()
    line = " ".join(text.split())
    if len(line) > 120:
        line = line[:119] + "…"
    p.log("note %s: %s" % (eid, line), actor=by)
    hits = banned_hits(text)
    if hits:
        # warn-only (NOTES.md §2): human prose never blocks.  `check` says the
        # same thing again on the next sweep, at warn, in prose.
        print("plan: banned vocabulary in a note: %s " % ", ".join(hits) +
              EMDASH + " recorded as written")
    n = len(notes_for(p, eid)) + 1
    print("%s noted (%s%s%s)%s%d note%s on this entity"
          % (eid, by, SEP, date, SEP, n, "" if n == 1 else "s"))
    return EX_OK


def norm_handle(h):
    if not h:
        return h
    return h if h.startswith("@") else "@" + h


# ---------------------------------------------------------------------------
# 15. sign-off / init (§5)
# ---------------------------------------------------------------------------

def cmd_sign_off(p, args):
    by = norm_handle(args.get("by"))
    actor = os.environ.get("PLAN_ACTOR")
    if actor:
        # §2.8 / SKILL F4: only the owner re-signs.  Same lock as accept.
        die(EX_REFUSED, "`sign-off` refuses: PLAN_ACTOR=%s is set " % actor +
            EMDASH + " only the owner signs intent")
    if not by:
        die(EX_REFUSED, "`sign-off` needs --by @handle")
    if p.owner and by != p.owner:
        die(EX_REFUSED, "--by %s is not the plan owner %s" % (by, p.owner))
    quiet_check(p)
    blocking = sorted(set(r for r in LAST_CHECK_RULES if r not in DRIFT_RULES))
    if blocking:
        die(EX_REFUSED, "check reports errors " + EMDASH +
            " sign-off refuses (run `plan check`): " + ", ".join(blocking))
    h = intent_hash(p)
    if "signed" in p.front_lines:
        p.lines[p.front_lines["signed"]] = "signed: %s" % h
    else:
        idx = p.front_lines.get("phase", 1) + 1
        p.lines.insert(idx, "signed: %s" % h)
    if "phase" in p.front_lines:
        p.lines[p.front_lines["phase"]] = "phase: cockpit"
    p.write_plan()
    p.log("signed intent %s; phase draft -> cockpit" % h, actor=by)
    print("signed %s " % h + EMDASH + " phase: cockpit")
    return EX_OK


def quiet_check(p):
    out = sys.stdout
    try:
        sys.stdout = open(os.devnull, "w")
        rc = cmd_check(p, {})
    finally:
        sys.stdout.close()
        sys.stdout = out
    return rc


# The scaffold has one source: `<skill>/templates/`, beside this executable.
# The constants below are the *fallback* for a lone copied `plan` with no skill
# directory around it — a documented deployment (§8: a new project changes four
# things, and none of them is the tool's install shape).  `plan-test` pins the
# fallback to the templates so the two cannot drift apart unnoticed.
INIT_PLAN = """---
plan: %(slug)s
owner: @you
phase: draft
caps: sql=2 suite=3 node=4 analysis=6 global=8
---
# Plan %(dash)s %(slug)s

Prose here is yours. The tool never edits it.

## Lanes

- [ ] L-FIRST do the first thing %(sep)sclass:analysis %(sep)sexit:"the thing exists at path X"

## Probes

```probes
intent.hash     meta     docs/plan/intent.md     sha256
```

## Facts

Intent hash: <!--fact intent.hash 1970-01-01T00:00Z unconf-->unknown<!--/fact-->
"""

INIT_INTENT = """# Intent %(dash)s %(slug)s

## Objective
<one paragraph: what the world looks like when this plan is dead>

## Constraints
- C1: <statement>
  holds_because: <the reason, written at decision time>
  violated_when: <a symptom a reviewer can check against a diff or artifact>

## Rejected alternatives
- R1: <what was not chosen> %(dash)s <why, at decision time>
  reopen_when: <condition>

## Amendments
"""

INIT_GITIGNORE = """briefs/
render/
*.tmp-plan
"""


TEMPLATE_FALLBACK = {
    "plan.md": lambda subs: INIT_PLAN % subs,
    "intent.md": lambda subs: INIT_INTENT % subs,
    "log.md": lambda subs: "# Log %s %s\n\n" % (EMDASH, subs["slug"]),
    "gitignore": lambda subs: INIT_GITIGNORE,
}


def templates_dir():
    """`<skill>/templates/`, beside this executable.  None when `plan` was
    copied out on its own."""
    d = os.path.join(os.path.dirname(os.path.dirname(
        os.path.abspath(__file__))), "templates")
    return d if os.path.isdir(d) else None


def scaffold(name, subs):
    """The text of one scaffold file: the template when it is installed, the
    embedded fallback otherwise.  `{{slug}}` is the only substitution (§8)."""
    tdir = templates_dir()
    if tdir:
        path = os.path.join(tdir, name)
        try:
            with open(path, "r", encoding="utf-8") as fh:
                return fh.read().replace("{{slug}}", subs["slug"])
        except IOError:
            pass                       # incomplete install — fall through
    return TEMPLATE_FALLBACK[name](subs)


def cmd_init(p_unused, args):
    target = args.get("dir") or os.path.join(os.getcwd(), "docs", "plan")
    target = os.path.abspath(target)
    if os.path.isdir(target) and os.listdir(target):
        die(EX_REFUSED, "%s is not empty " % target + EMDASH +
            " init refuses to write over an existing directory")
    os.makedirs(target, exist_ok=True)
    slug = os.path.basename(os.path.dirname(os.path.dirname(target))) or "plan"
    slug = re.sub(r"[^a-z0-9-]", "-", slug.lower()).strip("-") or "plan"
    subs = {"slug": slug, "dash": EMDASH, "sep": MDOT + " "}
    write_atomic(os.path.join(target, "plan.md"), scaffold("plan.md", subs))
    write_atomic(os.path.join(target, "intent.md"),
                 scaffold("intent.md", subs))
    write_atomic(os.path.join(target, "log.md"), scaffold("log.md", subs))
    write_atomic(os.path.join(target, "stamps.log"), "")
    write_atomic(os.path.join(target, ".gitignore"),
                 scaffold("gitignore", subs))
    for sub in ("returns", "briefs", "render"):
        os.makedirs(os.path.join(target, sub), exist_ok=True)
    write_atomic(os.path.join(target, "returns", ".gitkeep"), "")
    append_log(os.path.join(target, "log.md"),
               "initialised plan `%s` in phase draft" % slug)
    print("initialised %s (phase: draft)" % target)
    print("next: write intent.md, author entities, `plan check`, "
          "`plan sign-off --by @you`")
    return EX_OK


# ---------------------------------------------------------------------------
# 16. RETURN (§2.11)
# ---------------------------------------------------------------------------

class Return(object):
    def __init__(self):
        self.lane = None
        self.brief = None
        self.verdict = None
        self.evidence = None
        self.spec_gap = None
        self.reason = None
        self.log = ""
        self.needs = []
        self.flags = []
        self.decisions = []
        self.items = []


def parse_return(text):
    """All-or-nothing: returns (Return, errors)."""
    errs = []
    rows = text.split("\n")
    start = end = None
    for i, raw in enumerate(rows):
        if raw.strip().startswith("RETURN:") and start is None:
            start = i
        elif raw.strip() == "END RETURN" and start is not None:
            end = i
            break
    if start is None:
        return None, ["no `RETURN: <ID>` line"]
    if end is None:
        return None, ["missing `END RETURN` " + EMDASH +
                      " the whole block is rejected"]
    r = Return()
    r.lane = rows[start].split(":", 1)[1].strip()
    section = None
    for raw in rows[start + 1:end]:
        s = raw.rstrip()
        if not s.strip():
            continue
        # §2.11 continuation: an **indented** line continues the value above
        # it, joined with one space.  Without this the grammar was a trap by
        # construction — `spec_gap:` is required to be a long sentence, and a
        # wrapped one rejected the whole block with four "unparsed line"
        # errors while a wrapped `log:` merged and rendered truncated.
        if section is not None and raw[:1] in (" ", "\t"):
            cont = s.strip()
            if section == "brief":
                r.brief = (r.brief or "") + " " + cont
            elif section == "verdict":
                r.verdict = (r.verdict or "") + " " + cont
            elif section == "evidence":
                r.evidence = (r.evidence or "") + " " + cont
            elif section == "spec_gap":
                r.spec_gap = (r.spec_gap or "") + " " + cont
            elif section == "reason":
                r.reason = (r.reason or "") + " " + cont
            elif section == "log":
                r.log = r.log + " " + cont if r.log else cont
            else:
                errs.append("indented line under `%s:`, which takes a list, "
                            "not a wrapped value: %s" % (section, cont[:60]))
            continue
        m = re.match(r"^([a-z_]+):\s*(.*)$", s)
        if m and m.group(1) in ("brief", "verdict", "evidence", "spec_gap",
                               "reason", "log", "needs", "flags", "decisions",
                               "items"):
            k, v = m.group(1), m.group(2).strip()
            section = k
            if k == "brief":
                r.brief = v
            elif k == "verdict":
                r.verdict = v
            elif k == "evidence":
                r.evidence = v
            elif k == "spec_gap":
                r.spec_gap = v
            elif k == "reason":
                r.reason = v
            elif k == "log":
                r.log = v
            elif k == "needs" and v:
                r.needs.extend(x.strip().lstrip("+")
                               for x in v.split(",") if x.strip())
            continue
        st = s.strip()
        if section == "flags" and st.startswith("+"):
            r.flags.append(st[1:].strip())
        elif section == "decisions" and st.startswith("+"):
            r.decisions.append(st[1:].strip())
        elif section == "items" and st.startswith("- ["):
            r.items.append(st)
        elif section == "needs" and st.startswith("+"):
            r.needs.append(st[1:].strip())
        elif section == "log":
            # `log:` on its own line leaves r.log empty, so appending "\n"+st
            # seeded a leading blank element: a compliant 15-line log counted
            # 16 and every one of them was refused.
            r.log = (r.log + "\n" + st) if r.log else st
        else:
            errs.append("unparsed line in RETURN: %s" % st[:60])
    if r.verdict not in VERDICTS:
        errs.append("verdict `%s` is not one of %s"
                    % (r.verdict, "|".join(VERDICTS)))
    else:
        if r.verdict == "built" and not r.evidence:
            errs.append("verdict built requires `evidence:`")
        if r.verdict == "blocked" and not r.needs:
            errs.append("verdict blocked requires `needs: +<ID>`")
        if r.verdict == "fail-spec" and not r.spec_gap:
            errs.append("verdict fail-spec requires `spec_gap:`")
        if r.verdict == "aborted" and not r.reason:
            errs.append("verdict aborted requires `reason:`")
    if r.verdict:
        for name in banned_hits(r.verdict):
            errs.append("banned vocabulary `%s` in the verdict" % name)
    # rstrip first: the block always ends with the newline before END RETURN, so a
    # compliant 15-line log split to 16 and every 15-line return was refused.
    if len(r.log.rstrip("\n").split("\n")) > 15:
        errs.append("log: exceeds 15 lines")
    return r, errs


def cmd_return(p, args):
    require_cockpit(p)
    path = args.get("_1")
    if not path:
        die(EX_REFUSED, "usage: plan return <file> [--accept-stale]")
    if not os.path.isabs(path):
        cand = os.path.join(os.getcwd(), path)
        if not os.path.isfile(cand):
            cand = os.path.join(p.dir, path)
        if not os.path.isfile(cand):
            cand = os.path.join(p.repo_root, path)
        path = cand
    try:
        with open(path, "r", encoding="utf-8") as fh:
            text = fh.read()
    except IOError as exc:
        die(EX_REFUSED, "cannot read %s (%s)" % (path, exc))

    r, errs = parse_return(text)
    if r is None:
        for e in errs:
            eprint("RETURN rejected: " + e)
        eprint("nothing merged " + EMDASH + " the lane is unchanged")
        sys.exit(EX_RETURN)
    lane = p.entities.get(r.lane)
    if lane is None:
        errs.append("lane `%s` is not in the plan" % r.lane)
    else:
        if lane.state != "running":
            errs.append("lane %s is `%s`, not `running`" % (r.lane,
                                                            lane.state))
        if r.items and lane.cls != "analysis":
            errs.append("items: is legal only from an `analysis` lane "
                        "(%s is `%s`) " % (r.lane, lane.cls) + EMDASH +
                        " a builder lane may not smuggle in scope")
    it = load_intent(p)
    if lane is not None and not args.get("accept-stale"):
        want = brief_hash_of(p, it, r.lane)
        if want and r.brief and r.brief != want:
            errs.append("brief hash %s != current %s "
                        % (r.brief, want) + EMDASH + " use --accept-stale "
                        "only if you know why the brief changed")
    for f in r.flags:
        if not re.match(r"^F-[A-Z0-9][A-Z0-9-]*\s", f + " "):
            errs.append("flag stub is not `+ F-<ID> ...`: %s" % f[:40])
    for d in r.decisions:
        if not re.match(r"^D-[A-Z0-9][A-Z0-9-]*\s", d + " "):
            errs.append("decision stub is not `+ D-<ID> ...`: %s" % d[:40])
    for nid in r.needs:
        if nid not in p.entities:
            errs.append("blocked needs `%s`, which is not in the plan" % nid)
    if errs:
        for e in errs:
            eprint("RETURN rejected: " + e)
        eprint("nothing merged " + EMDASH + " the lane stays `%s`"
               % (lane.state if lane else "?"))
        sys.exit(EX_RETURN)

    # ---- apply (all-or-nothing) --------------------------------------
    inserts = []
    if r.verdict == "built":
        set_state(p, lane, "built-unverified")
        set_evidence(p, lane, r.evidence)
        p.log("%s returned built -> built-unverified, evidence %s"
              % (r.lane, r.evidence), actor="agent:%s" % r.lane)
    elif r.verdict == "fail-spec":
        set_state(p, lane, "open")
        # §2.11 reads literally: a stub Decision `D-SPEC-<lane>`.  The lane id
        # keeps its own prefix, so the stub is D-SPEC-L-FOO.
        stub_id = "D-SPEC-" + r.lane
        p.log("returned %s verdict=fail-spec -> open; %s appended"
              % (r.lane, stub_id), actor="agent:%s" % r.lane)
        if stub_id not in p.entities:
            at = section_insert_point(p, "Decisions")
            block = ["### Decision %s " % stub_id + EMDASH +
                     " the plan contradicts what %s observed" % r.lane,
                     "state: open",
                     "owner: %s" % (p.owner or "@owner"),
                     "blocks: %s" % r.lane,
                     "options:",
                     "| amend " + EMDASH + " change the brief/intent so the "
                     "lane can be built as specified",
                     "| respec " + EMDASH + " rewrite the lane's exit "
                     "criterion around what was observed",
                     "default_if_unruled: none",
                     "",
                     r.spec_gap,
                     ""]
            inserts.append((at, block))
    elif r.verdict == "blocked":
        set_state(p, lane, "open")
        cur = id_list(lane.get("needs", ""))
        for nid in r.needs:
            if nid not in cur:
                cur.append(nid)
        if lane.kind == "item":
            set_token(p, lane, "needs", ",".join(cur))
        else:
            set_block_field(p, lane, "needs", ", ".join(cur))
        p.log("returned %s verdict=blocked -> open, needs %s"
              % (r.lane, ", ".join(r.needs)), actor="agent:%s" % r.lane)
    elif r.verdict == "aborted":
        # CHOICE(§2.11): the merge table names built/fail-spec/blocked only.
        # aborted returns the lane to `open` (SKILL.md Flow M agrees); the work
        # did not happen and only a human may drop scope, so retracting here
        # would delete scope nobody agreed to drop.
        set_state(p, lane, "open")
        p.log("%s returned aborted -> open: %s" % (r.lane, r.reason),
              actor="agent:%s" % r.lane)

    for f in r.flags:
        fid = f.split()[0]
        if fid in p.entities:
            continue
        sev = re.search(r"severity=(\S+)", f)
        title = re.search(r'"([^"]*)"', f)
        cw = re.search(r'clears_when="([^"]*)"', f)
        at = section_insert_point(p, "Flags")
        inserts.append((at, ["### Flag %s " % fid + EMDASH + " %s"
                             % (title.group(1) if title else fid),
                             "state: open",
                             "severity: %s" % (sev.group(1) if sev else "warn"),
                             "owner: %s" % (p.owner or "@owner"),
                             "clears_when: %s" % (cw.group(1) if cw
                                                  else "(owed)"),
                             ""]))
        p.log("merged flag %s from %s" % (fid, r.lane))
    for d in r.decisions:
        did = d.split()[0]
        if did in p.entities:
            continue
        title = re.search(r'"([^"]*)"', d)
        opts = re.search(r'options="([^"]*)"', d)
        block = ["### Decision %s " % did + EMDASH + " %s"
                 % (title.group(1) if title else did),
                 "state: open",
                 "owner: %s" % (p.owner or "@owner"),
                 "blocks: %s" % r.lane,
                 "options:"]
        for o in (opts.group(1).split("|") if opts else []):
            block.append("| %s " % o.strip() + EMDASH + " (from %s)" % r.lane)
        block.append("default_if_unruled: none")
        block.append("")
        at = section_insert_point(p, "Decisions")
        inserts.append((at, block))
        p.log("merged decision %s from %s" % (did, r.lane))
    if r.items:
        at = lane.block_end + 1 if lane.kind == "block" else lane.line + 1
        kids = micro_children(p, lane)
        if kids:
            at = max(at, max(k.line for k in kids) + 1)
        inserts.append((at, list(r.items)))
        p.log("merged %d planner item(s) from %s" % (len(r.items), r.lane))

    for at, block in sorted(inserts, key=lambda x: -x[0]):
        p.lines[at:at] = block
    p.write_plan()
    if r.log:
        p.log("report %s: %s" % (r.lane, r.log.replace("\n", "; ")[:300]),
              actor="agent:%s" % r.lane)
    print("merged %s verdict=%s -> %s" % (r.lane, r.verdict,
                                          p.entities[r.lane].state))
    for f in r.flags:
        print("  +flag %s" % f.split()[0])
    for d in r.decisions:
        print("  +decision %s" % d.split()[0])
    if r.verdict == "fail-spec":
        print("  +decision D-SPEC-%s " % r.lane + EMDASH +
              " the plan is wrong, not the code")
    for i in r.items:
        print("  +item %s" % i[:60])
    return EX_OK


