  display:inline-block;text-decoration:none}
a.id:hover{color:var(--accent);border-color:var(--accent)}
.id--unmet{color:var(--caveat);border-color:var(--caveat)}
.id--ghost{border-style:dashed;color:var(--ink-3)}
.src{text-decoration:underline;text-decoration-color:var(--rule-2);
