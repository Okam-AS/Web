                % (h_src(p.plan_md, e.line + 1, label="the block"), EMDASH))
    slug, why = rec
    return ('<div class="rec rec--pick"><span class="ui rec__k">%s</span>'
            '<p>Take <b>%s</b>.%s</p>'
            '<p class="rec__who">%s. It is a starting position to accept or '
            'reject; the ruling is yours, and it is never pre-selected here. '
            'Written at %s.</p></div>'
            % (rec_label(p), esc(slug),
               (" " + md_inline(why)) if why else "", esc(rec_who(p)),
               h_src(p.plan_md, e.line + 1, label="plan.md")))


def h_decision_default(p, e, compact=False):
    dfl = (e.get("default_if_unruled", "") or "none").strip()
    held, flags = decision_cost(p, e.id)
    m = re.match(r"^(\S+) after (\d{4}-\d{2}-\d{2})$", dfl)
    if m:
        body = ('<p>On <span class="num">%s</span> the tool rules <b>%s</b> by '
                'itself, writes it into the plan and logs that it did. Ruling '
                'before then is how you keep that from being the answer.</p>'
                % (esc(m.group(2)), esc(m.group(1))))
    else:
        bits = []
        if held:
            bits.append("%d item%s stay%s blocked"
                        % (len(held), "" if len(held) == 1 else "s",
                           "s" if len(held) == 1 else ""))
        if flags:
            bits.append("%d flag%s stay%s open"
                        % (len(flags), "" if len(flags) == 1 else "s",
                           "s" if len(flags) == 1 else ""))
        body = ('<p>Nothing moves. There is no default: %s until you rule.</p>'
                % (", and ".join(bits) if bits else "this simply stays open"))
    if compact:
        if not m and defaults_all_none(p):
            # every decision in this plan says the same thing; the section note
            # says it once instead of twelve times
            return ""
        return ('<p class="row__sub"><span class="ui dim">if you do nothing'
                '</span> %s</p>' % re.sub(r"</?p>", "", body))
    return h_card_sec("if you do nothing", body)


_dfl_memo = {}


def defaults_all_none(p):
    """True when no Decision in the plan can rule itself — the case where the
    per-card 'nothing moves' line is the same sentence every time."""
    key = id(p)
    if key not in _dfl_memo:
        decs = [p.entities[i] for i in p.order
                if p.entities[i].type == "Decision"]
        _dfl_memo[key] = bool(decs) and all(
            (d.get("default_if_unruled", "") or "none").strip() == "none"
            for d in decs)
    return _dfl_memo[key]


def h_sev(e):
    """Severity as a form as well as a word: a full-height bar for a blocker,
    a half-height one for a warning.  The bar survives greyscale; the word
    survives a screen reader."""
    sev = (e.get("severity", "") or "info").strip()
    cls = sev if sev in ("blocker", "warn", "info") else "info"
    return ('<span class="sev sev--%s"><span class="sev__b" aria-hidden="true">'
            '</span>%s</span>' % (cls, esc(sev)))


# -- provenance: every claim of working software carries its grade ----------

def _probe_for_path(p, ev):
    import fnmatch
    target = os.path.abspath(ev if os.path.isabs(ev)
                             else os.path.join(p.repo_root, ev))
    hits = []
    for pr in p.probes.values():
        pat = pr.source if os.path.isabs(pr.source) \
            else os.path.join(p.repo_root, pr.source)
        if fnmatch.fnmatch(target, pat):
            hits.append(pr)
    return hits


_prov_memo = {}


def provenance(p, e):
    """(grade, detail).  proven = a probe measured it and the value is here.
    seen = a human pointed at an artifact nothing parses.  claimed = asserted.
    Only `claimed` rots silently, so only `claimed` is coloured."""
    if e.state not in ("built-unverified", "verified", "accepted"):
        return None
    key = (id(p), e.id)
    if key in _prov_memo:
        return _prov_memo[key]
    out = _provenance(p, e)
    _prov_memo[key] = out
    return out


def _provenance(p, e):
    ev = e.get("evidence", "")
    now = time.time()
    if not ev:
        return ("claimed", NO_EVIDENCE)
    if ev.startswith("fact:"):
        key = ev[5:]
        f, pr = p.facts.get(key), p.probes.get(key)
        if f is None or pr is None:
            return ("claimed", "evidence names fact:%s, which no probe declares"
                    % key)
        if f.status != "ok":
            return ("claimed", "fact:%s is unconfirmed since %s — the value "
                    "shown is retained, not measured" % (key, f.ts))
        ts = parse_iso(f.ts)
        note = ""
        if pr.kind == "suite":
            note = " · a suite count, which guard 1 makes inadmissible as " \
                   "verification"
        return ("proven", "fact:%s = %s, probed %s ago%s"
                % (key, f.content, fmt_age(now - ts) if ts else "?", note))
    path = ev if os.path.isabs(ev) else os.path.join(p.repo_root, ev)
    if not os.path.exists(path):
        return ("claimed", "the evidence path %s does not exist" % ev)
    hits = _probe_for_path(p, ev)
    suite = [h for h in hits if h.kind == "suite"]
    if suite:
        pr = suite[0]
        f = p.facts.get(pr.key)
        val = f.content if f is not None and f.status == "ok" else "unread"
        return ("claimed", "%s is the artifact of suite probe fact:%s = %s — a "
                "count, which guard 1 makes inadmissible as verification"
                % (ev, pr.key, val))
    for pr in hits:
        f = p.facts.get(pr.key)
        if f is not None and f.status == "ok":
            ts = parse_iso(f.ts)
            return ("proven", "%s is read by fact:%s = %s, probed %s ago"
                    % (ev, pr.key, f.content, fmt_age(now - ts) if ts else "?"))
    try:
        mt = os.path.getmtime(path)
        when = ", modified %s ago" % fmt_age(now - mt)
    except OSError:
        when = ""
    return ("seen", "%s exists%s; no probe parses it, so nothing but a human "
            "has looked at it" % (ev, when))


def h_evidence_link(p, e):
    """The evidence pointer, as a link when it is a file that exists."""
    ev = e.get("evidence", "")
    if not ev or ev.startswith("fact:"):
        return ""
    path = ev if os.path.isabs(ev) else os.path.join(p.repo_root, ev)
    if not os.path.exists(path):
        return ""
    return " " + h_src(path, label="open " + os.path.basename(ev))


NO_EVIDENCE = "no evidence is recorded against this item"


def h_grade(p, e):
    g = provenance(p, e)
    if g is None:
        return ""
    grade, detail = g
    if detail == NO_EVIDENCE:
        # the word carries it; repeating the sentence on every row does not
        return ('<p class="row__sub"><span class="grade grade--%s">%s</span>'
                '</p>' % (grade, grade))
    return ('<p class="row__sub"><span class="grade grade--%s">%s</span> '
            '<span class="dim">%s</span>%s</p>'
            % (grade, grade, esc(detail), h_evidence_link(p, e)))


# -- the evidence picture: how anything here becomes true ------------------

def work_items(p):
    return [p.entities[i] for i in p.order
            if p.entities[i].type in ("Feature", "Lane")
            and not p.entities[i].is_micro]


def evidence_picture(p):
    """Counted, never asserted: what state the capabilities are in, what
    grade of evidence they carry, and which declared instruments exist."""
    items = work_items(p)
    states, grades = {}, {"proven": 0, "seen": 0, "claimed": 0}
    inadmissible = 0
    for e in items:
        k = ui_key(p, e)
        states[k] = states.get(k, 0) + 1
        g = provenance(p, e)
        if g:
            grades[g[0]] += 1
            if "guard 1" in g[1]:
                inadmissible += 1
    kinds = {}
    for pr in p.probes.values():
        kinds[pr.kind] = kinds.get(pr.kind, 0) + 1
    unconf = sum(1 for f in p.facts.values() if f.status != "ok")
    blockers = [p.entities[i] for i in p.order
                if p.entities[i].type == "Flag"
                and p.entities[i].state != "cleared"
                and p.entities[i].get("severity") == "blocker"]
    return {"items": items, "states": states, "grades": grades,
            "inadmissible": inadmissible, "kinds": kinds, "unconf": unconf,
            "blockers": blockers, "n": len(items)}



_ev_cache = {}


def log_events(p):
    """{id: {'started': ts, 'last': (ts, text)}} — read once from log.md."""
    key = id(p)
    if key in _ev_cache:
        return _ev_cache[key]
    out = {}
    try:
        with open(p.log_md, "r", encoding="utf-8") as fh:
            for raw in fh:
                m = LOG_RE.match(raw.strip())
                if not m:
                    continue
                ts = parse_iso(m.group(1))
                if ts is None:
                    continue
                text = m.group(3)
                for word in set(re.findall(r"\b(?:FT|S|D|F|L|H)-[A-Z0-9-]+",
                                           raw)):
                    rec = out.setdefault(word, {"started": None, "last": None})
                    if re.search(r"\bstarted %s\b" % re.escape(word), text):
                        rec["started"] = ts
                    rec["last"] = (ts, text)
    except IOError:
        pass
    _ev_cache[key] = out
    return out


def fmt_stamp(ts):
    if ts is None:
        return "—"
    return time.strftime("%Y-%m-%d %H:%MZ", time.gmtime(ts))


def inflight_line(p, e):
    """Past tense, timestamped, and explicit that nothing here is live."""
    rec = log_events(p).get(e.id) or {}
    now = time.time()
    started = rec.get("started")
    last = rec.get("last")
    bits = ["dispatched %s" % fmt_stamp(started)]
    if last:
        bits.append("last evidence %s" % fmt_stamp(last[0]))
    tail = ""
    if last and now - last[0] >= 12 * 3600:
        tail = (' <span class="tag tag--caveat">quiet %s</span>'
                % fmt_age(now - last[0]))
    out = ['<p class="row__sub num">%s</p>' % (esc(" · ".join(bits)) + tail),
           '<p class="row__sub dim">no completion event as of generation</p>']
    if last and not re.search(r"\bstarted %s\b" % re.escape(e.id), last[1]):
        out.append('<p class="row__sub dim">%s</p>' % esc(last[1]))
    return "".join(out)


def returns_summary(p):
    """The ≤15-line lane summaries (§3.4 information fusion)."""
    out = {}
    if not os.path.isdir(p.returns):
        return out
    try:
        names = sorted(os.listdir(p.returns))
    except OSError:
        return out
    for name in names:
        if not name.endswith(".md"):
            continue
        try:
            with open(os.path.join(p.returns, name), "r",
                      encoding="utf-8") as fh:
                text = fh.read()
        except IOError:
            continue
        m = re.search(r"^RETURN:\s*(\S+)\s*$", text, re.M)
        if not m:
            continue
        lg = re.search(r"^log:\s*(.*)$", text, re.M)
        out[m.group(1)] = (name, lg.group(1).strip() if lg else "")
    return out


