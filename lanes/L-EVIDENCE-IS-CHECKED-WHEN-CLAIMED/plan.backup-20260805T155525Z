def _lane_counts(p):
    counts = {}
    for e in work_items(p):
        k = ui_key(p, e)
        counts[k] = counts.get(k, 0) + 1
    return counts






# ---------------------------------------------------------------------------
# 13c. `plan serve` — the same page, with the tool behind it
#
# The static file is the product; this is an optional shell around it.  It binds
# loopback only, serves the repo read-only, and accepts exactly three POSTs,
# each of which shells out to this same executable so the verb, its guards and
# its refusals are the ones the CLI has.  The server never writes state itself;
# it runs `plan decide|accept|flag clear` and shows you what they said.  After a
# write the page is re-rendered from disk, so what it shows is what the file
# says and never what a click hoped.
# ---------------------------------------------------------------------------

SERVE_ACT = "/__plan/act"


def _self_exe():
    cand = os.path.abspath(sys.argv[0] or "")
    if os.path.isfile(cand):
        return cand
    return os.path.abspath(__file__)


def serve_run(p, verb, eid, choice, fields=None):
    """Run one verb exactly as a terminal would.  Returns (ok, code, output).

    NOTES.md §2: served mode has no quoting problem, and it does not get one —
    every text-carrying verb takes its text on **stdin**, never assembled into
    a command line.  It is the same answer as the static page's quoted
    heredoc, one layer down: the one channel that interprets nothing."""
    import subprocess
    fields = fields if isinstance(fields, dict) else {}
    exe = _self_exe()
    owner = p.owner or "@owner"
    stdin_text = None
    if verb == "decide":
        argv = ["decide", eid, "--choose", choice, "--by", owner]
    elif verb == "accept":
        argv = ["accept", eid, "--by", owner]
    elif verb == "clear":
        argv = ["flag", "clear", eid]
    elif verb == "note":
        argv = ["note", eid, "--by", owner]
        stdin_text = str(fields.get("text", ""))
    elif verb == "reopen":
        argv = ["decide", eid, "--reopen-when", "-", "--by", owner]
        stdin_text = str(fields.get("text", ""))
    elif verb == "flag":
        sev = str(fields.get("severity", ""))
        if sev not in ("info", "warn", "blocker"):
            return False, EX_REFUSED, "severity must be info|warn|blocker"
        argv = ["flag", "add", eid, "--severity", sev]
        # a field is one line, so both values are collapsed to one: it keeps
        # the field grammar intact and makes a second `key:` unwritable from
        # inside a value, which is the only injection this channel could have.
        stdin_text = "title: %s\nclears_when: %s" % (
            " ".join(str(fields.get("title", "")).split()),
            " ".join(str(fields.get("clears_when", "")).split()))
    else:
        return False, EX_REFUSED, "unknown verb `%s`" % verb
    if not ID_RE.match(eid or ""):
        return False, EX_REFUSED, "`%s` is not an entity id" % eid
    if choice and not re.match(r"^[A-Za-z0-9._-]+$", choice):
        return False, EX_REFUSED, "`%s` is not an option slug" % choice
    cmd = [sys.executable, exe] + argv + ["--dir", p.dir]
    pipe = ({"input": stdin_text.encode("utf-8")} if stdin_text is not None
            else {"stdin": subprocess.DEVNULL})
    try:
        r = subprocess.run(cmd, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, **pipe)
    except OSError as exc:
        return False, EX_REFUSED, "could not run the tool: %s" % exc
    out = r.stdout.decode("utf-8", "replace").strip()
    return r.returncode == 0, r.returncode, out


def cmd_serve(p, args):
    import json
    import threading
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    if os.environ.get("PLAN_ACTOR"):
        die(EX_REFUSED, "PLAN_ACTOR is set " + EMDASH + " an agent shell may "
            "not serve the page; guard 2 is the owner's, not a browser's")
    if p.phase != "cockpit":
        die(EX_REFUSED, "phase is `draft` " + EMDASH + " serve has nothing to "
            "record until `plan sign-off`")

    root = p.repo_root
    page_rel = "/" + rel(os.path.join(p.render_dir, "plan.html"),
                         root).replace(os.sep, "/")
    port = int(args.get("port") or 0)
    plan_dir = p.dir
    # one writer at a time: two verbs rewriting plan.md concurrently would
    # interleave line-precise writes.  Reads stay parallel.
    write_lock = threading.Lock()
    render_lock = threading.RLock()

    class Handler(BaseHTTPRequestHandler):
        server_version = "plan/" + VERSION
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt, *a):        # one line per request, quiet
            sys.stdout.write("  %s %s\n" % (self.command, self.path))
            sys.stdout.flush()

        # -- guards ----------------------------------------------------
        def _loopback_only(self):
            host = (self.headers.get("Host") or "").split(":")[0]
            if host not in ("127.0.0.1", "localhost", "[::1]", "::1"):
                self._send(403, "text/plain",
                           b"plan serve answers loopback only\n")
                return False
            return True

        def _send(self, code, ctype, body):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _fresh(self):
            """Every request re-reads the plan: the page can only ever show
            what is on disk right now.  Under the render lock, because the
            derived caches in this file are process-global."""
            with render_lock:
                reset_caches()
                q = load(plan_dir)
                parse(q)
                if q.fatal:
                    return None, q
                return Sched(q), q

        # -- routes ----------------------------------------------------
        def do_GET(self):
            if not self._loopback_only():
                return
            path = self.path.split("?")[0].split("#")[0]
            if path in ("/", "/index.html"):
                self.send_response(302)
                self.send_header("Location", page_rel)
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            if path == page_rel:
                sched, q = self._fresh()
                if sched is None:
                    self._send(500, "text/plain; charset=utf-8",
                               ("plan.md does not parse: %s"
                                % q.fatal[1]).encode("utf-8"))
                    return
                with render_lock:
                    it = load_intent(q)
                    _OUT_DIR[0] = q.render_dir
                    html = html_document(q, sched, it, "cockpit",
                                         out_dir=q.render_dir, serve=True,
                                         act_path=SERVE_ACT)
                self._send(200, "text/html; charset=utf-8",
                           html.encode("utf-8"))
                return
            self._file(path)

        def _file(self, path):
            """Read-only, inside the repo, no listings.  Markdown is served as
            text so the source links open rather than download."""
            target = os.path.normpath(os.path.join(root, path.lstrip("/")))
            if not (target == root or target.startswith(root + os.sep)) \
                    or not os.path.isfile(target):
                self._send(404, "text/plain", b"not found\n")
                return
            try:
                with open(target, "rb") as fh:
                    body = fh.read()
            except IOError:
                self._send(404, "text/plain", b"not found\n")
                return
            ext = os.path.splitext(target)[1].lower()
            ctype = {".html": "text/html; charset=utf-8",
                     ".css": "text/css; charset=utf-8",
                     ".json": "application/json; charset=utf-8",
                     ".png": "image/png", ".svg": "image/svg+xml",
                     }.get(ext, "text/plain; charset=utf-8")
            self._send(200, ctype, body)

        def do_POST(self):
            if not self._loopback_only():
                return
            if self.path.split("?")[0] != SERVE_ACT:
                self._send(404, "text/plain", b"not found\n")
                return
            try:
                n = int(self.headers.get("Content-Length") or 0)
                body = json.loads(self.rfile.read(n).decode("utf-8") or "{}")
            except (ValueError, UnicodeDecodeError):
                body = None
            if not isinstance(body, dict):
                self._send(400, "application/json",
                           b'{"ok":false,"output":"unreadable request"}')
                return
            with write_lock:
                sched, q = self._fresh()
                ok, code, out = serve_run(q, str(body.get("verb", "")),
                                          str(body.get("id", "")),
                                          str(body.get("choice", "")), body)
            if ok:
                # keep the on-disk projections in step with what just happened
                try:
                    reset_caches()
                    q2 = load(plan_dir)
                    parse(q2)
                    if not q2.fatal:
                        render_views(q2, Sched(q2), load_intent(q2), ["cockpit"])
                except Exception:                       # never kill the server
                    pass
            payload = json.dumps({"ok": bool(ok), "code": code,
                                  "output": out}).encode("utf-8")
            self._send(200 if ok else 409,
                       "application/json; charset=utf-8", payload)

    # threaded on purpose: a single-threaded HTTP/1.1 server blocks every
    # other client behind one idle keep-alive connection, which a browser
    # always has open.
    ThreadingHTTPServer.daemon_threads = True
    httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = "http://127.0.0.1:%d%s" % (httpd.server_port, page_rel)
    print("plan serve " + EMDASH + " %s" % url)
    print("  loopback only " + MDOT + " writes only through `plan decide`, "
          "`plan accept`, `plan flag add|clear`, `plan note` " + MDOT +
          " ctrl-c to stop")
    print("  the file at %s stays the static, no-network copy"
          % rel(os.path.join(p.render_dir, "plan.html"), root))
    sys.stdout.flush()          # piped output must show the url at once
    if args.get("open"):
        try:
            import webbrowser
            webbrowser.open(url)
        except Exception:
            pass
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nplan serve stopped " + EMDASH + " the page is a file again")
    finally:
        httpd.server_close()
    return EX_OK


# ---------------------------------------------------------------------------
