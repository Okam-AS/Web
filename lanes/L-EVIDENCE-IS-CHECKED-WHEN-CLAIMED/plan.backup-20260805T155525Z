_holds_memo = {}


def holds(p, eid):
    """Everything that stops waiting if this id moves: the transitive closure
    of `needs:` edges pointing at it.  Reverse-needs only — nothing here is
    inferred from prose, so the number is checkable by grepping the file."""
    key = id(p)
    memo = _holds_memo.setdefault(key, {})
    if eid in memo:
        return memo[eid]
    stack = [(eid, 0)]
    onpath = set()
    while stack:
        node, phase = stack[-1]
        if phase == 0:
            if node in memo:
                stack.pop()
                continue
            if node in onpath:          # a cycle contributes nothing
                memo[node] = frozenset()
                stack.pop()
                continue
            onpath.add(node)
            stack[-1] = (node, 1)
            for d in dependents(p, node):
                if d not in memo:
                    stack.append((d, 0))
        else:
            stack.pop()
            onpath.discard(node)
            out = set()
            for d in dependents(p, node):
                out.add(d)
                out |= memo.get(d, frozenset())
            memo[node] = frozenset(out)
    return memo.get(eid, frozenset())


def last_log_event(p):
    """The newest timestamp log.md carries — the honest answer to 'when did
    anything last actually happen', as opposed to when this page was made."""
    newest = None
    try:
        with open(p.log_md, "r", encoding="utf-8") as fh:
            for raw in fh:
                m = LOG_RE.match(raw.strip())
                if not m:
                    continue
                ts = parse_iso(m.group(1))
                if ts is not None and (newest is None or ts > newest):
                    newest = ts
    except IOError:
        pass
    return newest


GROUP_RANK = {("re-sign", None): 0, ("rule", "Decision"): 1,
              ("rule", "Flag"): 2, ("write", None): 3,
              ("accept", None): 4, ("review", None): 5}


def owner_roster(p, sched, actions):
    """One row per thing only the owner can move.  The standard's verb order
    is kept (§5), and within each verb group the heaviest goes first — weight
    being the count of entities that would stop waiting, which is printed
    beside every row so the ranking can be checked rather than trusted."""
    now = time.time()
    rows = []
    for verb, eid, title in actions:
        e = p.entities.get(eid)
        etype = e.type if e is not None else None
        rank = GROUP_RANK.get((verb, etype), GROUP_RANK.get((verb, None), 5))
        held = holds(p, eid) if e is not None else frozenset()
        asked = p_age(p, eid)
        asked = (now - asked) if asked < (1 << 62) else 0.0
        note = ""
        word = VERB_WORD.get(verb, verb)
        if verb == "write":
            # nothing is held by an already-ruled decision, so the weight
            # column would print `holds nothing named` and read as noise.  The
            # ruling's own stamp is the useful right-hand fact.
            note = "ruled %s %s the sentence is owed" % (
                (e.get("ruled", "") if e is not None else "") or EMDASH, MDOT)
        elif e is not None and e.type == "Flag":
            # a flag is cleared, never ruled: `rule` is the headline's verb
            # class (§5), not something the tool will accept against a Flag
            word = e.get("severity", "flag")
            note = flag_move(p, e)
        elif e is None:
            note = "nothing new dispatches until it is re-signed"
        rows.append({"verb": word, "id": eid, "title": title,
                     "held": held, "weight": len(held), "asked": asked,
                     "note": note, "rank": rank})
    rows.sort(key=lambda r: (r["rank"], -r["weight"], -r["asked"], r["id"]))
    return rows


ACTION_KIND = [("resign", "re-sign", "re-signs"),
               ("ruling", "ruling", "rulings"),
               ("blocker", "blocker", "blockers"),
               ("write", "reopen condition", "reopen conditions"),
               ("accept", "acceptance", "acceptances"),
               ("review", "review", "reviews")]


def action_kinds(p, actions):
    """The needed set decomposed by what the move actually is.  `rule` covers
    two different things in the headline grammar (§5) — a Decision that one
    command settles, and a blocker Flag that only clears when the world moves
    — and collapsing them into one noun overstates what a keystroke can do."""
    out = {}
    for verb, eid, _t in actions:
        e = p.entities.get(eid)
        k = ("resign" if e is None else
             "write" if verb == "write" else
             "ruling" if e.type == "Decision" else
             "blocker" if e.type == "Flag" else
             "review" if verb == "review" else "accept")
        out[k] = out.get(k, 0) + 1
    return out


def verdict_line(p, actions):
    """The display line, decomposed rather than totalled.  `N moves are yours`
    was untrue on this plan: eight of the fifteen are blocker flags whose move
    is a lane landing, not a keystroke."""
    kinds = action_kinds(p, actions)
    parts = ["%d %s" % (kinds[k], one if kinds[k] == 1 else many)
             for k, one, many in ACTION_KIND if kinds.get(k)]
    if not parts:
        return "Nothing is waiting on you."
    if len(parts) == 1:
        return parts[0].capitalize() + "."
    return ", ".join(parts[:-1]) + " and " + parts[-1] + "."


