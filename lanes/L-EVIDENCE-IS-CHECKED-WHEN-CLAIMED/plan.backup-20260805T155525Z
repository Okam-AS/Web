def cmd_headline(p, args):
    sched = Sched(p)
    actions = needed_actions(p, sched)
    print(headline(p, sched, actions=actions))
    # CHOICE(§5): headline answers "is the owner needed"; exit 11 encodes that
    # answer for scripts.  It never dispatches, so 10/12 are impossible here.
    return EX_OWNER if actions else EX_OK


