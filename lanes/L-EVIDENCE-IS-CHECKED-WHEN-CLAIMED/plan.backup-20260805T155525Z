# 13b-1. The display face (§4.1)
#
# Schibsted Grotesk, the Norwegian grotesque, embedded as a data: URI or not
# used at all.  A `<link>` to a font host is blocked by CSP and fails silently,
# which is worse than a system stack, so this file never emits one: if no asset
# is vendored the stack falls through to the system sans and the page is set in
# it.  The `@font-face` rule and the token structure stay in place for the
# asset to drop into.
# ---------------------------------------------------------------------------

# realpath, not abspath: `plan` is normally reached through a symlink on
# PATH, and the assets live beside the skill, not beside the symlink.
FONT_DIR = os.path.join(os.path.dirname(os.path.dirname(
    os.path.realpath(__file__))), "assets")
# (slug, weight-range, style) — the spec's two static instances first; the
# variable instance is the fallback when they are not vendored.
FONT_STATIC = [("SchibstedGrotesk-Medium.woff2", "500"),
               ("SchibstedGrotesk-Bold.woff2", "700")]
FONT_VARIABLE = "SchibstedGrotesk-Variable.woff2"
_font_memo = [None]


def _font_face(path, weight):
    import base64
    try:
        with open(path, "rb") as fh:
            b64 = base64.b64encode(fh.read()).decode("ascii")
    except IOError:
        return ""
    return ('@font-face{font-family:"Schibsted Grotesk";font-style:normal;'
            'font-weight:%s;font-display:block;'
            'src:url(data:font/woff2;base64,%s) format("woff2")}'
            % (weight, b64))


def font_css():
    """The @font-face block, or "" when nothing is vendored.  Read once."""
    if _font_memo[0] is not None:
        return _font_memo[0]
    out = ""
    paths = [os.path.join(FONT_DIR, n) for n, _w in FONT_STATIC]
    if all(os.path.isfile(x) for x in paths):
        out = "".join(_font_face(x, w)
                      for x, (_n, w) in zip(paths, FONT_STATIC))
    else:
        var = os.path.join(FONT_DIR, FONT_VARIABLE)
        if os.path.isfile(var):
            out = _font_face(var, "400 900")
    _font_memo[0] = out
    return out


# ---------------------------------------------------------------------------
# 13b-2. The module model (§7.1, §7.4)
#
# The plan's ontology is Features and Lanes; the owner's is "six modules".  A
# module IS a Feature: its row on the pass holds its own cell plus the work
# items its `needs:` names, and everything no Feature names lands in the
# estate row.  Nothing here infers a module from an id prefix — that would be
# the renderer originating a relationship the file does not hold.
# ---------------------------------------------------------------------------

_mod_memo = {}


def features(p):
    return [p.entities[i] for i in p.order if p.entities[i].type == "Feature"]


def module_slug(ft):
    """`FT-WORKFORCE` -> `workforce`.  The anchor is `#m-workforce`."""
    body = ft.id.split("-", 1)[1] if "-" in ft.id else ft.id
    return body.lower()


def module_name(ft):
    body = ft.id.split("-", 1)[1] if "-" in ft.id else ft.id
    return " ".join(w.capitalize() for w in body.split("-"))


def pass_board(p):
    """([(feature|None, index, [entities])], estate) — every work item placed
    in exactly one row.  A lane named by two features lands in the first that
    names it, in file order, and the total is asserted against work_items so a
    silently dropped capability cannot happen."""
    key = id(p)
    if key in _mod_memo:
        return _mod_memo[key]
    items = work_items(p)
    ids = set(e.id for e in items)
    rows, placed = [], set()
    for ft in features(p):
        row = [ft]
        placed.add(ft.id)
        for n in ft.needs:
            if n in ids and n not in placed:
                row.append(p.entities[n])
                placed.add(n)
        rows.append((ft, row))
    estate = [e for e in items if e.id not in placed]
    _mod_memo[key] = (rows, estate)
    return _mod_memo[key]


def module_of(p, eid):
    """The Feature whose row holds this work item, or None."""
    rows, _estate = pass_board(p)
    for ft, row in rows:
        for e in row:
            if e.id == eid:
                return ft
    return None


# §10-1.  Module attribution for Flags and Decisions.  The authored field
# `for: FT-X` decides it when present.  Otherwise the chain is followed —
# Flag -> `cleared_by` lane -> the Feature whose row holds that lane; Decision
# -> the entities that name it -> the Feature whose row holds one of them.
# An item no chain reaches is UNATTRIBUTED: it renders in its ledger and the
# module's "what stops it" block prints nothing for it, which is visibly
# incomplete rather than silently wrong.  Id-prefix guessing is not done.
def attributed_to(p, e):
    declared = (e.get("for", "") or "").strip()
    if declared:
        t = p.entities.get(declared)
        return t if (t is not None and t.type == "Feature") else None
    if e.type == "Flag":
        by = e.get("cleared_by", "")
        return module_of(p, by) if by else None
    if e.type == "Decision":
        for dep in dependents(p, e.id):
            ft = module_of(p, dep)
            if ft is not None:
                return ft
    return None


_attr_memo = {}


def module_flags(p, ft):
    """This module's attributable open Flags, blockers first, then warns, then
    infos — the plan's own severity order, not a rank this page invents."""
    key = (id(p), ft.id)
    if key in _attr_memo:
        return _attr_memo[key]
    out = []
    for sev in ("blocker", "warn", "info"):
        for i in p.order:
            e = p.entities[i]
            if e.type != "Flag" or e.state == "cleared":
                continue
            if (e.get("severity", "") or "info") != sev:
                continue
            got = attributed_to(p, e)
            if got is not None and got.id == ft.id:
                out.append(e)
    _attr_memo[key] = out
    return out


def module_has_blocker(p, ft):
    return any((e.get("severity", "") or "info") == "blocker"
               for e in module_flags(p, ft))


# §10-4.  The wall label, computed and never typed: the open blocker Flag
# whose `cleared_by` lane appears in the `needs:` of the evidence Stage.  If
# the plan holds no such stage or no such flag, the wall carries the standing
# law sentence alone.
EVIDENCE_STAGE = "S-EVIDENCE"
WALL_LAW = ("Nothing crosses without a person &mdash; guard 1 refuses a suite "
            "count.")


def wall_flag(p):
    stage = p.entities.get(EVIDENCE_STAGE)
    if stage is None or stage.type != "Stage":
        return None
    needs = set(stage.needs)
    for i in p.order:
        e = p.entities[i]
        if e.type != "Flag" or e.state == "cleared":
            continue
        if e.get("severity", "") != "blocker":
            continue
        if e.get("cleared_by", "") in needs:
            return e
    return None


def wall_label(p):
    f = wall_flag(p)
    if f is None:
        return WALL_LAW
    by = f.get("cleared_by", "")
    lane = p.entities.get(by)
    where = (", %s" % UI_STATE[ui_key(p, lane)][1]) if lane is not None else ""
    return ("Nothing crosses without a person. Held shut by %s &mdash; "
            "cleared by %s%s."
            % (h_id(f.id), h_id(by), esc(where)))


# ---------------------------------------------------------------------------
# 13b-3. The walkthrough artifact (§10-2)
#
# `docs/plan/walkthroughs/<module>.md`, in a four-key step grammar, included
# verbatim.  Until the artifact exists the block renders NOTHING — no empty
# scaffold and no placeholder, because a walkthrough is content the plan does
# not hold and the renderer may not invent it.
# ---------------------------------------------------------------------------

WALK_KEYS = ("act", "saw", "tier", "src")
WALK_TIERS = {"driven": ("wc--driven", "driven"),
              "reachable": ("", "reachable"),
              "no door": ("wc--nodoor", "no door"),
              "no-door": ("wc--nodoor", "no door")}


def walkthrough_path(p, slug):
    return os.path.join(p.dir, "walkthroughs", "%s.md" % slug)


def read_walkthrough(p, slug):
    """[{act, saw, tier, src}] in file order, or []."""
    path = walkthrough_path(p, slug)
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.read().split("\n")
    except IOError:
        return []
    steps, cur, last = [], None, None
    for raw in lines:
        s = raw.strip()
        if not s:
            last = None
            continue
        m = re.match(r"^(act|saw|tier|src):\s*(.*)$", s)
        if m:
            k, v = m.group(1), m.group(2).strip()
            if k == "act":
                cur = {"act": v, "saw": "", "tier": "", "src": ""}
                steps.append(cur)
            elif cur is not None:
                cur[k] = v
            last = k
            continue
        if cur is not None and last in ("act", "saw"):
            cur[last] = (cur[last] + " " + s).strip()
    return [s for s in steps if s["act"]]


def walk_age(p, slug):
    """The walkthrough's own age, when a probe declares the file.  No probe,
    no claim about freshness."""
    rel_path = os.path.relpath(walkthrough_path(p, slug), p.repo_root)
    for pr in p.probes.values():
        if os.path.normpath(pr.source) != os.path.normpath(rel_path):
            continue
        f = p.facts.get(pr.key)
        if f is None:
            continue
        ts = parse_iso(f.ts)
        if f.status != "ok":
            return ('<span class="tag tag--caveat tag--unconf">unconfirmed'
                    '</span>')
        if ts is None:
            return ""
        return ('<span class="src">read %s ago</span>'
                % esc(fmt_age(time.time() - ts)))
    return ""


def h_walk(p, ft):
    slug = module_slug(ft)
    steps = read_walkthrough(p, slug)
    if not steps:
        return ""
    out = []
    for i, st in enumerate(steps):
        bits = []
        if st["saw"]:
            bits.append('<p class="walk__s">&rarr; %s</p>'
                        % md_inline(st["saw"]))
        marks = []
        tier = (st["tier"] or "").strip().lower()
        if tier in WALK_TIERS:
            cls, word = WALK_TIERS[tier]
            marks.append('<span class="wc %s">%s</span>' % (cls, esc(word)))
        if st["src"]:
            marks.append('<span class="path">%s</span>' % esc(st["src"]))
        if marks:
            bits.append('<div class="walk__m">%s</div>' % "".join(marks))
        out.append('<li class="walk__i"><span class="walk__n num">%02d</span>'
                   '<p class="walk__a">%s</p>%s</li>'
                   % (i + 1, md_inline(st["act"]), "".join(bits)))
    return ('<div class="sub"><div class="sub__h"><span class="ui">walkthrough'
            '</span><span class="sec__rule"></span>%s%s</div>'
            '<ol class="walk">%s</ol></div>'
            % (walk_age(p, slug),
               h_src(walkthrough_path(p, slug),
                     label="walkthroughs/%s.md" % slug),
               "".join(out)))

# ---------------------------------------------------------------------------
# 13b-4. Sections (§7).  One document, in document order, each opening with a
# 2px ink rule, its word, its count and the one line that says which question
# it answers.
# ---------------------------------------------------------------------------

def h_sec(anchor, label, n=None, lede=None, body=""):
    out = ['<section class="sec" id="%s" data-sec="%s">'
           '<div class="sec__head"><span class="ui sec__label">%s</span>'
           % (esc(anchor), esc(anchor), esc(label))]
    if n is not None:
        out.append('<span class="sec__n">%s</span>' % esc(n))
    out.append('<span class="sec__rule"></span></div>')
    if lede:
        out.append('<p class="sec__note">%s</p>' % lede)
    out.append(body)
    out.append("</section>")
    return "".join(out)


def h_sub(label, n=None, body="", extra=""):
    return ('<div class="sub"><div class="sub__h"><span class="ui">%s</span>'
            '%s<span class="sec__rule"></span>%s</div>%s</div>'
            % (esc(label),
               ('<span class="sec__n">%s</span>' % esc(n)) if n is not None
               else "", extra, body))


def h_row(p, e, sub="", cls="", attrs="", anchor=False):
    """`anchor` marks the one row per entity that auto-links resolve to — the
    definition row.  Every other appearance of the same id is a link, so the
    document never holds the same anchor twice."""
    key = ui_key(p, e)
    klass = ["row"]
    if key in ("accepted", "cleared", "ruled"):
        klass.append("is-accepted")
    if key == "retracted":
        klass.append("is-retracted")
    if cls:
        klass.append(cls)
    return ('<div class="%s" data-entity="%s" data-state="%s" '
            'data-search="%s" data-statekey="%s"%s%s>%s<div><div class="hd">%s%s'
            '<span class="row__title">%s</span></div>%s</div>%s</div>'
            % (" ".join(klass), esc(e.id), esc(disk_state(e)),
               esc(row_search(p, e)), esc(key),
               (' id="e-%s"' % esc(e.id)) if anchor else "",
               (" " + attrs) if attrs else "",
               h_mark(key), h_id(e.id, self_link=False), h_entity_src(p, e),
               ttl(e.title),
               # prose beside the entity, at the row that *is* the entity:
               # In flight lists the same lane again, and the owner's sentence
               # is not furniture to repeat under every mention of an id
               sub + (h_notes(p, e.id) if anchor else "") + h_slot(e.id),
               h_state(p, e)))


