def release_track(p, eid):
    """What a ruling releases, followed through the file's own edges: the
    entities that name the decision, transitively, plus the flags those
    entities are declared to clear.  Nothing is inferred from prose, and a
    decision that releases nothing renders as an empty track — which is the
    point of drawing it."""
    held = holds(p, eid)
    ids = set(held)
    flags = [p.entities[i] for i in p.order
             if p.entities[i].type == "Flag"
             and p.entities[i].state != "cleared"
             and p.entities[i].get("cleared_by", "") in ids]
    nodes = [p.entities[i] for i in p.order if i in ids]
    stages = [x for x in nodes if x.type in ("Stage", "Feature")]
    return nodes, flags, stages







def intent_paragraphs(it, heading):
    """The authored paragraphs under one `## ` heading of intent.md."""
    out, cur, on = [], [], False
    for raw in it.lines:
        s = raw.strip()
        if s.startswith("## "):
            if on and cur:
                out.append(" ".join(cur))
            cur = []
            on = s[3:].strip().lower() == heading
            continue
        if not on:
            continue
        if not s:
            if cur:
                out.append(" ".join(cur))
                cur = []
            continue
        cur.append(s)
    if on and cur:
        out.append(" ".join(cur))
    return out


def plan_preamble(p):
    """The prose the author wrote before the first section of plan.md: where
    this came from, in their own words."""
    out, cur, started = [], [], False
    for raw in p.lines:
        s = raw.strip()
        if s.startswith("## ") or s.startswith("### "):
            break
        if s.startswith("# "):
            started = True
            continue
        if not started:
            continue
        if s.startswith("---"):
            continue
        if not s:
            if cur:
                out.append(" ".join(cur))
                cur = []
            continue
        cur.append(s)
    if cur:
        out.append(" ".join(cur))
    return out


