.mn{font:400 30px/1 var(--mono);letter-spacing:-.01em;
  font-variant-numeric:tabular-nums;color:var(--ink)}

.id{font:400 13px/1 var(--mono);letter-spacing:.01em;color:var(--ink-2);
  border:1px solid var(--rule-2);border-radius:3px;padding:3px 6px 2px;
