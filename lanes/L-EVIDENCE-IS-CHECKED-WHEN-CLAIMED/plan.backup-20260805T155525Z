def h_release(p, eid):
    """What a ruling releases, followed through the file's own edges.  The
    empty track is the point; a decision that frees nothing scheduled says so
    rather than being drawn as if it did."""
    nodes, flags, _stages = release_track(p, eid)
    if not nodes and not flags:
        return ('<div class="rel"><span class="ui rel__k">releases</span>'
                '<p class="rel__n">releases nothing scheduled &mdash; a scope '
                'ruling.</p></div>')
    items = []
    for x in nodes + flags:
        items.append('<span class="rel__i"><span class="rel__g" '
                     'aria-hidden="true"></span>%s</span>' % h_id(x.id))
    return ('<div class="rel"><span class="ui rel__k">releases</span>'
            '<div class="rel__l">%s</div>'
            '<p class="rel__n">a ruling releases these &mdash; drawn as the '
            'state they would become, not the state they are in.</p></div>'
            % "".join(items))


def h_action_body(p, e, verb, rets, sched):
    """The full needed block: everything a person needs to make the move,
    once, in one place.  The queue is that place (§11-4)."""
    subs = []
    if e is None:
        subs.append('<p class="row__sub">%s</p>'
                    % h_src(p.intent_md, label="read intent.md"))
        subs.append('<div class="picks">%s<span class="dim">adds one line to '
                    'the basket below</span></div>'
                    % h_pick("intent", "sign-off",
                             "plan sign-off --by %s" % (p.owner or "@owner"),
                             "sign off"))
        subs.append(h_slot("intent"))
        subs.append('<div class="cmdw">%s</div>'
                    % h_cmd("plan sign-off --by %s" % (p.owner or "@owner")))
        return "".join(subs)
    if e.type == "Decision" and verb == "write":
        # NOTES.md §5: the owed field, as a queue item.  The options are
        # frozen — this card is not asking for a ruling, it is asking for the
        # one sentence the ruling still owes.
        subs.append('<p class="row__sub"><span class="ui dim">ruled</span> %s'
                    '</p>' % esc(e.get("ruled", EMDASH)))
        slug = (e.get("ruled", "").split() or [""])[0]
        subs.append(h_options(p, e, slug, compact=True))
        subs.append(h_write_reopen(e))
    elif e.type == "Decision":
        age = p_age(p, e.id)
        if age < (1 << 62):
            subs.append('<p class="row__sub"><span class="tag tag--caveat">'
                        'asked %s ago</span></p>'
                        % esc(fmt_age(time.time() - age)))
        subs.append(h_decision_why(p, e, collapsed=True))
        subs.append(h_decision_cost(p, e, compact=True))
        subs.append(h_options(p, e))
        # §5: a model may not originate options, so his counter-proposal lands
        # verbatim as a note and the decision stays open — the note is an
        # instruction to redraft, never a synthetic option.
        subs.append(h_write_note(
            p, e.id, "none of these &mdash; write what you want instead"))
        subs.append(h_decision_rec(p, e, compact=True))
        subs.append(h_decision_default(p, e, compact=True))
        subs.append(h_release(p, e.id))
    if e.type == "Flag":
        # §5's headline verb for a flag is `rule`; the tool's verb is
        # `flag clear`, and clearing is refused until the world moves.
        subs.append('<p class="row__sub">%s <span class="dim">%s</span></p>'
                    % (h_sev(e), esc(flag_move(p, e))))
        subs.append('<p class="row__sub">clears when %s</p>'
                    % esc(e.get("clears_when", "(owed)")))
        waiting = dependents(p, e.id)
        if waiting:
            subs.append('<p class="row__sub">holds %s</p>'
                        % ", ".join(h_id(w) for w in waiting))
        body = md_block(prose_of(p, e))
        if body:
            subs.append('<details class="more"><summary>what was actually '
                        'found</summary><div class="body">%s</div></details>'
                        % body)
        subs.append('<div class="picks">%s<span class="dim">the tool checks '
                    'the condition and refuses if the world has not moved'
                    '</span></div>'
                    % h_pick(e.id, "clear", "plan flag clear %s" % e.id,
                             "clear " + e.id))
    if e.state == "verified":
        subs.append('<p class="row__sub row__exit"><span class="ui">exit'
                    '</span>%s</p>'
                    % esc(clip(e.get("exit", "(none declared)"), 200)))
        subs.append(h_grade(p, e))
        subs.append(h_return(p, rets, e.id))
        subs.append('<div class="picks">%s<span class="dim">your acceptance '
                    'is the gate &mdash; no suite can give it</span></div>'
                    % h_pick(e.id, "accept",
                             "plan accept %s --by %s"
                             % (e.id, p.owner or "@owner"),
                             "accept " + e.id))
    if e.type != "Decision" or verb == "write":
        # a Decision's note composer already sits under its options; every
        # other card carries the plain one
        subs.append(h_write_note(p, e.id))
    subs.append('<p class="row__sub">%s</p>' % h_entity_src(p, e))
    subs.append(h_notes(p, e.id))
    subs.append(h_slot(e.id))
    subs.append('<div class="cmdw">%s</div>' % h_cmd(cmd_for(p, verb, e)))
    return "".join(subs)


def h_queue(p, sched, actions, rets):
    if not actions:
        body = ('<div class="pan"><p class="plain"><span>Nothing waits on you. '
                'The machine is at capacity, or idle &mdash; In flight says '
                'which.</span></p></div>')
        return h_sec("queue", "Your queue", "0",
                     "Everything that waits on you and on nobody else. "
                     "Complete by construction &mdash; nothing needed exists "
                     "anywhere but here.", body)
    verbs = dict((a[1], a[0]) for a in actions)
    titles = dict((a[1], a[2]) for a in actions)
    rows = []
    for r in owner_roster(p, sched, actions):
        eid = r["id"]
        e = p.entities.get(eid)
        if r["note"]:
            right = '<span>%s</span>' % esc(r["note"])
        elif r["weight"]:
            right = ('<b class="num">%d</b><span>holds</span>' % r["weight"])
        else:
            right = '<span>holds nothing named</span>'
        meta = [h_id(eid, self_link=False)]
        if e is not None:
            meta.append(h_entity_src(p, e))
        rows.append('<details class="q__i" id="need-%s" data-entity="%s" '
                    'data-state="%s"><summary>'
                    '<span class="q__v"><span class="rev">%s</span></span>'
                    '<span><span class="q__m">%s</span>'
                    '<span class="q__t">%s</span></span>'
                    '<span class="q__h">%s</span></summary>'
                    '<div class="q__b">%s</div></details>'
                    % (esc(eid), esc(eid),
                       esc(disk_state(e)) if e is not None else "drift",
                       esc(r["verb"]), "".join(meta), ttl(titles.get(eid, "")),
                       right,
                       h_action_body(p, e, verbs.get(eid, "rule"), rets,
                                     sched)))
    note = ("Everything here waits on %s and on nobody else. Reverse video "
            "appears on this page only for these items. Clicking an option or "
            "an accept button collects the exact words that would record it; "
            "it never records anything itself." % esc(p.owner or "the owner"))
    if defaults_all_none(p):
        note += (" No decision in this plan carries a <span class=\"path\">"
                 "default_if_unruled</span>: if none of them is ruled, nothing "
                 "rules itself and nothing moves.")
    return h_sec("queue", "Your queue", str(len(actions)),
                 "Everything that waits on you and on nobody else. Complete by "
                 "construction &mdash; nothing needed exists anywhere but "
                 "here.",
                 '<p class="sec__note">%s</p><div class="pan pan--flush q">%s'
                 '</div>' % (note, "".join(rows)))


# -- §7.3 IN FLIGHT ---------------------------------------------------------

def h_caps(p, sched):
    cells = []
    for c in CLASSES + ["global"]:
        used = (sched.global_used if c == "global"
                else sched.class_count.get(c, 0))
        cap = sched.caps[c]
        strip = []
        for i in range(max(cap, used)):
            k = "on" if i < used else ""
            if i >= cap:
                k = "over"
            strip.append('<i class="%s"></i>' % k)
        cells.append('<div class="caps__i"><span class="caps__k ui">%s'
                     '<b>%d of %d</b></span><div class="caps__c" '
                     'aria-label="%d of %d occupied">%s</div></div>'
                     % (esc(c), used, cap, used, cap, "".join(strip)))
    tail = ('<p class="caps__m">cpu %.1f of %.1f &middot; load %.1f of %.1f '
            '&middot; measured against this machine at generation time</p>'
            % (sched.cpu_used, sched.budget, sched.load, sched.load_limit))
    return h_sub("capacity", None,
                 '<div class="caps">%s</div>%s' % ("".join(cells), tail))


def h_flight(p, sched, rets):
    run_rows = []
    for e in sched.running:
        sub = inflight_line(p, e)
        agent = e.get("agent", "")
        if agent:
            sub += ('<p class="row__sub"><span class="ui dim">agent</span> '
                    '<span class="path">%s</span></p>' % esc(agent))
        sub += ('<p class="row__sub row__exit"><span class="ui">exit</span>%s'
                '</p>' % esc(clip(e.get("exit", "—"), 200)))
        if e.cls:
            sub += ('<p class="row__sub"><span class="ui dim">class</span> '
                    '<span class="path">%s</span></p>' % esc(e.cls))
        sub += h_return(p, rets, e.id)
        run_rows.append(h_row(p, e, sub))
    ready_rows = []
    for e in sched.orders:
        brief = os.path.join(p.briefs, "%s.md" % e.id)
        link = (h_src(brief, label="briefs/%s.md" % e.id)
                if os.path.exists(brief)
                else '<span class="path">briefs/%s.md</span>' % esc(e.id))
        ready_rows.append(h_row(p, e, '<p class="row__sub">brief %s</p>'
                                      '<div class="cmdw">%s</div>'
                                % (link,
                                   h_cmd("plan start %s --agent <name>"
                                         % e.id))))
    for e in sched.capwait:
        ready_rows.append(h_row(p, e, '<p class="row__sub"><span class="tag">'
                                      'cap-wait</span> ready; refused by %s</p>'
                                % esc(sched.capwait_why.get(
                                    e.id, "a gate measured at generation"))))
    for e in sched.unauthored:
        ready_rows.append(h_row(p, e, '<p class="row__sub"><span class="tag '
                                      'tag--caveat">quarantined</span> ready '
                                      'but missing class: or exit: &mdash; see '
                                      '`plan check`</p>'))
    stg = []
    for i in p.order:
        e = p.entities[i]
        if e.type != "Stage":
            continue
        marks = []
        for n in e.needs:
            t = p.entities.get(n)
            marks.append('<span class="pair">%s%s</span>'
                         % (h_mark(ui_key(p, t)) if t is not None
                            else h_mark("blocked"), h_id(n)))
        stg.append('<div class="stg" id="e-%s" data-entity="%s" '
                   'data-state="%s"><span>%s</span>'
                   '<div><span class="row__title">%s</span>'
                   '<div class="stg__n">%s</div>%s</div></div>'
                   % (esc(e.id), esc(e.id), esc(disk_state(e)),
                      h_id(e.id, self_link=False), ttl(e.title),
                      "".join(marks), h_slot(e.id)))
    body = []
    if run_rows:
        body.append(h_sub("running", "%d of %d" % (len(sched.running),
                                                   sched.caps["global"]),
                          "".join(run_rows)))
    else:
        body.append(h_sub("running", "0",
                          '<p class="plain"><span>No lane is running.</span>'
                          '</p>'))
    body.append(h_sub("ready", str(len(ready_rows)),
                      "".join(ready_rows)
                      or '<p class="plain"><span>Nothing is ready.</span></p>'))
    body.append(h_caps(p, sched))
    if stg:
        body.append(h_sub("stages", str(len(stg)), "".join(stg)))
    debt = sched.refill_debt(False)
    lede = ("What the machine is doing without you, and what it will pick up "
            "next.")
    if debt:
        lede += (" <b>REFILL-DEBT(%d)</b> &mdash; %d lane%s pass every gate "
                 "and are not running." % (debt, debt, "" if debt == 1 else "s"))
    return h_sec("flight", "In flight",
                 "%d of %d" % (len(sched.running), sched.caps["global"]),
                 lede, '<div class="pan">%s</div>' % "".join(body))

# -- §7.4 THE SIX MODULES ---------------------------------------------------

def h_lane_row(p, e, rets, mine, gate_bar=True):
    """One lane, with everything that finishes it.  A `gate:` draws a 2px ink
    rule across the list immediately above the row it stops — the diagram is
    the interruption itself."""
    out = []
    gate = e.get("gate", "")
    if gate_bar and gate:
        t = p.entities.get(gate)
        if gate in mine:
            chip = ('<a class="gate__c" href="#need-%s"><span class="rev">'
                    'waits on %s &mdash; yours</span></a>'
                    % (esc(gate), esc(gate)))
        else:
            chip = ('<a class="gate__c id" href="#e-%s">waits on %s</a>'
                    % (esc(gate), esc(gate)))
        out.append('<div class="gate"><span class="gate__r" aria-hidden="true">'
                   '</span>%s<span class="gate__r" aria-hidden="true"></span>'
                   '</div>' % chip)
        if t is None:
            out.append('<p class="row__sub dim">%s is not an entity in this '
                       'plan.</p>' % esc(gate))
    subs = []
    if e.get("exit", ""):
        subs.append('<p class="row__sub row__exit"><span class="ui">done when'
                    '</span>%s</p>' % esc(e.get("exit")))
    bits = []
    if e.cls:
        bits.append('<span class="ui dim">class</span> %s' % esc(e.cls))
    if e.get("dir", ""):
        bits.append('<span class="ui dim">dir</span> <span class="path">%s'
                    '</span>' % esc(e.get("dir")))
    if e.get("lock", ""):
        bits.append('<span class="ui dim">lock</span> %s' % esc(e.get("lock")))
    if bits:
        subs.append('<p class="row__sub">%s</p>' % " &middot; ".join(bits))
    if e.needs:
        unmet = set(blocked_by(p, e))
        subs.append('<p class="row__sub"><span class="ui dim">needs</span> %s'
                    '</p>'
                    % " ".join('<a class="id%s" href="#e-%s">%s</a>'
                               % (" id--unmet" if n in unmet else "",
                                  esc(n), esc(n)) for n in e.needs))
    blocks = dependents(p, e.id)
    if blocks:
        subs.append('<p class="row__sub"><span class="ui dim">blocks</span> %s'
                    '</p>' % " ".join(h_id(b) for b in blocks))
    if e.get("retracted", ""):
        subs.append('<p class="row__sub"><span class="ui dim">retracted</span> '
                    '%s</p>' % esc(e.get("retracted")))
    subs.append(h_grade(p, e))
    subs.append(h_return(p, rets, e.id))
    more = []
    body = md_block(prose_of(p, e))
    if body:
        more.append(body)
    kids = micro_children(p, e)
    if kids:
        items = []
        for k in kids:
            kkey = ui_key(p, k)
            items.append('<li%s>%s<span>%s</span> <span class="dim">%s</span>'
                         '</li>'
                         % (' class="is-retracted"' if kkey == "retracted"
                            else "", h_mark(kkey), esc(k.id), ttl(k.title)))
        more.append('<ul class="micro">%s</ul>' % "".join(items))
    # §5: the note control is quiet — inside the disclosure the row already
    # has, never top-level chrome.  A row that had nothing to disclose grows
    # one, because the alternative is a write affordance on every line.
    more.append(h_write_note(p, e.id))
    subs.append('<details class="more"><summary>more</summary>'
                '<div class="body">%s</div></details>' % "".join(more))
    out.append(h_row(p, e, "".join(subs), anchor=True))
    return "".join(out)


def h_module(p, ft, ix, sched, mine, rets):
    row = None
    for f, r in pass_board(p)[0]:
        if f.id == ft.id:
            row = r
            break
    row = row or [ft]
    lanes_here = [x for x in row if x.id != ft.id]

    mix = {}
    for x in row:
        k = ui_key(p, x)
        mix[k] = mix.get(k, 0) + 1
    where = " · ".join("%d %s" % (mix[k], UI_STATE[k][1])
                       for k in CENSUS_ORDER + ("retracted",)
                       if mix.get(k)) or "%d capabilities" % len(row)

    # the module head IS the Feature's definition row, so it carries the
    # entity anchor as well as the section's own
    out = ['<div class="mod__h" id="e-%s" data-entity="%s" data-state="%s">'
           '<h2 class="d2">%s</h2>%s%s</div>%s'
           % (esc(ft.id), esc(ft.id), esc(disk_state(ft)),
              esc(module_name(ft)), h_state(p, ft, True),
              h_entity_src(p, ft), h_slot(ft.id))]
    out.append('<p class="d3 mod__p">%s</p>' % ttl(ft.title))
    out.append('<dl class="mod__x"><dt class="ui">accepted when</dt><dd>%s</dd>'
               '</dl>' % esc(ft.get("exit", "(no exit declared)")))

    # the module's own row of the pass, at local size, with id chips
    by = {}
    for x in row:
        k = ui_key(p, x)
        if k == "retracted":
            continue
        by.setdefault(k, []).append(x)
    strip = ['<div class="strip6">'
             '<div class="board__wall" aria-hidden="true"></div>']
    for key in CENSUS_ORDER:
        pairs = "".join('<span class="tkw">%s%s</span>'
                        % (_ticket(p, x), h_id(x.id))
                        for x in by.get(key, []))
        # one group per column so the word stays with its track when the
        # columns dissolve below 900px
        strip.append('<div class="strip6__c" style="grid-column:%d">'
                     '<div class="slot" style="grid-column:%d;grid-row:1">%s'
                     '</div><span class="strip6__k ml" style="grid-column:%d;'
                     'grid-row:2">%s</span></div>'
                     % (STRIP_COL[key], STRIP_COL[key], pairs,
                        STRIP_COL[key], esc(UI_STATE[key][1])))
    strip.append("</div>")
    out.append("".join(strip))

    out.append(h_sub("lanes", str(len(lanes_here)),
                     "".join(h_lane_row(p, x, rets, mine)
                             for x in lanes_here)
                     or '<p class="plain"><span>This feature names no lanes '
                        'of its own.</span></p>'))

    fl = module_flags(p, ft)
    if fl:
        stops = []
        for e in fl:
            cw = e.get("clears_when", "")
            by_lane = e.get("cleared_by", "")
            tail = (h_id(by_lane) if by_lane else
                    '<span class="fl__w">no lane is named to clear it '
                    '&mdash; naming one is the move</span>')
            stops.append('<div class="stop"><span class="stop__m">%s</span>'
                         '<div><p class="stop__t">%s</p>'
                         '<p class="stop__c">clears when %s</p>'
                         '<p class="row__sub">%s %s %s</p></div></div>'
                         % (h_sev(e), ttl(e.title), esc(cw or "(owed)"),
                            h_id(e.id), h_entity_src(p, e), tail))
        stops_body = '<div class="stops">%s</div>' % "".join(stops)
    else:
        stops_body = ('<p class="plain"><span>No open flag in the plan names a '
                      'lane in this module. Flags no chain reaches are in the '
                      '<a href="#flags">Flags</a> ledger.</span></p>')
    out.append(h_sub("what stops it", str(len(fl)), stops_body))

    out.append(h_walk(p, ft))

    _s, kind, nxt, who, _nodes, _d = rail_frontier(p, ft, mine, sched)
    tag = ""
    if kind == "person" and who in mine:
        tag = '<span class="rev">waiting on you</span>'
    elif kind == "person":
        tag = '<span class="tag tag--caveat">waiting on a person</span>'
    elif kind == "machine":
        tag = '<span class="tag tag--accent">in flight</span>'
    elif kind == "work":
        tag = '<span class="tag dim">waiting on work</span>'
    out.append('<p class="next"><span class="ui">next</span><span>%s%s</span>'
               '</p>' % (tag, esc(nxt)))

    return h_sec("m-" + module_slug(ft), "Module %02d" % ix, where, None,
                 '<div class="pan">%s</div>' % "".join(out))


# -- §7.5 THE INSTRUMENTS ---------------------------------------------------

def h_instruments(p, sched, mine, rets):
    _rows, estate = pass_board(p)
    body = [h_sub("lanes", str(len(estate)),
                  "".join(h_lane_row(p, x, rets, mine) for x in estate)
                  or '<p class="plain"><span>Every capability belongs to a '
                     'module.</span></p>')]
    hz = [p.entities[i] for i in p.order if p.entities[i].type == "Horizon"]
    if hz:
        items = []
        for e in hz:
            items.append('<div class="hzn__i" id="e-%s" data-entity="%s" '
                         'data-state="%s"><span class="id id--ghost">%s</span>'
                         '<div><span class="row__title">%s</span>'
                         '<p class="hzn__a"><b>after:</b> %s</p>%s</div></div>'
                         % (esc(e.id), esc(e.id), esc(disk_state(e)),
                            esc(e.id), ttl(e.title),
                            esc(e.get("after", "(no condition declared)")),
                            h_slot(e.id)))
        body.append(h_sub("horizons", str(len(hz)),
                          '<div class="hzn">%s</div>'
                          '<p class="sec__note">Written down so it stops being '
                          'a surprise; cannot be scheduled.</p>'
                          % "".join(items)))
    return h_sec("instruments", "The instruments", "%d lanes" % len(estate),
                 "Work that belongs to the estate, not to a module &mdash; the "
                 "harness, the receipts, the guards.",
                 '<div class="pan">%s</div>' % "".join(body))


# -- §7.6 DECISIONS ---------------------------------------------------------

def h_decisions(p, mine, rets, sched):
    decs = [p.entities[i] for i in p.order if p.entities[i].type == "Decision"]
    openn = [d for d in decs if d.state != "ruled"]
    ruled = [d for d in decs if d.state == "ruled"]
    openn.sort(key=lambda d: (-len(holds(p, d.id)), d.id))
    rows = []
    for e in openn + ruled:
        is_ruled = e.state == "ruled"
        blocks = dependents(p, e.id)
        meta = [h_entity_src(p, e)]
        if blocks:
            meta.append('<span class="ui dim">blocks</span> '
                        + " ".join(h_id(b) for b in blocks))
        right = []
        if is_ruled:
            right.append(esc(e.get("ruled", "—")))
        else:
            right.append("holds %d" % len(holds(p, e.id)))
        head = ('<span class="ui %s">%s</span>%s'
                '<span class="led__t">%s</span>'
                '<span class="led__r">%s</span>'
                '<span class="led__m">%s</span>'
                % (UI_STATE[ui_key(p, e)][3],
                   esc(UI_STATE[ui_key(p, e)][1]),
                   h_id(e.id, self_link=False), ttl(e.title),
                   "".join(right), " ".join(meta)))
        attrs = ('data-entity="%s" data-state="%s" data-search="%s" '
                 'data-statekey="%s"'
                 % (esc(e.id), esc(disk_state(e)),
                    esc(search_key([e.id, e.title, e.get("options", ""),
                                    e.get("ruled", ""),
                                    e.get("recommend", "")])),
                    "ruled" if is_ruled else "open-decision"))
        if not is_ruled and e.id in mine:
            # the machinery lives in the queue, once (§11-4)
            rows.append('<div class="ledw" id="e-%s" %s>'
                        '<a class="led" href="#need-%s">%s</a>'
                        '<p class="led__q"><a href="#need-%s">rule it in your '
                        'queue &rarr;</a></p></div>'
                        % (esc(e.id), attrs, esc(e.id), head, esc(e.id)))
            continue
        # ruled decisions expand for the record; an open decision the queue
        # does not carry has to keep its machinery somewhere, and this is the
        # only other place it exists
        if is_ruled:
            slug = (e.get("ruled", "").split() or [""])[0]
            reopen = e.get("reopen_when", "").strip()
            # §5: the owed caveat tag becomes the place to cure it.  A
            # recorded condition is shown with the words the script matches a
            # pending draft against, so a draft can retire itself.
            if reopen:
                cure = ('<span class="rw" data-reopen-for="%s" '
                        'data-reopen-body="%s">%s</span>'
                        % (esc(e.id), esc(" ".join(reopen.split())),
                           esc(reopen)))
            elif e.id in mine:
                cure = ('<span class="tag tag--caveat">owed</span> '
                        '<a href="#need-%s">write it in your queue &rarr;</a>'
                        % esc(e.id))
            else:
                cure = ('<span class="tag tag--caveat">owed</span>%s'
                        % h_write_reopen(e))
            inner = (h_decision_why(p, e, collapsed=True)
                     + h_options(p, e, slug)
                     + '<dl class="kv"><dt>ruled</dt><dd>%s</dd>'
                       '<dt>reopen when</dt><dd>%s</dd></dl>'
                     % (esc(e.get("ruled", "—")), cure)
                     + h_notes(p, e.id) + h_write_note(p, e.id))
        else:
            inner = h_action_body(p, e, "rule", rets, sched)
        rows.append('<div class="ledw" id="e-%s" %s><div class="led">%s</div>'
                    '<details class="more"><summary>%s</summary>'
                    '<div class="body">%s</div></details></div>'
                    % (esc(e.id), attrs, head,
                       "the record" if is_ruled
                       else "the options, and what a ruling would release",
                       inner))
    bar = h_filter("decisions", [("open-decision", "open"), ("ruled", "ruled")],
                   len(decs), "id, title, option, rationale…",
                   {"open-decision": len(openn), "ruled": len(ruled)})
    empty = ('<p class="nohits" data-empty-for="decisions" hidden>Nothing '
             'matches. Clear the filter to see all %d.</p>' % len(decs))
    return h_sec("decisions", "Decisions", "%d open of %d"
                 % (len(openn), len(decs)),
                 "Every fork, open first. Choosing here collects the exact "
                 "words to record it; it records nothing itself.",
                 bar + '<div class="pan pan--flush" data-scope="decisions" '
                       'style="padding:0 24px">%s</div>%s'
                 % ("".join(rows) or '<p class="plain"><span>None declared.'
                                     '</span></p>', empty))


# -- §7.7 FLAGS -------------------------------------------------------------

def h_flag_row(p, e, mine):
    cleared = e.state == "cleared"
    by = e.get("cleared_by", "")
    tail = (h_id(by) if by else
            '<span class="fl__w">no lane is named to clear it &mdash; naming '
            'one is the move</span>')
    right = []
    if e.id in mine:
        right.append('<span class="rev">yours</span>')
    if cleared:
        right.append('<span class="ui dim">cleared</span>')
    body = md_block(prose_of(p, e))
    more = ('<details class="more"><summary>%s</summary>'
            '<div class="body">%s%s</div></details>'
            % ("what was actually found" if body else "more",
               body, h_write_note(p, e.id)))
    return ('<div class="fl" id="e-%s" data-entity="%s" data-state="%s" '
            'data-search="%s" data-statekey="%s">'
            '<span class="fl__b">%s</span>'
            '<div><p class="fl__t">%s</p>'
            '<p class="stop__c">clears when %s</p></div>'
            '<span class="fl__r">%s</span>'
            '<div class="fl__c">%s %s %s%s%s</div></div>'
            % (esc(e.id), esc(e.id), esc(disk_state(e)),
               esc(search_key([e.id, e.title, e.get("severity", ""),
                               e.get("clears_when", "")])),
               "cleared" if cleared else "open-flag",
               ('<span class="sev sev--%s"><span class="sev__b" '
                'aria-hidden="true"></span></span>'
                % ((e.get("severity", "") or "info")
                   if (e.get("severity", "") or "info")
                   in ("blocker", "warn", "info") else "info")),
               ttl(e.title), esc(e.get("clears_when", "(owed)")),
               "".join(right),
               h_id(e.id, self_link=False), h_entity_src(p, e), tail,
               h_notes(p, e.id) + h_slot(e.id), more))


def h_flags(p, mine):
    flags = [p.entities[i] for i in p.order if p.entities[i].type == "Flag"]
    n = len(flags)
    openn = [f for f in flags if f.state != "cleared"]
    body = []
    for sev, word in (("blocker", "blockers"), ("warn", "warns"),
                      ("info", "infos")):
        group = [f for f in openn
                 if (f.get("severity", "") or "info") == sev]
        if not group:
            continue
        body.append(h_sub(word, str(len(group)),
                          "".join(h_flag_row(p, f, mine) for f in group)))
    cl = [f for f in flags if f.state == "cleared"]
    if cl:
        body.append('<details class="more"><summary>%d cleared</summary>'
                    '<div class="body">%s</div></details>'
                    % (len(cl), "".join(h_flag_row(p, f, mine) for f in cl)))
    bar = h_filter("flags", [("open-flag", "open"), ("cleared", "cleared")],
                   n, "id, title, clears-when…",
                   {"open-flag": len(openn), "cleared": len(cl)})
    empty = ('<p class="nohits" data-empty-for="flags" hidden>Nothing matches. '
             'Clear the filter to see all %d.</p>' % n)
    return h_sec("flags", "Flags", "%d open of %d" % (len(openn), n),
                 "What is wrong with the world right now, and what would make "
                 "each one go away. A blocker is a stopped lane somewhere "
                 "else.",
                 bar + '<div class="pan" data-scope="flags">%s</div>%s%s'
                 % ("".join(body) or '<p class="plain"><span>None declared.'
                                     '</span></p>', empty, h_write_flag()))


# -- §7.8 EVIDENCE ----------------------------------------------------------

def h_facts_table(p):
    now = time.time()
    rows = []
    for key in sorted(p.facts):
        f = p.facts[key]
        ts = parse_iso(f.ts)
        secs = (now - ts) if ts else None
        age = fmt_age(secs) if secs is not None else "?"
        acls = ""
        if secs is not None and secs >= 86400:
            acls = " is-aging"
        elif secs is not None and secs >= 3600:
            acls = " is-aging"
        val = esc(f.content)
        if f.status != "ok":
            val = ('<span class="tag--unconf" style="color:var(--caveat)">%s'
                   '</span>' % val)
        status = ('<span class="tag tag--caveat">unconfirmed</span>'
                  if f.status != "ok" else '<span class="dim">ok</span>')
        pr = p.probes.get(key)
        rows.append('<tr><td class="path">%s</td><td class="tbl__v">%s</td>'
                    '<td class="num dim%s">%s</td><td>%s</td>'
                    '<td class="dim">%s</td><td>%s</td></tr>'
                    % (esc(key), val, acls, esc(age), status,
                       esc("%s · %s" % (pr.kind, pr.extractor)) if pr
                       else "no probe",
                       h_src(p.plan_md, f.line + 1,
                             label="line %d" % (f.line + 1))))
    return ('<div class="tbl__wrap"><table class="tbl"><thead><tr><th>fact</th>'
            '<th>value</th><th>age</th><th>state</th><th>probe</th>'
            '<th>source</th></tr></thead><tbody>%s</tbody></table></div>'
            % "".join(rows))


def h_evidence(p):
    ep = evidence_picture(p)
    st = ep["states"]
    cells = [("accepted", "accepted", ""),
             ("verified", "verified", "is-verified"),
             ("built-unverified", "built, unverified", "is-built"),
             ("running", "running", ""), ("ready", "ready", ""),
             ("blocked", "blocked", "")]
    grid = "".join('<div class="%s"><b class="num">%d</b>'
                   '<span class="ui">%s</span></div>'
                   % (cls, st.get(key, 0), esc(label))
                   for key, label, cls in cells)
    nb = st.get("built-unverified", 0)
    admissible = sum(v for k, v in ep["kinds"].items() if k != "suite")
    suite_probes = ep["kinds"].get("suite", 0)
    if nb:
        say = ("<b>%d of %d capabilities are built and unverified.</b> "
               "That is not a backlog of laziness: <span class=\"path\">plan "
               "verify</span> refuses a test-suite count as evidence (guard 1),"
               " so an item only leaves that state when a non-suite instrument "
               "&mdash; a journey capture, a wire probe, a schema probe, an "
               "artifact a stranger can open &mdash; exists and is named."
               % (nb, ep["n"]))
        if ep["inadmissible"]:
            say += (" %d of them currently point at suite output, which is "
                    "exactly what the guard refuses." % ep["inadmissible"])
    elif ep["n"]:
        say = ("<b>Nothing is sitting in built-unverified.</b> Every capability "
               "here has either been carried to verified against a non-suite "
               "instrument, or has not been built yet.")
    else:
        say = "<b>No capabilities are declared yet.</b>"
    lines = ['<p class="sec__note">%d probe%s declared: %s. A probe parses a '
             'committed artifact; none of them runs anything. %d fact%s '
             'unconfirmed right now &mdash; the last measured value is retained '
             'and marked, never blanked.</p>'
             % (len(p.probes), "" if len(p.probes) == 1 else "s",
                esc(", ".join("%d %s" % (v, k)
                              for k, v in sorted(ep["kinds"].items())))
                or "none",
                ep["unconf"], "" if ep["unconf"] == 1 else "s")]
    if suite_probes and not admissible:
        lines.append('<p class="sec__note"><span class="tag tag--caveat">no '
                     'admissible instrument</span> every probe in this plan is '
                     'suite-kind, so no fact here can carry an item out of '
                     'built-unverified.</p>')
    grades = [("proven", "a probe measured it; the value and its age are on "
                         "this page"),
              ("seen", "a human pointed at an artifact nothing parses"),
              ("claimed", "asserted and unverified — the only grade that rots "
                          "silently")]
    key = "".join('<div class="key__i"><span class="grade grade--%s">%s</span>'
                  '<span>%s</span></div>' % (g, g, esc(t)) for g, t in grades)
    body = ['<div class="pan"><div class="ledger">%s</div>'
            '<p class="whyline">%s</p>%s</div>' % (grid, say, "".join(lines))]
    body.append(h_sub("facts", str(len(p.facts)),
                      '<div class="pan pan--flush" style="padding:16px">%s'
                      '</div>' % h_facts_table(p)))
    d = compute_disputes(p)
    if d:
        body.append(h_sub("disputes", str(len(d)),
                          '<div class="pan">%s<p class="sec__note">A '
                          'machine-detectable contradiction between an authored '
                          'claim and a probed fact. The renderer never edits '
                          'the text; it shows the disagreement and leaves both '
                          'sides standing.</p></div>'
                          % "".join('<p class="plain"><span>%s</span>'
                                    '<span class="tag tag--caveat">dispute'
                                    '</span></p>' % esc(x) for x in d)))
    body.append(h_sub("provenance", None,
                      '<div class="pan"><div class="key">%s</div></div>' % key))
    return h_sec("evidence", "Evidence", "%d facts" % len(p.facts),
                 "Every machine claim, its age, and the probe that produced it. "
                 "A stale number is the only thing on this page that can "
                 "mislead quietly.", "".join(body))


# -- §7.9 LOG ---------------------------------------------------------------

def h_log(p):
    try:
        with open(p.log_md, "r", encoding="utf-8") as fh:
            raw = [l.strip() for l in fh if l.strip()]
    except IOError:
        raw = []
    events = []
    for line in raw:
        m = LOG_RE.match(line)
        if m:
            events.append((m.group(1), m.group(2), m.group(3)))
    owner = (p.owner or "").lower()
    out, day = [], None
    for ts, who, what in reversed(events[-400:]):
        d = ts[:10]
        if d != day:
            if day is not None:
                out.append("</ul>")
            out.append('<p class="day">%s</p><ul class="events">' % esc(d))
            day = d
        out.append('<li%s><time>%s</time><span class="who">%s</span>'
                   '<span class="what">%s</span></li>'
                   % (' class="is-owner"' if who.lower() == owner else "",
                      esc(ts[11:]) or esc(ts), esc(who), md_inline(what)))
    if day is not None:
        out.append("</ul>")
    st_rows, runs = [], 0
    try:
        with open(p.stamps, "r", encoding="utf-8") as fh:
            srows = [l.split() for l in fh if l.strip()]
    except IOError:
        srows = []
    seen, per = {}, {}
    for parts in srows:
        if len(parts) != 4:
            continue
        runs += 1
        rec = per.setdefault(parts[1], {"n": 0, "shas": set()})
        rec["n"] += 1
        rec["shas"].add(parts[3])
        seen[parts[1]] = parts
    for key in sorted(seen):
        parts, rec = seen[key], per[key]
        moved = ("unchanged across %d run%s"
                 % (rec["n"], "" if rec["n"] == 1 else "s")
                 if len(rec["shas"]) == 1 else
                 "%d values across %d runs" % (len(rec["shas"]), rec["n"]))
        st_rows.append('<tr><td>%s</td><td class="path">%s</td><td>%s</td>'
                       '<td class="dim">%s</td></tr>'
                       % (esc(parts[0]), esc(key),
                          ('<span class="tag tag--caveat">unconf</span>'
                           if parts[2] != "ok" else "ok"), esc(moved)))
    stamps = ('<details class="more" id="stamps"><summary>%d probe runs, one '
              'row per fact &mdash; %s</summary><div class="body">'
              '<div class="tbl__wrap"><table class="tbl log"><thead><tr>'
              '<th>last run</th><th>fact</th><th>state</th><th>history</th>'
              '</tr></thead><tbody>%s</tbody></table></div></div></details>'
              % (runs, h_src(p.stamps, label="stamps.log"), "".join(st_rows)))
    return h_sec("log", "Log", "%d events" % len(events),
                 "What actually happened, newest first. The plan is state; "
                 "this is history, and it only ever grows &mdash; nothing in "
                 "%s is ever edited." % h_src(p.log_md, label="log.md"),
                 '<div class="pan">%s%s</div>'
                 % ("".join(out) or '<p class="plain"><span>No dated event has '
                                    'been written yet.</span></p>', stamps))


