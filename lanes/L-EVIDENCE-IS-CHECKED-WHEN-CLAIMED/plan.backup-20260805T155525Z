def now_iso():
    return time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime())


def today_iso():
    return time.strftime("%Y-%m-%d", time.gmtime())


def _days_from_civil(y, m, d):
    y -= 1 if m <= 2 else 0
    era = (y if y >= 0 else y - 399) // 400
    yoe = y - era * 400
    doy = (153 * (m + (-3 if m > 2 else 9)) + 2) // 5 + d - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468


def parse_iso(s):
    """ISO-8601 UTC -> epoch seconds.  None when unparseable."""
    if not s or len(s) < 10:
        return None
    try:
        y, mo, d = int(s[0:4]), int(s[5:7]), int(s[8:10])
        h = mi = sec = 0
        if len(s) >= 16 and s[10] in "T ":
            h, mi = int(s[11:13]), int(s[14:16])
            if len(s) >= 19 and s[16] == ":":
                sec = int(s[17:19])
        return _days_from_civil(y, mo, d) * 86400 + h * 3600 + mi * 60 + sec
    except (ValueError, IndexError):
        return None


def fmt_age(sec):
    if sec is None:
        return "?"
    if sec < 0:
        sec = 0
    m = int(sec // 60)
    if m < 60:
        return "%dm" % m
    h = m // 60
    if h < 48:
        return "%dh" % h
    return "%dd" % (h // 24)


def fmt_num(x):
    """1.0 -> '1', 0.5 -> '0.5' — for pts= in DISPATCH lines (§3.5)."""
    if abs(x - round(x)) < 1e-9:
        return str(int(round(x)))
    return ("%.1f" % x).rstrip("0").rstrip(".")


def sha_hex(data):
    import hashlib
    if isinstance(data, str):
        data = data.encode("utf-8")
    return hashlib.sha256(data).hexdigest()


def split_tokens(s):
    """Split on ' · ' but never inside double quotes (exit:"a · b")."""
    out, buf, q, i, n = [], [], False, 0, len(s)
    while i < n:
        c = s[i]
        if c == '"':
            q = not q
            buf.append(c)
            i += 1
            continue
        if not q and c == " " and s[i + 1:i + 3] == MDOT + " ":
            out.append("".join(buf))
            buf = []
            i += 3
            continue
        buf.append(c)
        i += 1
    out.append("".join(buf))
    return out


def unquote(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == '"' and v[-1] == '"':
        return v[1:-1]
    return v


def id_list(v):
    return [x.strip() for x in v.replace(";", ",").split(",") if x.strip()]


def eprint(*a):
    sys.stderr.write(" ".join(str(x) for x in a) + "\n")


def die(code, msg):
    eprint("plan: " + msg)
    sys.exit(code)


# ---------------------------------------------------------------------------
# 3. Model
# ---------------------------------------------------------------------------

class Diag(object):
    __slots__ = ("file", "line", "sev", "rule", "msg")

    def __init__(self, file, line, sev, rule, msg):
        self.file, self.line, self.sev, self.rule, self.msg = \
            file, line, sev, rule, msg

    def render(self):
        return "%s:%d %s %s %s" % (self.file, self.line, self.sev, self.rule,
                                   self.msg)


class Entity(object):
    __slots__ = ("id", "type", "title", "state", "fields", "line", "kind",
                 "parent", "block_end", "prose", "indent", "raw_state",
                 "field_lines", "order")

    def __init__(self, eid, etype, title, line, kind):
        self.id = eid
        self.type = etype
        self.title = title
        self.line = line          # 0-based index into Plan.lines
        self.kind = kind          # 'block' | 'item'
        self.state = None
        self.raw_state = None
        self.fields = {}
        self.field_lines = {}     # field name -> line index (block entities)
        self.parent = None        # micro-item parent id
        self.block_end = line
        self.prose = []
        self.indent = ""
        self.order = 0

    # -- field accessors -----------------------------------------------
    def get(self, k, default=None):
        v = self.fields.get(k)
        return default if v is None else v

    @property
    def needs(self):
        out = id_list(self.get("needs", ""))
        g = self.get("gate", "")
        if g:
            out = out + id_list(g)
        return out

    @property
    def cls(self):
        return self.get("class", "")

    @property
    def pts(self):
        v = self.get("pts", "")
        if v:
            try:
                return float(v)
            except ValueError:
                pass
        return CLASS_PTS.get(self.cls, 1.0)

    @property
    def is_micro(self):
        return self.parent is not None


class Probe(object):
    __slots__ = ("key", "kind", "source", "extractor", "line")

    def __init__(self, key, kind, source, extractor, line):
        self.key, self.kind, self.source, self.extractor, self.line = \
            key, kind, source, extractor, line


class Fact(object):
    __slots__ = ("key", "ts", "status", "content", "line", "col", "end_line",
                 "end_col")

    def __init__(self, key, ts, status, content, line, col, end_line, end_col):
        self.key, self.ts, self.status, self.content = key, ts, status, content
        self.line, self.col, self.end_line, self.end_col = \
            line, col, end_line, end_col


class Note(object):
    """One recorded note (NOTES.md §1).  `target` is the id its own line
    names — attachment is by that id and never by position, so a note filed
    under the wrong heading still belongs to what it is about."""
    __slots__ = ("actor", "date", "target", "text", "line", "end_line")

    def __init__(self, actor, date, target, text, line, end_line):
        self.actor, self.date, self.target, self.text = actor, date, target, \
            text
        self.line, self.end_line = line, end_line


class Plan(object):
    def __init__(self, plan_dir):
        self.dir = plan_dir
        self.plan_md = os.path.join(plan_dir, "plan.md")
        self.intent_md = os.path.join(plan_dir, "intent.md")
        self.log_md = os.path.join(plan_dir, "log.md")
        self.stamps = os.path.join(plan_dir, "stamps.log")
        self.returns = os.path.join(plan_dir, "returns")
        self.briefs = os.path.join(plan_dir, "briefs")
        self.render_dir = os.path.join(plan_dir, "render")
        self.lines = []
        self.trailing_nl = True
        self.front = {}
        self.front_lines = {}
        self.entities = {}
        self.order = []
        self.probes = {}
        self.facts = {}
        self.diags = []
        self.prose_lines = []
        self.notes = []           # NOTES.md §1, file order
        self.notes_by_id = {}     # id -> [Note] — what the renderer reads
        self.fatal = None
        self.repo_root = find_repo_root(plan_dir)

    # -- diagnostics ---------------------------------------------------
    def err(self, line, rule, msg, file=None):
        self.diags.append(Diag(file or rel(self.plan_md, self.repo_root),
                               line + 1, "error", rule, msg))

    def warn(self, line, rule, msg, file=None):
        self.diags.append(Diag(file or rel(self.plan_md, self.repo_root),
                               line + 1, "warn", rule, msg))

    # -- frontmatter derived -------------------------------------------
    @property
    def name(self):
        return self.front.get("plan", "?")

    @property
    def owner(self):
        return self.front.get("owner", "")

    @property
    def phase(self):
        return self.front.get("phase", "draft")

    @property
    def caps(self):
        caps = dict(DEFAULT_CAPS)
        raw = self.front.get("caps", "")
        for tok in raw.split():
            if "=" in tok:
                k, v = tok.split("=", 1)
                if k in caps:
                    try:
                        caps[k] = int(v)
                    except ValueError:
                        pass
        return caps

    @property
    def cpu_points(self):
        try:
            return float(self.front.get("cpu_points", "0.75"))
        except ValueError:
            return 0.75

    @property
    def load_gate(self):
        try:
            return float(self.front.get("load_gate", "1.5"))
        except ValueError:
            return 1.5

    # -- io ------------------------------------------------------------
    def write_plan(self):
        text = "\n".join(self.lines)
        if self.trailing_nl:
            text += "\n"
        write_atomic(self.plan_md, text)

    def log(self, text, actor="tool"):
        append_log(self.log_md, text, actor)


def rel(path, root):
    try:
        return os.path.relpath(path, root)
    except ValueError:
        return path


def in_git_repo(root):
    """True at the top of a working tree.  In a *linked worktree* (and in a
    submodule) `.git` is a file holding `gitdir: <path>`, not a directory —
    testing for a directory silently demotes every worktree to "not in git",
    which turns the git-backed checks off without saying so."""
    return os.path.exists(os.path.join(root, ".git"))


def find_repo_root(plan_dir):
    d = os.path.abspath(plan_dir)
    while True:
        if in_git_repo(d):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    # No git: the repo root is the parent of the doc-authority dir.
    # CHOICE(§1.1): probe sources are repo-root-relative; with docs/plan/ the
    # root is two levels up, otherwise one.
    a = os.path.abspath(plan_dir)
    if os.path.basename(a) == "plan" and \
       os.path.basename(os.path.dirname(a)) == "docs":
        return os.path.dirname(os.path.dirname(a))
    return os.path.dirname(a)


def write_atomic(path, text):
    tmp = path + ".tmp-plan"
    with open(tmp, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(text)
    os.replace(tmp, path)


def append_log(log_md, text, actor="tool"):
    line = "- %s %s %s %s %s\n" % (now_iso(), MDOT, actor, MDOT, text)
    with open(log_md, "a", encoding="utf-8", newline="\n") as fh:
        fh.write(line)


# ---------------------------------------------------------------------------
# 4. Discovery (§1.1: walk up for plan.md carrying a `plan:` frontmatter key)
# ---------------------------------------------------------------------------

def has_plan_key(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            first = fh.readline()
            if first.strip() != "---":
                return False
            for _ in range(64):
                line = fh.readline()
                if not line or line.strip() == "---":
                    return False
                if line.startswith("plan:"):
                    return True
    except (IOError, OSError, UnicodeDecodeError):
        return False
    return False


def discover(explicit=None):
    if explicit:
        d = os.path.abspath(explicit)
        cand = os.path.join(d, "plan.md")
        if os.path.isfile(cand):
            return d
        cand = os.path.join(d, "docs", "plan", "plan.md")
        if os.path.isfile(cand):
            return os.path.dirname(cand)
        die(EX_REFUSED, "no plan.md under %s" % explicit)
    d = os.path.abspath(os.getcwd())
    while True:
        for cand in (os.path.join(d, "docs", "plan", "plan.md"),
                     os.path.join(d, "plan.md")):
            if os.path.isfile(cand) and has_plan_key(cand):
                return os.path.dirname(cand)
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    die(EX_REFUSED, "no plan found — walked up from %s looking for plan.md "
                    "with a `plan:` frontmatter key" % os.getcwd())


# ---------------------------------------------------------------------------
# 5. The parser — single pass, line oriented (§2)
# ---------------------------------------------------------------------------

def load(plan_dir):
    p = Plan(plan_dir)
    try:
        with open(p.plan_md, "r", encoding="utf-8") as fh:
            text = fh.read()
    except IOError as exc:
        die(EX_REFUSED, "cannot read %s (%s)" % (p.plan_md, exc))
    p.trailing_nl = text.endswith("\n")
    p.lines = text.split("\n")
    if p.trailing_nl and p.lines and p.lines[-1] == "":
        p.lines.pop()
    parse(p)
    return p


def parse(p):
    lines = p.lines
    n = len(lines)
    i = 0

    # -- frontmatter (§2.1) -------------------------------------------
    if n and lines[0].strip() == "---":
        i = 1
        closed = False
        while i < n:
            raw = lines[i]
            s = raw.strip()
            if s == "---":
                closed = True
                i += 1
                break
            if raw[:1] in (" ", "\t") or s.startswith("- "):
                # §2.1: nesting is forbidden — parse-fatal
                p.fatal = (i, "frontmatter must be flat "
                              "" + EMDASH + " this is not YAML")
                return
            if ":" not in s:
                if s:
                    p.warn(i, "W-FM-SYNTAX",
                           "frontmatter line has no `key: value` — ignored")
            else:
                k, v = s.split(":", 1)
                k = k.strip()
                v = v.strip()
                if not v and i + 1 < n and lines[i + 1][:1] in (" ", "\t"):
                    p.fatal = (i, "frontmatter must be flat "
                                  "" + EMDASH + " this is not YAML")
                    return
                p.front[k] = v
                p.front_lines[k] = i
            i += 1
        if not closed:
            p.fatal = (0, "frontmatter fence never closed")
            return

    # -- body ----------------------------------------------------------
    fence = None            # closing marker when inside a fenced block
    fence_info = ""
    cur = None              # current block entity
    in_fields = False
    block_key = None        # key currently taking an indented block value
    open_span = None        # (key, ts, status, line, col, parts)
    order = 0

    while i < n:
        raw = lines[i]
        s = raw.strip()

        # ---- fenced blocks (L7: fences carry literal artifacts) ------
        if fence is None and (s.startswith("```") or s.startswith("~~~")):
            fence = s[:3]
            fence_info = s[3:].strip()
            if fence_info == "probes":
                i = parse_probes(p, i + 1, fence)
                fence = None
                continue
            i += 1
            continue
        if fence is not None:
            if s.startswith(fence):
                fence = None
            i += 1
            continue

        # ---- fact spans (§2.5) --------------------------------------
        if "<!--" in raw:
            i2 = scan_spans(p, i, raw, open_span)
            if p.fatal:
                return
            open_span = i2

        # ---- headings ------------------------------------------------
        if raw.startswith("#"):
            if cur is not None:
                cur.block_end = i - 1
            in_fields = False
            block_key = None
            if raw.startswith("### "):
                cur = parse_heading(p, i, raw, order)
                if cur is not None:
                    order += 1
                    in_fields = True
            else:
                cur = None
            i += 1
            continue

        # ---- item lines (§2.3) --------------------------------------
        if s.startswith("- ["):
            ent = parse_item(p, i, raw, order)
            if ent is not None:
                order += 1
            in_fields = False
            block_key = None
            i += 1
            continue

        # ---- field paragraph (§2.2) ---------------------------------
        if cur is not None and in_fields:
            if s == "":
                in_fields = False
                block_key = None
                i += 1
                continue
            if s.startswith("|"):
                # options: continuation
                if "options" in cur.fields:
                    cur.fields["options"] = cur.fields["options"] + "\n" + \
                        s[1:].strip()
                else:
                    p.warn(i, "W-FIELD-ORPHAN",
                           "`|` option line with no preceding options: "
                           "" + EMDASH + " prose")
                i += 1
                continue
            if block_key is not None and raw[:1] in (" ", "\t"):
                cur.fields[block_key] = (cur.fields[block_key] + "\n" +
                                         s).strip("\n")
                i += 1
                continue
            m = FIELD_RE.match(s)
            if m:
                k, v = m.group(1), m.group(2).strip()
                if k not in BLOCK_FIELDS:
                    p.warn(i, "W-FIELD-UNKNOWN",
                           "unknown field `%s:` " % k + EMDASH + " prose")
                    cur.prose.append(i)
                    i += 1
                    continue
                if v == "|":
                    cur.fields[k] = ""
                    block_key = k
                else:
                    cur.fields[k] = v
                    block_key = None
                cur.field_lines[k] = i
                i += 1
                continue
            in_fields = False
            block_key = None
            # fall through to prose

        if cur is not None:
            cur.prose.append(i)
        else:
            p.prose_lines.append(i)
        i += 1

    if cur is not None:
        cur.block_end = n - 1
    if open_span is not None:
        # §2.5: an unclosed span is the one parse-fatal construct
        p.fatal = (open_span[3],
                   "unclosed fact span `%s` " % open_span[0] + EMDASH +
                   " a torn span swallows the rest of the file")
        return

    finish(p)


def scan_spans(p, i, raw, open_span):
    """Track fact spans across lines.  Returns the new open-span state."""
    pos = 0
    while True:
        if open_span is None:
            m = FACT_OPEN_RE.search(raw, pos)
            if not m:
                stray = raw.find(FACT_CLOSE, pos)
                if stray >= 0:
                    p.err(i, "E-FACT-STRAY",
                          "`<!--/fact-->` with no open span")
                return None
            open_span = (m.group(1), m.group(2), m.group(3), i, m.end(), [])
            pos = m.end()
        else:
            key, ts, status, sline, scol, parts = open_span
            nxt = FACT_OPEN_RE.search(raw, pos)
            end = raw.find(FACT_CLOSE, pos)
            if nxt and (end < 0 or nxt.start() < end):
                p.fatal = (i, "nested fact span inside `%s`" % key)
                return None
            if end < 0:
                parts.append(raw[pos:] if i > sline else raw[scol:])
                return open_span
            content = (raw[pos:end] if i > sline else raw[scol:end])
            parts.append(content)
            body = "\n".join(parts) if i > sline else content
            if key in p.facts:
                p.err(i, "E-FACT-DUP", "fact key `%s` has two spans" % key)
            p.facts[key] = Fact(key, ts, status, body, sline, scol, i, end)
            pos = end + len(FACT_CLOSE)
            open_span = None
            if pos >= len(raw):
                return None


def parse_probes(p, i, fence):
    n = len(p.lines)
    while i < n:
        raw = p.lines[i]
        s = raw.strip()
        if s.startswith(fence):
            return i + 1
        if s and not s.startswith("#"):
            parts = s.split(None, 3)
            if len(parts) < 4:
                p.err(i, "E-PROBE-SYNTAX",
                      "probe line needs `key kind source extractor`")
            else:
                key, kind, src, ext = parts[0], parts[1], parts[2], \
                    parts[3].strip()
                if kind not in PROBE_KINDS:
                    p.err(i, "E-PROBE-KIND",
                          "unknown probe kind `%s` (kinds: %s)"
                          % (kind, "|".join(PROBE_KINDS)))
                elif not (ext in EXTRACTORS or
                          any(ext.startswith(x) for x in EXTRACTOR_PREFIXES)):
                    p.err(i, "E-PROBE-EXTRACTOR",
                          "unknown extractor `%s` " % ext + EMDASH +
                          " the vocabulary is closed and has no exec form")
                elif key in p.probes:
                    p.err(i, "E-PROBE-DUP", "probe key `%s` declared twice"
                          % key)
                else:
                    p.probes[key] = Probe(key, kind, src, ext, i)
        i += 1
    p.err(i - 1, "E-PROBE-FENCE", "probes block never closed")
    return i


def parse_heading(p, i, raw, order):
    m = HEAD_RE.match(raw.rstrip())
    if not m:
        p.warn(i, "W-HEADING",
               "`###` heading is not `### <Type> <ID> " + EMDASH +
               " <title>` — prose")
        return None
    tword, eid, title = m.group(1), m.group(2), m.group(3).strip()
    if tword not in TYPE_PREFIX:
        # §2.2: bad type word -> whole section is prose, error
        p.err(i, "E-TYPE", "unknown entity type '%s' " % tword + EMDASH +
              " section is prose and is not scheduled")
        return None
    if not ID_RE.match(eid):
        p.err(i, "E-ID-GRAMMAR",
              "id `%s` does not match ^(FT|S|D|F|L|H)-[A-Z0-9][A-Z0-9-]*$"
              % eid)
        return None
    if eid.split("-", 1)[0] != TYPE_PREFIX[tword]:
        p.err(i, "E-ID-PREFIX", "id `%s` does not carry the `%s-` prefix of "
              "type %s" % (eid, TYPE_PREFIX[tword], tword))
        return None
    if eid in p.entities:
        p.err(i, "E-ID-DUP", "id `%s` is defined twice (first at line %d) "
              % (eid, p.entities[eid].line + 1) + EMDASH +
              " an id is defined exactly once")
        return None
    ent = Entity(eid, tword, title, i, "block")
    ent.order = order
    p.entities[eid] = ent
    p.order.append(eid)
    return ent


def parse_item(p, i, raw, order):
    m = ITEM_RE.match(raw.rstrip())
    if not m:
        p.warn(i, "W-ORPHAN-BULLET", "orphan bullet " + EMDASH +
               " not scheduled")
        return None
    indent, ch, eid, rest = m.group(1), m.group(2), m.group(3), m.group(4) or ""
    if ch not in CHAR_STATE:
        p.warn(i, "W-ORPHAN-BULLET", "orphan bullet (bracket `[%s]`) "
               % ch + EMDASH + " not scheduled")
        return None
    mm = MICRO_RE.match(eid)
    parent = None
    if mm:
        parent = mm.group(1)
    elif not ID_RE.match(eid):
        p.warn(i, "W-ORPHAN-BULLET", "orphan bullet (id `%s`) " % eid +
               EMDASH + " not scheduled")
        return None
    if eid in p.entities:
        p.err(i, "E-ID-DUP", "id `%s` is defined twice (first at line %d) "
              % (eid, p.entities[eid].line + 1) + EMDASH +
              " an id is defined exactly once")
        return None
    parts = split_tokens(rest)
    title = parts[0].strip()
    prefix = (parent or eid).split("-", 1)[0]
    etype = PREFIX_TYPE.get(prefix, "Lane")
    ent = Entity(eid, etype, title, i, "item")
    ent.indent = indent
    ent.order = order
    ent.parent = parent
    ent.raw_state = ch
    ent.state = CHAR_STATE[ch]
    for tok in parts[1:]:
        tok = tok.strip()
        if not tok:
            continue
        if tok.startswith("retracted:"):
            ent.fields["retracted"] = unquote(tok[len("retracted:"):].strip())
            continue
        if ":" not in tok:
            p.warn(i, "W-TOKEN", "trailing text `%s` is not a token " % tok +
                   EMDASH + " prose")
            continue
        k, v = tok.split(":", 1)
        k = k.strip()
        if k not in TOKEN_KEYS:
            p.warn(i, "W-TOKEN-UNKNOWN", "unknown token key `%s:` " % k +
                   EMDASH + " prose")
            continue
        ent.fields[k] = unquote(v)
    p.entities[eid] = ent
    p.order.append(eid)
    return ent


def finish(p):
    """Post-pass: states for block entities, micro-item parenting."""
    for eid in p.order:
        e = p.entities[eid]
        if e.kind == "item":
            continue
        st = e.fields.get("state")
        e.raw_state = st
        if e.type in ("Feature", "Lane"):
            e.state = st if st in WORK_STATES else None
        elif e.type == "Flag":
            e.state = st if st in FLAG_STATES else None
        elif e.type == "Decision":
            if st in DECISION_STATES:
                e.state = st
            elif e.fields.get("ruled"):
                e.state = "ruled"
            else:
                e.state = None
        elif e.type == "Stage":
            e.state = st if st in ("accepted", "open") else "open"
        else:                       # Horizon
            e.state = "open"
        if e.fields.get("ruled") and e.type == "Decision":
            e.state = "ruled"
    for eid in p.order:
        e = p.entities[eid]
        if e.parent and e.parent not in p.entities:
            p.warn(e.line, "W-MICRO-ORPHAN",
                   "micro-item `%s` has no parent `%s`" % (e.id, e.parent))
    collect_notes(p)


def collect_notes(p):
    """One recognition pass over the prose (NOTES.md §1).  Zero new fields:
    the parser has already left these lines in `ent.prose` / `p.prose_lines`
    untouched, and this reads them back and attaches each to the entity its
    own line names.  A malformed note is claimed by nothing and stays prose.

    Only lines the parser filed as prose are considered, which is what keeps a
    note-shaped line inside a fenced example from becoming a note."""
    idx = set(p.prose_lines)
    for e in p.entities.values():
        idx.update(e.prose)
    lines = p.lines
    n = len(lines)
    i = 0
    while i < n:
        if lines[i][:1] != ">" or i not in idx:
            i += 1
            continue
        m = NOTE_RE.match(lines[i])
        if m is None:
            i += 1
            continue
        body = [m.group(4)]
        j = i + 1
        while j < n and lines[j][:1] == ">" and j in idx \
                and NOTE_RE.match(lines[j]) is None:
            row = lines[j]
            body.append(row[2:] if row[:2] == "> " else row[1:])
            j += 1
        nt = Note(m.group(1), m.group(2), m.group(3), "\n".join(body),
                  i, j - 1)
        p.notes.append(nt)
        p.notes_by_id.setdefault(nt.target, []).append(nt)
        i = j


def notes_for(p, eid):
    """Every note attached to `eid`, in file order.  This is the renderer's
    door: notes are parsed and attached here, and rendered there."""
    return p.notes_by_id.get(eid, [])


# ---------------------------------------------------------------------------
# 6. Derived model: readiness, capacity, needed actions (§3)
# ---------------------------------------------------------------------------

def satisfied(p, target_id):
    """§3.2: needs targets are satisfied when accepted / cleared / ruled."""
    t = p.entities.get(target_id)
    if t is None:
        return False
    if t.type == "Flag":
        return t.state == "cleared"
    if t.type == "Decision":
        return t.state == "ruled"
    if t.type == "Horizon":
        return False
    return t.state == "accepted"


PROSE_EXT = (".md", ".markdown", ".rst", ".adoc")


def authored_source(probe):
    """True when a non-`meta` probe reads a file a human or a model writes.

    §2.6 says probes parse artifacts and never run suites, and defines
    artifact as *any file* — so a lane can reach `verified` on a sentence a
    model wrote about its own work.  `meta` is exempt: hashing intent.md is
    the whole point of that kind."""
    if probe.kind == "meta":
        return False
    src = probe.source.lower()
    base = src.split("/")[-1]
    return any(base.endswith(x) or base.endswith(x + "*") for x in PROSE_EXT) \
        or any(("*" + x) in base for x in PROSE_EXT)


def flag_gates_anything(p, fid):
    """True when some live entity's `needs:`/`gate:` names this flag.

    §3.2 makes a blocker flag gate only the lanes wired to it.  A plan can
    therefore carry eight blockers, shout `flags 8!` in the headline, and
    dispatch every lane — the advertised-control-that-gates-nothing shape
    this estate has already shipped in product code."""
    for eid in p.order:
        e = p.entities[eid]
        if e.state in ("retracted", "accepted"):
            continue
        if fid in e.needs:
            return True
    return False


def blocked_by(p, ent):
    """The unmet needs of ent, in declaration order."""
    out = []
    for nid in ent.needs:
        if not satisfied(p, nid):
            out.append(nid)
    return out


def is_ready(p, ent):
    """§3.2 — computed on every invocation, never stored anywhere."""
    if ent.state != "open" or ent.is_micro:
        return False
    for nid in ent.needs:
        t = p.entities.get(nid)
        if t is None:
            return False
        # There was a `severity == "blocker"` branch here.  A mutation proved
        # it dead: `satisfied()` already treats *any* uncleared Flag as unmet,
        # so no input could tell the branch's presence from its absence.  It
        # also implied §2.2's reading — that only a blocker gates — while
        # §3.2's `satisfied()` gated on every flag.  RULING: §3.2 wins, and it
        # is the safer of the two (more gating, never less).  `severity`
        # governs the headline and the page, not the gate; nobody writes
        # `needs: F-x` for a hazard they mean to dispatch past.
        if not satisfied(p, nid):
            return False
    return True


def lanes(p):
    return [p.entities[i] for i in p.order
            if p.entities[i].type == "Lane" and not p.entities[i].is_micro]


_kids_cache = {}


def micro_children(p, ent):
    """Children by parent id.  Built once per plan: scanning p.order per entity
    is O(n²) and the renderer asks for every entity in the file."""
    key = id(p)
    m = _kids_cache.get(key)
    if m is None:
        m = {}
        for i in p.order:
            e = p.entities[i]
            if e.parent:
                m.setdefault(e.parent, []).append(e)
        _kids_cache[key] = m
    return m.get(ent.id, [])


def loadavg():
    try:
        return os.getloadavg()[0]
    except (OSError, AttributeError):
        return 0.0


class Sched(object):
    """Everything tick/headline/render need, computed once."""

    def __init__(self, p):
        self.p = p
        caps = p.caps
        self.caps = caps
        self.ncpu = os.cpu_count() or 1
        self.budget = p.cpu_points * self.ncpu
        self.load = loadavg()
        self.load_limit = p.load_gate * self.ncpu
        self.load_ok = self.load <= self.load_limit

        L = lanes(p)
        self.running = [e for e in L if e.state == "running"]
        self.ready = [e for e in L if is_ready(p, e)]
        self.class_count = dict((c, 0) for c in CLASSES)
        self.lock_count = {}
        self.cpu_used = 0.0
        for e in self.running:
            if e.cls in self.class_count:
                self.class_count[e.cls] += 1
            self.cpu_used += e.pts
            lk = e.get("lock", "")
            if lk:
                self.lock_count[lk] = self.lock_count.get(lk, 0) + 1
        self.global_used = len(self.running)

        self.dispatchable = [e for e in self.ready
                             if e.cls in CLASSES and e.get("exit", "")]
        disp = set(id(e) for e in self.dispatchable)
        self.unauthored = [e for e in self.ready if id(e) not in disp]
        self.orders = []
        self.capwait = []     # ready, gated by capacity — the legitimate residue
        self.capwait_why = {}  # id -> the gate that actually refused it
        self.debt = []        # ready, passes every gate, not dispatched
        self.held = []        # ready, but the phase/INTENT-DRIFT lock is shut
        self.compute_orders()

    # -- §3.3 dispatch order -------------------------------------------
    def sort_key(self, e):
        p = self.p
        rework = 0 if re.search(r"-(FIX|REWORK|RE-REVIEW|REMERGE)$", e.id) \
            else 1
        scarcity = self.caps.get(e.cls, 99)
        chain = -longest_chain(p, e.id)
        dependents = -len(direct_dependents(p, e.id))
        try:
            prio = int(e.get("priority", "100"))
        except ValueError:
            prio = 100
        age = p_age(p, e.id)
        return (rework, scarcity, chain, dependents, prio, age, e.id)

    def gate_block(self, e, cc, cpu, glob, locks):
        """The gate that actually refused this item, in the order §3.3 applies
        them.  The renderer must be able to name it: printing "the suite pool
        is full" beside a grid reading `suite 0/3` is the page telling a lie
        it could have checked."""
        if not self.load_ok:
            return ("the host load gate — 1-min loadavg %.1f against a limit "
                    "of %.1f" % (self.load, self.load_limit))
        if glob >= self.caps["global"]:
            return ("the global lane cap — %d of %d already running"
                    % (glob, self.caps["global"]))
        if cc.get(e.cls, 0) >= self.caps.get(e.cls, 0):
            return ("the %s pool — %d of %d in use"
                    % (e.cls or "?", cc.get(e.cls, 0),
                       self.caps.get(e.cls, 0)))
        if cpu + e.pts > self.budget + 1e-9:
            return ("the cpu-point budget — %s of %s spent, this lane costs %s"
                    % (fmt_num(cpu), fmt_num(self.budget), fmt_num(e.pts)))
        lk = e.get("lock", "")
        if lk and locks.get(lk, 0) >= 1:
            return "the exclusive %s lock, already held" % lk
        return ""

    def gates_ok(self, e, cc, cpu, glob, locks):
        return not self.gate_block(e, cc, cpu, glob, locks)

    def compute_orders(self):
        p = self.p
        cand = sorted(self.dispatchable, key=self.sort_key)
        cc = dict(self.class_count)
        locks = dict(self.lock_count)
        cpu = self.cpu_used
        glob = self.global_used
        drift = intent_drift(p)
        allowed = (p.phase == "cockpit") and not drift
        for e in cand:
            why = self.gate_block(e, cc, cpu, glob, locks)
            if not why:
                if allowed:
                    self.orders.append(e)
                    cc[e.cls] = cc.get(e.cls, 0) + 1
                    cpu += e.pts
                    glob += 1
                    lk = e.get("lock", "")
                    if lk:
                        locks[lk] = locks.get(lk, 0) + 1
                else:
                    # §3.5: REFILL-DEBT counts only items that pass EVERY gate.
                    # The draft phase and INTENT-DRIFT are gates, so these are
                    # neither debt (no dispatch is possible, and INV-2 would be
                    # unsatisfiable) nor capacity residue.  They are held.
                    self.held.append(e)
            else:
                self.capwait.append(e)
                self.capwait_why[e.id] = why

    # -- reporting -----------------------------------------------------
    def refill_debt(self, after_dispatch):
        """§3.5 REFILL-DEBT counts only items that pass EVERY gate right now.
        After tick has issued its orders they are no longer debt."""
        if after_dispatch:
            return len(self.debt)
        return len(self.debt) + len(self.orders)

    def class_line(self):
        cc = self.class_count
        caps = self.caps
        # CHOICE(§3.5): the class order and the position of the CAP token are
        # taken verbatim from the spec's only rendering of this line.
        segs = ["CLASS node %d/%d" % (cc["node"], caps["node"]),
                "suite %d/%d" % (cc["suite"], caps["suite"]),
                "sql %d/%d %s" % (cc["sql"], caps["sql"],
                                  "CAP-OK" if not self.capwait
                                  else "CAP-WAIT(%d)" % len(self.capwait)),
                "analysis %d/%d" % (cc["analysis"], caps["analysis"]),
                "cpu %.1f/%.1f" % (self.cpu_used, self.budget),
                "load %.1f/%.1f %s" % (self.load, self.load_limit,
                                       "OK" if self.load_ok else "HIGH")]
        return SEP.join(segs)


_chain_memo = {}


def reset_caches():
    """Every derived cache in this file is keyed by id(plan), which CPython
    reuses once an object is freed.  One plan per process makes that safe; a
    server does not, so it clears them between requests."""
    for c in (_chain_memo, _age_cache, _drift_memo, _dep_cache, _ev_cache,
              _kids_cache, _href_memo, _prov_memo, _transition_memo):
        c.clear()


def direct_dependents(p, eid):
    key = ("dep", id(p))
    cache = _chain_memo.get(key)
    if cache is None:
        cache = {}
        for i in p.order:
            e = p.entities[i]
            for nid in e.needs:
                cache.setdefault(nid, []).append(e.id)
        _chain_memo[key] = cache
    return cache.get(eid, [])


def longest_chain(p, eid):
    """§3.3 order key 3.  Iterative: a 10k-line plan must not need stack."""
    key = ("chain", id(p))
    memo = _chain_memo.setdefault(key, {})
    if eid in memo:
        return memo[eid]
    stack = [(eid, 0)]
    onpath = set()
    while stack:
        node, phase = stack[-1]
        if phase == 0:
            if node in memo:
                stack.pop()
                continue
            if node in onpath:          # cycle — contributes nothing
                memo[node] = 0
                stack.pop()
                continue
            onpath.add(node)
            stack[-1] = (node, 1)
            for d in direct_dependents(p, node):
                if d not in memo:
                    stack.append((d, 0))
        else:
            stack.pop()
            onpath.discard(node)
            best = 0
            for d in direct_dependents(p, node):
                best = max(best, 1 + memo.get(d, 0))
            memo[node] = best
    return memo.get(eid, 0)


_age_cache = {}


def p_age(p, eid):
    """§3.3 tiebreak 'aging': the earliest log.md mention of the id.
    CHOICE(§3.3): the spec does not say where age comes from; item lines may
    not carry hand-typed dates (§6.6), so log.md is the only honest source."""
    key = id(p)
    cache = _age_cache.get(key)
    if cache is None:
        cache = {}
        try:
            with open(p.log_md, "r", encoding="utf-8") as fh:
                for line in fh:
                    m = LOG_RE.match(line.rstrip("\n"))
                    if not m:
                        continue
                    ts = parse_iso(m.group(1))
                    if ts is None:
                        continue
                    for word in re.findall(r"\b[A-Z]{1,2}-[A-Z0-9-]+", line):
                        if word not in cache:
                            cache[word] = ts
        except IOError:
            pass
        _age_cache[key] = cache
    return cache.get(eid, 1 << 62)


_drift_memo = {}


def intent_drift(p):
    """§2.1 signed: — mismatch is INTENT-DRIFT."""
    if p.phase != "cockpit":
        return False
    key = id(p)
    if key in _drift_memo:
        return _drift_memo[key]
    signed = p.front.get("signed", "")
    out = True
    if signed:
        try:
            with open(p.intent_md, "rb") as fh:
                out = sha_hex(fh.read())[:16] != signed
        except IOError:
            out = True
    _drift_memo[key] = out
    return out


# -- needed actions (§5 headline) -------------------------------------

def needed_actions(p, sched):
    """Priority (§5): re-sign -> rule -> accept -> review."""
    out = []
    if intent_drift(p):
        out.append(("re-sign", "intent", "intent.md changed since sign-off"))
    # §5: decisions *blocking ready work* — i.e. the ruling is the only thing
    # standing between an open item and readiness.  A decision on an item that
    # is blocked for other reasons too would not unblock anything, so it does
    # not claim the owner's attention yet.
    blocking = set()
    for e in lanes(p):
        if e.state != "open" or e.is_micro:
            continue
        unmet = blocked_by(p, e)
        for nid in unmet:
            t = p.entities.get(nid)
            if t is None or t.type != "Decision" or t.state == "ruled":
                continue
            others = [x for x in unmet if x != nid]
            if not others:
                blocking.add(nid)
    dec = sorted(blocking)
    specs = [d for d in dec if d.startswith("D-SPEC-")]
    plain = [d for d in dec if not d.startswith("D-SPEC-")]
    for d in plain:
        out.append(("rule", d, p.entities[d].title))
    # then blocker flags you own (§5)
    owner = p.owner
    for i in p.order:
        e = p.entities[i]
        if e.type == "Flag" and e.state != "cleared" and \
                e.get("severity") == "blocker":
            fowner = e.get("owner", "")
            if fowner and fowner != owner:
                continue
            out.append(("rule", e.id, e.title))
    # NOTES.md §5: the owed `reopen_when:` becomes a queue item.  `check`
    # already demands the sentence, and `decide --reopen-when` wears the owner
    # lock, so it is a thing that waits on him and on nobody else — the R-1
    # test for belonging here.  Until it was a row, the standard obliged a
    # sentence only he could author and told him so in a place he does not
    # read, with nowhere to write it.
    for i in p.order:
        e = p.entities[i]
        if e.type == "Decision" and e.state == "ruled" \
                and not e.get("reopen_when", "").strip():
            out.append(("write", e.id, e.title))
    for e in lanes(p) + [p.entities[i] for i in p.order
                         if p.entities[i].type == "Feature"]:
        if e.state == "verified":
            out.append(("accept", e.id, e.title))
    for d in specs:
        out.append(("review", d, p.entities[d].title))
    # unruled D-SPEC stubs that block nothing still need review
    for i in p.order:
        e = p.entities[i]
        if e.type == "Decision" and e.id.startswith("D-SPEC-") and \
                e.state != "ruled" and e.id not in specs:
            out.append(("review", e.id, e.title))
    seen = set()
    dedup = []
    for a in out:
        if a[1] in seen:
            continue
        seen.add(a[1])
        dedup.append(a)
    return dedup


def fact_summary(p):
    now = time.time()
    oldest = None
    unconf = 0
    for f in p.facts.values():
        if f.status == "unconf":
            unconf += 1
            continue
        ts = parse_iso(f.ts)
        if ts is None:
            continue
        if oldest is None or ts < oldest:
            oldest = ts
    if oldest is None:
        core = "facts none"
    else:
        core = "facts " + fmt_age(now - oldest)
    if unconf:
        core += ", %d unconf" % unconf
    return core


def headline(p, sched, after_dispatch=False, actions=None):
    if actions is None:
        actions = needed_actions(p, sched)
    if not actions:
        verdict = "CLEAR"
    else:
        shown = actions[:3]
        verdict = "NEEDED(%d): " % len(actions) + \
            "; ".join("%s %s" % (a[0], a[1]) for a in shown)
        if len(actions) > 3:
            verdict += " +%d more" % (len(actions) - 3)
    debt = sched.refill_debt(after_dispatch)
    lane_seg = "run %d/%d ready %d" % (sched.global_used,
                                       sched.caps["global"], len(sched.ready))
    if debt:
        lane_seg += " REFILL-DEBT(%d)" % debt
    blockers = warns = 0
    for i in p.order:
        e = p.entities[i]
        if e.type == "Flag" and e.state != "cleared":
            if e.get("severity") == "blocker":
                blockers += 1
            elif e.get("severity") == "warn":
                warns += 1
    flag_seg = "flags %d! %d~" % (blockers, warns)
    return SEP.join([verdict, lane_seg, flag_seg, fact_summary(p)])


# ---------------------------------------------------------------------------
# 7. Probes and refresh (§2.6, §2.7)
# ---------------------------------------------------------------------------

def probe_sources(p, probe):
    import glob as globmod
    pat = probe.source
    if not os.path.isabs(pat):
        pat = os.path.join(p.repo_root, pat)
    hits = [h for h in globmod.glob(pat) if os.path.isfile(h)]
    hits.sort(key=lambda h: os.path.getmtime(h), reverse=True)
    return hits


def run_probe(p, probe):
    """Return (ok, value).  Never executes anything (§2.6)."""
    hits = probe_sources(p, probe)
    if not hits:
        return False, ""
    path = hits[0]
    ext = probe.extractor
    try:
        if ext == "exists":
            return True, "present"
        if ext == "sha256":
            with open(path, "rb") as fh:
                # §2.1 signs with the first 16 hex; the meta probe mirrors it.
                return True, sha_hex(fh.read())[:16]
        if ext == "trx":
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                data = fh.read()
            m = re.search(r"<Counters\b[^>]*", data)
            if not m:
                return False, ""
            blob = m.group(0)
            passed = re.search(r'passed="(\d+)"', blob)
            failed = re.search(r'failed="(\d+)"', blob)
            if not passed:
                return False, ""
            return True, "%s passed / %s failed" % (
                passed.group(1), failed.group(1) if failed else "0")
        if ext == "junit":
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                data = fh.read()
            tests = sum(int(x) for x in re.findall(r'\btests="(\d+)"', data))
            fails = sum(int(x) for x in re.findall(r'\bfailures="(\d+)"', data))
            errs = sum(int(x) for x in re.findall(r'\berrors="(\d+)"', data))
            if tests == 0 and not re.search(r"<testsuite", data):
                return False, ""
            bad = fails + errs
            return True, "%d passed / %d failed" % (tests - bad, bad)
        if ext.startswith("contains:"):
            lit = ext[len("contains:"):]
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    if lit in line:
                        return True, "present"
            return False, ""
        if ext.startswith("regex:"):
            rx = re.compile(ext[len("regex:"):])
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    m = rx.search(line)
                    if m:
                        return True, (m.group(1) if m.groups() else "present")
            return False, ""
        if ext.startswith("json:"):
            import json
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                doc = json.load(fh)
            cur = doc
            path_expr = ext[len("json:"):]
            for part in re.findall(r"[^.\[\]$]+|\[\d+\]", path_expr):
                if part.startswith("["):
                    cur = cur[int(part[1:-1])]
                else:
                    cur = cur[part]
            if isinstance(cur, (dict, list)):
                return False, ""
            return True, str(cur)
    except (IOError, OSError, ValueError, KeyError, IndexError, TypeError,
            re.error):
        return False, ""
    return False, ""


def read_stamps(p):
    last = {}
    try:
        with open(p.stamps, "r", encoding="utf-8") as fh:
            for line in fh:
                parts = line.split()
                if len(parts) == 4:
                    last[parts[1]] = (parts[0], parts[2], parts[3])
    except IOError:
        pass
    return last


def write_span(p, fact, ts, status, content):
    """Touch only the inside of the span (§1.2) — the open marker's timestamp
    and status, and the content between the markers.  Never the prose around
    them."""
    line = p.lines[fact.line]
    head = line[:fact.col]
    # Rebuild *this* span's open marker with the new timestamp/status.  A line
    # may carry several spans (§2.5 sets no limit), so the marker to replace is
    # the one ending exactly at fact.col — searching from the left would find
    # an earlier sibling's marker and swallow its whole span.
    m = None
    for cand in FACT_OPEN_RE.finditer(head):
        if cand.end() == fact.col:
            m = cand
    if m is None:                       # offsets no longer describe the line
        return
    head = head[:m.start()] + "<!--fact %s %s %s-->" % (fact.key, ts, status)
    tail = p.lines[fact.end_line][fact.end_col:]
    flat = content.replace("\n", "; ")
    new = head + flat + tail
    if fact.end_line > fact.line:
        # A multi-line span collapses to one line: its interior is machine
        # territory, so there is no authored text in there to preserve.
        p.lines[fact.line:fact.end_line + 1] = [new]
    else:
        p.lines[fact.line] = new


def cmd_refresh(p, args):
    stamps = read_stamps(p)
    unconf = 0
    stamp_lines = []
    ts = now_iso()
    results = {}
    for key in sorted(p.facts.keys()):
        fact = p.facts[key]
        probe = p.probes.get(key)
        if probe is None:
            continue                      # check reports this as an error
        ok, value = run_probe(p, probe)
        prev = stamps.get(key)
        cur_sha = sha_hex(fact.content)[:8]
        if prev and prev[2] != "00000000" and prev[2] != cur_sha:
            # §2.5: inside a span is machine territory; a differing value means
            # a human typed in there.  Overwrite and say so.
            p.log("fact %s: hand edit overwritten" % key)
            print("fact %s: hand edit overwritten" % key)
        if ok:
            results[key] = ("ok", value)
            stamp_lines.append("%s %s ok %s" % (ts, key, sha_hex(value)[:8]))
        else:
            # §2.5 retain-and-mark: never blank a value
            unconf += 1
            results[key] = ("unconf", fact.content)
            stamp_lines.append("%s %s unconf 00000000" % (ts, key))
    # Rewrite bottom-up, and right-to-left within a line, so every span's
    # recorded offsets still describe the line when its turn comes.
    for key in sorted(results, key=lambda k: (-p.facts[k].line,
                                              -p.facts[k].col)):
        status, value = results[key]
        write_span(p, p.facts[key], ts, status, value)
    if stamp_lines:
        with open(p.stamps, "a", encoding="utf-8", newline="\n") as fh:
            fh.write("\n".join(stamp_lines) + "\n")
    p.write_plan()
    p.log("refreshed %d fact spans, %d unconfirmed" % (len(stamp_lines),
                                                       unconf))
    print("refreshed %d fact span(s)%s" %
          (len(stamp_lines), (", %d unconfirmed" % unconf) if unconf else ""))
    return EX_UNCONF if unconf else EX_OK


def cmd_compact(p, args):
    """§2.7: last-per-key + 90 days.  Explicit, never automatic."""
    try:
        with open(p.stamps, "r", encoding="utf-8") as fh:
            rows = [l.rstrip("\n") for l in fh if l.strip()]
    except IOError:
        print("no stamps.log")
        return EX_OK
    cutoff = time.time() - 90 * 86400
    keep_idx = set()
    last_for = {}
    for i, row in enumerate(rows):
        parts = row.split()
        if len(parts) != 4:
            continue
        ts = parse_iso(parts[0])
        last_for[parts[1]] = i
        if ts is not None and ts >= cutoff:
            keep_idx.add(i)
    keep_idx.update(last_for.values())
    kept = [rows[i] for i in sorted(keep_idx)]
    write_atomic(p.stamps, "\n".join(kept) + ("\n" if kept else ""))
    p.log("compacted stamps.log %d -> %d rows" % (len(rows), len(kept)))
    print("stamps.log %d -> %d rows" % (len(rows), len(kept)))
    return EX_OK


# ---------------------------------------------------------------------------
# 8. intent.md parsing (§2.8)
# ---------------------------------------------------------------------------

class Intent(object):
    def __init__(self):
        self.objective = []
        self.constraints = []      # (id, text, fields, line)
        self.rejected = []
        self.amendments = []
        self.diags = []
        self.lines = []


def load_intent(p):
    it = Intent()
    try:
        with open(p.intent_md, "r", encoding="utf-8") as fh:
            it.lines = fh.read().split("\n")
    except IOError:
        return it
    section = ""
    cur = None
    in_amendment = False
    fence = None
    relpath = rel(p.intent_md, p.repo_root)

    def err(i, rule, msg):
        it.diags.append(Diag(relpath, i + 1, "error", rule, msg))

    def warn(i, rule, msg):
        it.diags.append(Diag(relpath, i + 1, "warn", rule, msg))

    for i, raw in enumerate(it.lines):
        s = raw.strip()
        if fence is None and (s.startswith("```") or s.startswith("~~~")):
            fence = s[:3]
            continue
        if fence is not None:
            if s.startswith(fence):
                fence = None
            continue
        if s.startswith("## "):
            section = s[3:].strip().lower()
            cur = None
            in_amendment = False
            continue
        if s.startswith("### "):
            if section.startswith("amendment"):
                in_amendment = True
                it.amendments.append((i, s))
                m = re.search(r"tier\s+(\d)", s)
                if not m:
                    err(i, "E-AMEND-TIER",
                        "amendment heading has no `tier <1|2|3>`")
                else:
                    it.amendments[-1] = (i, s)
            cur = None
            continue
        if "~~" in raw and not in_amendment:
            # §2.8: strikethrough is a reserved signal
            err(i, "E-STRIKE-INTENT",
                "`~~` outside an amendment block " + EMDASH +
                " strikethrough is a reserved signal")
        m = re.match(r"^-\s+(C\d+|R\d+):\s*(.*)$", s)
        if m:
            cur = {"id": m.group(1), "text": m.group(2), "line": i,
                   "fields": {}, "last": None}
            if m.group(1)[0] == "C":
                it.constraints.append(cur)
            else:
                it.rejected.append(cur)
            continue
        if cur is not None:
            mf = re.match(r"^([a-z_]+):\s*(.*)$", s)
            if mf and mf.group(1) not in INTENT_FIELDS:
                # §2.8 names the sub-fields; a wrapped sentence that happens to
                # open with `word:` ("already: a chain that cannot replay…") is
                # prose, not a new field, and truncating there loses the half
                # of the reason that carries the evidence.
                mf = None
            if mf:
                cur["fields"][mf.group(1)] = mf.group(2)
                cur["last"] = mf.group(1)
                continue
            if s == "":
                cur = None
                continue
            # A wrapped line belongs to whatever it wraps.  Without this every
            # reason longer than one line is silently cut mid-sentence — in the
            # brief that quotes it VERBATIM (§2.10) and on the page that shows
            # the WHY layer.  Nothing else in the file changes meaning.
            last = cur.get("last")
            if last:
                cur["fields"][last] = (cur["fields"][last] + " " + s).strip()
            else:
                cur["text"] = (cur["text"] + " " + s).strip()
            continue
        if section == "objective" and s and not s.startswith("#"):
            it.objective.append(s)
    for c in it.constraints:
        for req in ("holds_because", "violated_when"):
            if req not in c["fields"]:
                err(c["line"], "E-CONSTRAINT",
                    "%s: missing required `%s:` " % (c["id"], req) + EMDASH +
                    " a constraint without a symptom is decoration")
    for r in it.rejected:
        if "reopen_when" not in r["fields"]:
            warn(r["line"], "W-REJECTED",
                 "%s: missing `reopen_when:`" % r["id"])
    return it


# ---------------------------------------------------------------------------
# 9. Briefs (§2.10)
# ---------------------------------------------------------------------------

def brief_body(p, it, lane):
    out = []
    out.append("# Brief " + EMDASH + " %s" % lane.id)
    out.append("")
    out.append("export PLAN_ACTOR=agent:%s" % lane.id)
    out.append("")
    out.append("## Objective")
    out.append(lane.title)
    if lane.kind == "block":
        prose = [p.lines[i] for i in lane.prose]
        while prose and not prose[0].strip():
            prose.pop(0)
        while prose and not prose[-1].strip():
            prose.pop()
        if prose:
            out.append("")
            out.extend(prose)
    out.append("")
    out.append("## Exit criteria")
    out.append(lane.get("exit", "(none declared)"))
    out.append("")
    out.append("## Constraints in force")
    if not it.constraints:
        out.append("(intent.md declares none)")
    for c in it.constraints:
        out.append("- %s: %s" % (c["id"], c["text"]))
        for k in ("holds_because", "violated_when"):
            if k in c["fields"]:
                out.append("  %s: %s" % (k, c["fields"][k]))
    out.append("")
    out.append("## Resources")
    caps = p.caps
    out.append("class: %s " % lane.cls + MDOT + " pts: %s " % fmt_num(lane.pts)
               + MDOT + " workdir: %s" % lane.get("dir", "lanes/%s/" % lane.id))
    out.append("caps in force: " + " ".join(
        "%s=%d" % (c, caps[c]) for c in CLASSES + ["global"]))
    lk = lane.get("lock", "")
    if lk:
        out.append("exclusive lock: %s (cap 1)" % lk)
    if lane.needs:
        out.append("needs: %s" % ", ".join(lane.needs))
    out.append("")
    out.append("## Boundaries")
    out.append("You may not run `plan accept` or `plan decide`.")
    out.append("You may not edit docs/plan/** except your RETURN.")
    out.append("If the brief contradicts reality, stop and return verdict "
               "fail-spec " + EMDASH + " do not improvise.")
    out.append("All writes under your lane directory or your own worktree. "
               "Never a shared scratch path.")
    out.append("At most 2 children; your entire subtree runs at most 1 test "
               "suite at a time.")
    out.append("Never start a container unless your brief grants the slot; "
               "never touch containers you did not create.")
    out.append("If a resource is busy, return `blocked` immediately; never "
               "spin-wait.")
    out.append("Return a " + "≤" + "15-line summary plus evidence "
               "pointers; full detail goes in your lane directory.")
    out.append("")
    return "\n".join(out)


def brief_text(p, it, lane):
    body = brief_body(p, it, lane)
    bhash = sha_hex(body)[:8]
    ihash = intent_hash(p)
    header = ("<!-- GENERATED brief %s for %s " + MDOT + " intent %s " + MDOT +
              " %s -->") % (bhash, lane.id, ihash, now_iso())
    tail = []
    tail.append("## Return protocol")
    tail.append("Write this block to docs/plan/returns/%s-<n>.md and hand it "
                "back:" % lane.id)
    tail.append("")
    tail.append("```")
    tail.append("RETURN: %s" % lane.id)
    tail.append("brief: %s" % bhash)
    tail.append("verdict: built | fail-spec | blocked | aborted")
    tail.append("evidence: <path or fact:key>        # required for built")
    tail.append("spec_gap: <brief sentence, contradicted by what observation>"
                "  # required for fail-spec")
    tail.append("needs: +<ID>                        # required for blocked")
    tail.append("reason: <what stopped>              # required for aborted")
    tail.append("log: <" + "≤" + "15 lines>")
    tail.append("END RETURN")
    tail.append("```")
    return header + "\n" + body + "\n".join(tail) + "\n", bhash


def intent_hash(p):
    try:
        with open(p.intent_md, "rb") as fh:
            return sha_hex(fh.read())[:16]
    except IOError:
        return "0" * 16


def write_briefs(p, it, targets):
    """§1.1: briefs are regenerated *per dispatch*.  The targets are the lanes
    dispatched in this tick plus the lanes already running (whose brief must
    stay on disk for the operator and for RETURN hash comparison).  Only
    rewrites when the body hash changed, so mtimes stay honest."""
    if not os.path.isdir(p.briefs):
        os.makedirs(p.briefs)
    written = {}
    seen = set()
    for lane in targets:
        if lane.id in seen:
            continue
        seen.add(lane.id)
        if not lane.cls or not lane.get("exit", ""):
            continue
        text, bhash = brief_text(p, it, lane)
        path = os.path.join(p.briefs, "%s.md" % lane.id)
        old = None
        if os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8") as fh:
                    old = fh.read()
            except IOError:
                old = None
        if old is None or old.split("\n", 1)[1:] != text.split("\n", 1)[1:]:
            write_atomic(path, text)
        written[lane.id] = bhash
    return written


def brief_hash_of(p, it, lane_id):
    lane = p.entities.get(lane_id)
    if lane is None:
        return None
    _, bhash = brief_text(p, it, lane)
    return bhash


# ---------------------------------------------------------------------------
# 10. Mutations — line-precise writes only (§1.2)
# ---------------------------------------------------------------------------

def set_block_field(p, ent, key, value):
    line = "%s: %s" % (key, value)
    if key in ent.field_lines:
        idx = ent.field_lines[key]
        p.lines[idx] = line
        return idx
    # insert after the last existing field line, else right after the heading
    if ent.field_lines:
        idx = max(ent.field_lines.values()) + 1
    else:
        idx = ent.line + 1
    p.lines.insert(idx, line)
    shift(p, idx, 1)
    ent.field_lines[key] = idx
    ent.fields[key] = value
    return idx


def shift(p, at, delta):
    for e in p.entities.values():
        if e.line >= at:
            e.line += delta
        if e.block_end >= at:
            e.block_end += delta
        for k in list(e.field_lines):
            if e.field_lines[k] >= at:
                e.field_lines[k] += delta
        e.prose = [x + delta if x >= at else x for x in e.prose]
    for f in p.facts.values():
        if f.line >= at:
            f.line += delta
        if f.end_line >= at:
            f.end_line += delta


def set_token(p, ent, key, value):
    line = p.lines[ent.line]
    if " " in value or MDOT in value:
        value = '"%s"' % value
    parts = split_tokens(line)
    for i in range(1, len(parts)):
        if parts[i].strip().startswith(key + ":"):
            parts[i] = "%s:%s" % (key, value)
            p.lines[ent.line] = SEP.join(parts)
            ent.fields[key] = unquote(value)
            return
    p.lines[ent.line] = line + SEP + "%s:%s" % (key, value)
    ent.fields[key] = unquote(value)


def set_state(p, ent, state):
    if ent.kind == "item":
        line = p.lines[ent.line]
        i = line.index("- [")
        p.lines[ent.line] = line[:i + 3] + STATE_CHAR[state] + line[i + 4:]
    else:
        set_block_field(p, ent, "state", state)
    ent.state = state


def set_evidence(p, ent, evidence):
    if not evidence:
        return drop_field(p, ent, "evidence")
    if ent.kind == "item":
        set_token(p, ent, "evidence", evidence)
    else:
        set_block_field(p, ent, "evidence", evidence)


def drop_field(p, ent, key):
    """Remove a field/token entirely.  Blanking it would leave `evidence:` with
    nothing after the colon, which reads as a claim with the content lost
    rather than as a claim withdrawn."""
    if key not in ent.fields:
        return
    if ent.kind == "item":
        parts = split_tokens(p.lines[ent.line])
        parts = [parts[0]] + [t for t in parts[1:]
                              if not t.strip().startswith(key + ":")]
        p.lines[ent.line] = SEP.join(parts)
    else:
        idx = ent.field_lines.pop(key)
        del p.lines[idx]
        shift(p, idx, -1)
    ent.fields.pop(key, None)


def strike_title(p, ent):
    """§2.3: a [~] line must keep its title struck."""
    if ent.kind == "item":
        line = p.lines[ent.line]
        parts = split_tokens(line)
        head = parts[0]
        idx = head.find(ent.id)
        if idx < 0:
            return
        pre = head[:idx + len(ent.id)]
        title = head[idx + len(ent.id):].strip()
        if title and not title.startswith("~~"):
            parts[0] = pre + " ~~" + title + "~~"
            p.lines[ent.line] = SEP.join(parts)
    else:
        line = p.lines[ent.line]
        idx = line.find(ent.title)
        if idx >= 0 and not ent.title.startswith("~~"):
            p.lines[ent.line] = line[:idx] + "~~" + ent.title + "~~"


def read_stdin():
    """NOTES.md §2: no `--text` means the note is on stdin, read to EOF.  A
    *quoted* heredoc (`<<'PLAN_NOTE'`) is the one shell form that interprets
    nothing at all — apostrophes, $vars, backticks and newlines arrive inert —
    so the owner's words need no escaping and lose nothing."""
    try:
        return sys.stdin.read()
    except (IOError, ValueError):
        return ""


def normalise_eol(s):
    """CRLF and lone CR to LF.  plan.md is written by `"\n".join`, so a stray
    carriage return would land inside an authored line and stay there."""
    return s.replace("\r\n", "\n").replace("\r", "\n")


def heredoc_delim(text, base="PLAN_NOTE"):
    """The delimiter for a quoted heredoc carrying `text`.  The only body a
    quoted heredoc cannot carry is one containing a line equal to its own
    delimiter, so the composer walks a deterministic sequence — PLAN_NOTE,
    PLAN_NOTE_2, PLAN_NOTE_3 — rather than escaping, truncating or refusing
    the owner's words."""
    rows = normalise_eol(text).split("\n")
    delim, k = base, 1
    while delim in rows:
        k += 1
        delim = "%s_%d" % (base, k)
    return delim


def heredoc_cmd(prefix, text, base="PLAN_NOTE"):
    """`<command> <<'DELIM'` + body + `DELIM` — the paste-able form.  The
    static page's basket and the served composer both emit this shape."""
    delim = heredoc_delim(text, base)
    return "%s <<'%s'\n%s\n%s" % (prefix, delim,
                                    normalise_eol(text).strip("\n"), delim)


def note_utterance(p, eid, text):
    """The whole `plan note` command for one entity, ready to paste."""
    return heredoc_cmd("plan note %s --by %s" % (eid, p.owner or "@owner"),
                       text)


def reopen_utterance(p, eid, text):
    """The owed `reopen_when:` sentence, composed the same way.  `-` reads the
    body on stdin, so the condition survives whatever it contains, and the
    verb joins it into the one line a field is."""
    return heredoc_cmd("plan decide %s --reopen-when - --by %s"
                       % (eid, p.owner or "@owner"), text)


def flag_utterance(eid, severity, title, clears_when):
    """`flag add`'s stdin form: the plan's own field grammar, one line each.
    Both values are collapsed here for the same reason `serve_run` collapses
    them — a newline inside a value would otherwise write a second field."""
    body = "title: %s\nclears_when: %s" % (" ".join(str(title).split()),
                                           " ".join(str(clears_when).split()))
    return heredoc_cmd("plan flag add %s --severity %s" % (eid, severity),
                       body)


def note_lines(actor, date, target, text):
    """The note as whole lines.  Every line keeps the `"> "` prefix, and that
    prefix is the firewall (NOTES.md §4): no note line can parse as a heading,
    an item, a field or a fence, whatever the owner wrote.

    `text` arrives normalised: `cmd_note` does that once, at the boundary."""
    rows = text.strip("\n").split("\n")
    out = ["> " + actor + SEP + date + SEP + target + " " + EMDASH + " " +
           rows[0]]
    for row in rows[1:]:
        out.append("> " + row if row.strip() else ">")
    return out


def _span_open_after(raw, is_open):
    """Fact-span state after this line.  A second, deliberate walk: §2.5 lets
    spans run across lines and sit two to a line, and an insertion point that
    cannot see them is the two-spans-one-line corruption waiting to happen."""
    pos = 0
    while True:
        if is_open:
            end = raw.find(FACT_CLOSE, pos)
            if end < 0:
                return True
            pos = end + len(FACT_CLOSE)
            is_open = False
        else:
            m = FACT_OPEN_RE.search(raw, pos)
            if m is None:
                return False
            pos = m.end()
            is_open = True


def note_region(p, ent):
    """[first, last] — the lines a note on `ent` may be appended after.

    A block entity owns its block.  An item-line entity owns its own line plus
    the paragraph adjacent to it: its micro-items (splitting that list would
    break the bullet run for a reader and gain nothing, since attachment is by
    id) and any notes already standing there, so successive notes append in
    the order they were written."""
    if ent.kind == "block":
        return ent.line, min(ent.block_end, len(p.lines) - 1)
    n = len(p.lines)
    end = ent.line
    i = ent.line + 1
    while i < n:
        raw = p.lines[i]
        if not raw.strip():
            i += 1
            continue
        if raw[:1] == ">":
            end, i = i, i + 1
            continue
        m = ITEM_RE.match(raw.rstrip())
        if m is not None:
            mm = MICRO_RE.match(m.group(3))
            if mm is not None and mm.group(1) == ent.id:
                end, i = i, i + 1
                continue
        break
    return ent.line, end


def note_insert_point(p, ent):
    """The line index a note on `ent` is inserted at.

    NOTES.md §4: the write primitive is whole-line insertion only, never an
    intra-line rewrite, so the walk to the insertion point tracks fence state
    *and* span state and refuses rather than landing inside either.  The
    answer is the line after the last one that is non-blank, fence-closed and
    span-closed."""
    start, end = note_region(p, ent)
    fence = None
    span = False
    at = start
    for i in range(start, end + 1):
        raw = p.lines[i]
        s = raw.strip()
        if fence is None and (s.startswith("```") or s.startswith("~~~")):
            fence = s[:3]
            continue
        if fence is not None:
            if s.startswith(fence):
                fence = None
                at = i
            continue
        span = _span_open_after(raw, span)
        if s and not span:
            at = i
    if fence is not None:
        die(EX_REFUSED, "%s ends inside an unclosed fence " % ent.id + EMDASH +
            " a fence is machine-literal text and a note may not be written "
            "into one; close it first")
    if span:
        die(EX_REFUSED, "%s ends inside an open fact span " % ent.id + EMDASH +
            " span content is machine territory (§2.5)")
    return at + 1


def write_note(p, ent, actor, date, text):
    """Insert the note as whole lines, wrapped so it is its own paragraph.
    `p.lines[at:at] = block` + `shift()` — the same primitive `cmd_return`
    uses for its stubs, and the reason the corruption shape is unreachable."""
    at = note_insert_point(p, ent)
    block = [""] + note_lines(actor, date, ent.id, text)
    if at < len(p.lines) and p.lines[at].strip():
        block.append("")
    p.lines[at:at] = block
    shift(p, at, len(block))
    return at


def parse_field_stdin(text, allowed):
    """`key: value` lines in the plan's own field grammar (NOTES.md §2), with
    §2.11's continuation rule: an indented line continues the value above it,
    joined with a single space, because a field is one line."""
    out = {}
    key = None
    for raw in normalise_eol(text).split("\n"):
        if not raw.strip():
            continue
        if raw[:1] in (" ", "\t") and key is not None:
            out[key] = (out[key] + " " + raw.strip()).strip()
            continue
        m = FIELD_RE.match(raw.strip())
        if m is None:
            die(EX_REFUSED, "stdin is `key: value` lines; this is not one: %s"
                % raw.strip()[:60])
        k, v = m.group(1), m.group(2).strip()
        if k not in allowed:
            die(EX_REFUSED, "`%s:` is not one of %s" % (k, ", ".join(allowed)))
        out[k], key = v, k
    return out


def section_insert_point(p, heading):
    """End of the `## <heading>` section, or EOF if absent (creating it)."""
    start = None
    for i, raw in enumerate(p.lines):
        if raw.strip().lower() == ("## " + heading).lower():
            start = i
            break
    if start is None:
        while p.lines and not p.lines[-1].strip():
            p.lines.pop()
        p.lines.append("")
        p.lines.append("## " + heading)
        p.lines.append("")
        return len(p.lines)
    i = start + 1
    end = len(p.lines)
    while i < len(p.lines):
        if p.lines[i].startswith("## ") or p.lines[i].startswith("# "):
            end = i
            break
        i += 1
    while end > start + 1 and not p.lines[end - 1].strip():
        end -= 1
    return end


# ---------------------------------------------------------------------------
# 11. check (§5)
# ---------------------------------------------------------------------------

def banned_hits(text):
    out = []
    for rx, name in BANNED:
        if rx.search(text):
            out.append(name)
    return out


def cmd_check(p, args):
    it = load_intent(p)
    diags = list(p.diags) + list(it.diags)
    relplan = rel(p.plan_md, p.repo_root)

    def err(line, rule, msg, file=relplan):
        diags.append(Diag(file, line + 1, "error", rule, msg))

    def warn(line, rule, msg, file=relplan):
        diags.append(Diag(file, line + 1, "warn", rule, msg))

    # -- frontmatter --------------------------------------------------
    for key in ("plan", "owner", "phase"):
        if key not in p.front:
            err(0, "E-FM-REQUIRED", "frontmatter is missing required `%s:`"
                % key)
    if "plan" in p.front and not re.match(r"^[a-z0-9-]+$", p.front["plan"]):
        err(p.front_lines.get("plan", 0), "E-FM-SLUG",
            "`plan:` must match [a-z0-9-]+")
    if "owner" in p.front and not HANDLE_RE.match(p.front["owner"]):
        err(p.front_lines.get("owner", 0), "E-FM-OWNER",
            "`owner:` must be an @handle")
    if p.front.get("phase") not in ("draft", "cockpit"):
        err(p.front_lines.get("phase", 0), "E-FM-PHASE",
            "`phase:` must be draft or cockpit")
    if p.phase == "cockpit":
        sig = p.front.get("signed", "")
        if not re.match(r"^[0-9a-f]{16}$", sig or ""):
            err(p.front_lines.get("signed", 0), "E-FM-SIGNED",
                "cockpit phase requires a 16-hex `signed:`")
        elif sig not in signed_hashes(p):
            err(p.front_lines.get("signed", 0), "E-SIGNED-UNWITNESSED",
                "`signed: %s` was never written by `plan sign-off` " % sig +
                EMDASH + " no log line records it; a signature typed into the "
                "frontmatter is a forgery, not a signature")
        elif intent_drift(p):
            err(p.front_lines.get("signed", 0), "E-INTENT-DRIFT",
                "INTENT-DRIFT: intent.md hashes to %s, signed %s "
                % (intent_hash(p), sig) + EMDASH + " re-sign or amend")
    for key in p.front:
        if key not in ("plan", "owner", "phase", "signed", "caps",
                       "cpu_points", "load_gate"):
            warn(p.front_lines.get(key, 0), "W-FM-UNKNOWN",
                 "unknown frontmatter key `%s:` " % key + EMDASH + " preserved")
    for tok in p.front.get("caps", "").split():
        k = tok.split("=", 1)[0]
        if k not in DEFAULT_CAPS:
            warn(p.front_lines.get("caps", 0), "W-CAPS",
                 "unknown cap class `%s` " % k + EMDASH +
                 " the class vocabulary is closed")

    # -- entities ------------------------------------------------------
    for eid in p.order:
        e = p.entities[eid]
        ln = e.line
        if e.type in ("Feature", "Lane") and e.kind == "block":
            if e.raw_state is None:
                err(ln, "E-STATE-REQUIRED",
                    "%s %s: `state:` is required " % (e.type, eid) + EMDASH +
                    " quarantined from scheduling")
            elif e.state is None:
                err(ln, "E-STATE-ILLEGAL",
                    "%s %s: illegal state `%s`" % (e.type, eid, e.raw_state))
        if e.type == "Flag":
            if e.raw_state is not None and e.state is None:
                err(ln, "E-STATE-ILLEGAL",
                    "Flag %s: state must be open|cleared" % eid)
            cw = e.get("clears_when", "")
            if not cw:
                err(ln, "E-FLAG-CLEARS",
                    "Flag %s: `clears_when:` is required " % eid + EMDASH +
                    " a flag without it is a complaint")
            elif "fact:" in cw and clears_when_residue(cw) \
                    and e.state != "cleared":
                # The mixed form only: a prose-only condition is honest about
                # being untestable and already fails closed.  This one reads
                # like a checked condition and is half decoration.
                warn(ln, "W-FLAG-PROSE",
                     "Flag %s: `clears_when` mixes fact references with prose "
                     "the tool cannot test (%s) " % (
                         eid, " ".join(clears_when_residue(cw))) + EMDASH +
                     " clearing it will need the owner")
            sev = e.get("severity", "")
            if sev not in ("info", "warn", "blocker"):
                err(ln, "E-FLAG-SEVERITY",
                    "Flag %s: severity must be info|warn|blocker" % eid)
            if sev == "blocker" and e.state != "cleared" and \
                    not flag_gates_anything(p, eid):
                warn(ln, "W-FLAG-INERT",
                     "Flag %s is `severity: blocker` and nothing needs it " %
                     eid + EMDASH + " it colours the headline and gates no "
                     "lane; add it to a `needs:`/`gate:` or lower the severity")
        if e.type in ("Flag", "Decision") and e.get("for", ""):
            # DESIGN §10-1: `for:` is the authored answer to "which module does
            # this belong to".  It is optional; when it is written it has to
            # name a Feature, or the module block it was meant to reach will
            # silently print nothing.
            tgt = p.entities.get(e.get("for"))
            if tgt is None or tgt.type != "Feature":
                warn(ln, "W-FOR-UNKNOWN",
                     "%s %s: `for: %s` does not name a Feature " %
                     (e.type, eid, e.get("for")) + EMDASH +
                     " the module block will not carry it")
        if e.type == "Decision":
            opts = [o for o in e.get("options", "").split("\n") if o.strip()]
            if len(opts) < 2:
                warn(ln, "W-DECISION-OPTIONS",
                     "Decision %s has %d option(s) " % (eid, len(opts)) +
                     EMDASH + " this is an announcement, not a decision")
            dfl = e.get("default_if_unruled", "")
            if dfl and dfl != "none" and not re.match(
                    r"^\S+ after \d{4}-\d{2}-\d{2}$", dfl):
                err(ln, "E-DECISION-DEFAULT",
                    "`default_if_unruled:` must be `none` or "
                    "`<slug> after <ISO-date>`")
            if e.state == "ruled" and not e.get("reopen_when", ""):
                warn(ln, "W-DECISION-REOPEN",
                     "Decision %s is ruled and owes `reopen_when:`" % eid)
            rec = e.get("recommend", "")
            if rec:
                slugs = [o.strip().lstrip("|").strip().split()[0]
                         for o in opts if o.strip().lstrip("|").strip()]
                head = rec.split()[0] if rec.split() else ""
                if head not in slugs:
                    err(ln, "E-DECISION-RECOMMEND",
                        "Decision %s: `recommend:` names `%s`, which is not "
                        "one of its options (%s)"
                        % (eid, head, ", ".join(slugs)))
                elif EMDASH not in rec and " - " not in rec:
                    warn(ln, "W-DECISION-RECOMMEND",
                         "Decision %s: `recommend:` carries no reasoning "
                         % eid + EMDASH + " write `<slug> " + EMDASH +
                         " why`, or leave it out")
        if e.type == "Stage" and e.kind == "block" and \
                e.raw_state is not None and e.state != "accepted":
            warn(ln, "W-STAGE-STATE",
                 "Stage %s carries a hand-written `state:` " % eid + EMDASH +
                 " tick owns stage state")
        if e.type == "Lane" and not e.is_micro:
            # §2.3: micro-items participate in readiness but are never
            # dispatched and have no briefs, so they owe no class:/exit:.
            if not e.cls:
                err(ln, "E-LANE-CLASS",
                    "Lane %s: `class:` is required " % eid + EMDASH +
                    " quarantined from scheduling")
            elif e.cls not in CLASSES:
                err(ln, "E-LANE-CLASS",
                    "Lane %s: class `%s` is outside the closed vocabulary %s"
                    % (eid, e.cls, "|".join(CLASSES)))
            if not e.get("exit", "") and e.state in ("open", "running"):
                err(ln, "E-LANE-EXIT",
                    "Lane %s: `exit:` is required before dispatch" % eid)
        # needs
        for nid in e.needs:
            t = p.entities.get(nid)
            if t is None:
                err(ln, "E-NEEDS-DANGLING",
                    "%s needs `%s`, which is not defined" % (eid, nid))
            elif t.type == "Horizon" and e.state not in ("retracted",):
                err(ln, "E-HORIZON-NEEDED",
                    "%s needs Horizon %s " % (eid, nid) + EMDASH +
                    " if anything live needs it, it is not a horizon")
        if len(e.needs) > 5:
            warn(ln, "W-NEEDS-LONG",
                 "%s has %d needs " % (eid, len(e.needs)) + EMDASH +
                 " that is a missing Stage")
        # strikethrough (§2.3)
        raw = p.lines[e.line]
        if "~~" in raw and e.state != "retracted":
            err(ln, "E-STRIKE",
                "`~~` on a line whose state is not retracted " + EMDASH +
                " strikethrough means retracted, never completed")
        if e.state == "retracted":
            if "~~" not in raw:
                err(ln, "E-STRIKE-MISSING",
                    "%s is retracted but its title is not struck" % eid)
            if not e.get("retracted", ""):
                err(ln, "E-RETRACT-REASON",
                    "%s is retracted without `retracted: <reason>`" % eid)
        # banned vocabulary (§2.4)
        for name in banned_hits(e.title):
            err(ln, "E-BANNED", "banned vocabulary `%s` in a title" % name)
        if e.raw_state:
            for name in banned_hits(e.raw_state):
                err(ln, "E-BANNED",
                    "banned vocabulary `%s` in a state field" % name)
        # exit criteria quality (§6.1)
        ex = e.get("exit", "")
        if ex:
            m = EXIT_WEASEL.search(ex)
            if m:
                warn(ln, "W-EXIT-WEASEL",
                     "exit criterion says `%s` " % m.group(0) + EMDASH +
                     " name the instrument, not the virtue")
            keys = re.findall(r"fact:([A-Za-z0-9_.-]+)", ex)
            kinds = [p.probes[k].kind for k in keys if k in p.probes]
            has_other = bool(re.search(r"artifacts?/|journey|/", ex)) or \
                any(k != "suite" for k in kinds)
            if kinds and all(k == "suite" for k in kinds) and not has_other:
                warn(ln, "W-EXIT-SUITE-ONLY",
                     "exit rests on suite facts alone " + EMDASH +
                     " guard 1 makes this lane unverifiable")
            if re.search(r"\btests? pass\b", ex, re.I) and not has_other:
                warn(ln, "W-EXIT-SUITE-ONLY",
                     "\"tests pass\" alone is not an exit criterion")
        # §2.4: a state nobody witnessed.  `verified` and `accepted` are the
        # two states a verb writes together with its receipt — evidence on the
        # entity, a line in log.md.  Typing either into plan.md by hand left
        # no trace and check passed, so the load-bearing states were authored
        # rather than earned.  Stages are exempt: tick writes their state and
        # §2.2 says a stage has no facts of its own.
        if e.type in ("Feature", "Lane") and not e.is_micro and \
                e.state in ("verified", "accepted") and \
                not e.get("evidence", "") and \
                not logged_transition(p, eid):
            err(ln, "E-STATE-UNWITNESSED",
                "%s is `%s` with no `evidence:` and no log line recording the "
                "transition " % (eid, e.state) + EMDASH +
                " a state the verbs did not write is an assertion, not a fact")
        # micro-item completeness (§2.3)
        if e.type == "Lane" and e.state in ("built-unverified", "verified",
                                            "accepted"):
            openk = [c.id for c in micro_children(p, e)
                     if c.state in ("open", "running")]
            if openk:
                err(ln, "E-MICRO-OPEN",
                    "%s is %s but micro-items %s are not finished"
                    % (eid, e.state, ", ".join(openk)))

    # -- cycles --------------------------------------------------------
    for cyc in find_cycles(p):
        e = p.entities[cyc[0]]
        err(e.line, "E-CYCLE", "dependency cycle: " + " -> ".join(cyc))

    # -- facts vs probes ----------------------------------------------
    for key, f in p.facts.items():
        if key not in p.probes:
            err(f.line, "E-FACT-NO-PROBE",
                "fact span `%s` has no probe declaring it" % key)
        if parse_iso(f.ts) is None:
            err(f.line, "E-FACT-TS",
                "fact span `%s` has an unparseable timestamp `%s`"
                % (key, f.ts))
    for key, pr in p.probes.items():
        if key not in p.facts:
            warn(pr.line, "W-PROBE-UNUSED",
                 "probe `%s` has no fact span " % key + EMDASH +
                 " it is never rendered")
        if authored_source(pr):
            warn(pr.line, "W-PROBE-PROSE",
                 "probe `%s` reads a prose file (%s) " % (key, pr.source) +
                 EMDASH + " an agent writing a sentence about its own work "
                 "would satisfy it; point it at an artifact a build produced")
    for eid in p.order:
        e = p.entities[eid]
        for k in re.findall(r"fact:([A-Za-z0-9_.-]+)", e.get("exit", "")):
            if k not in p.probes:
                err(e.line, "E-FACT-NO-PROBE",
                    "exit references fact:%s, which no probe declares" % k)

    # -- prose banned vocabulary (warn) --------------------------------
    for i in p.prose_lines:
        for name in banned_hits(p.lines[i]):
            warn(i, "W-BANNED", "banned vocabulary `%s` in prose" % name)
    for eid in p.order:
        e = p.entities[eid]
        for i in e.prose:
            for name in banned_hits(p.lines[i]):
                warn(i, "W-BANNED", "banned vocabulary `%s` in prose" % name)

    # -- notes (NOTES.md §1) -------------------------------------------
    # The one new rule the note grammar owes `check`.  Warn, never error:
    # human prose never blocks, and a note aimed at nothing is still the
    # owner's sentence — it just attaches to nothing and renders as prose.
    for nt in p.notes:
        if nt.target not in p.entities:
            warn(nt.line, "W-NOTE-TARGET",
                 "note names `%s`, which is not an entity in this plan "
                 % nt.target + EMDASH + " it attaches to nothing and renders "
                 "as plain prose")

    # -- log.md --------------------------------------------------------
    diags.extend(check_log(p))
    # -- returns / rework counter (§3.7) -------------------------------
    diags.extend(check_rework(p))
    # -- briefs (§1.2) -------------------------------------------------
    diags.extend(check_briefs(p, it))
    # -- R-1 (§1.4) ----------------------------------------------------
    diags.extend(check_r1(p))

    if args.get("fresh"):
        diags.extend(check_fresh(p))

    diags.sort(key=lambda d: (d.file, d.line))
    for d in diags:
        print(d.render())
    errors = sum(1 for d in diags if d.sev == "error")
    warns = sum(1 for d in diags if d.sev == "warn")
    print("check: %d error(s), %d warning(s)" % (errors, warns))
    LAST_CHECK_RULES.clear()
    LAST_CHECK_RULES.extend(d.rule for d in diags if d.sev == "error")
    return EX_CHECK if errors else EX_OK


def find_cycles(p):
    sys.setrecursionlimit(max(sys.getrecursionlimit(), 20000))
    color = {}
    stack = []
    out = []

    def visit(eid):
        color[eid] = 1
        stack.append(eid)
        e = p.entities.get(eid)
        if e is not None:
            for nid in e.needs:
                if nid not in p.entities:
                    continue
                c = color.get(nid, 0)
                if c == 1:
                    idx = stack.index(nid)
                    out.append(stack[idx:] + [nid])
                elif c == 0:
                    visit(nid)
        stack.pop()
        color[eid] = 2

    for eid in p.order:
        if color.get(eid, 0) == 0:
            visit(eid)
    return out


def check_log(p):
    out = []
    relp = rel(p.log_md, p.repo_root)
    prev = None
    try:
        with open(p.log_md, "r", encoding="utf-8") as fh:
            rows = fh.read().split("\n")
    except IOError:
        return [Diag(relp, 1, "warn", "W-LOG-MISSING", "log.md is missing")]
    for i, raw in enumerate(rows):
        s = raw.strip()
        if not s or s.startswith("#"):
            continue
        m = LOG_RE.match(s)
        if not m:
            out.append(Diag(relp, i + 1, "warn", "W-LOG-GRAMMAR",
                            "not `- <iso> " + MDOT + " <actor> " + MDOT +
                            " <text>` " + EMDASH + " prose"))
            continue
        ts = parse_iso(m.group(1))
        if ts is None:
            out.append(Diag(relp, i + 1, "error", "E-LOG-TS",
                            "unparseable timestamp `%s`" % m.group(1)))
            continue
        if not ACTOR_RE.match(m.group(2)):
            out.append(Diag(relp, i + 1, "error", "E-LOG-ACTOR",
                            "actor must be @handle | tool | agent:<name>"))
        if prev is not None and ts < prev:
            out.append(Diag(relp, i + 1, "error", "E-LOG-ORDER",
                            "log is out of chronological order"))
        prev = ts
        text = m.group(3)
        # NOTES.md §2: banned vocabulary in a *note* is warn-only, because
        # human prose never blocks.  `plan note` logs the note's opening words
        # verbatim, and without this the tool would manufacture a check error
        # out of the owner's own sentence — in the one file nobody may edit to
        # clear it.  Only the quoted tail of a `note <ID>:` line naming a real
        # entity is exempt; every other position on every other line is not,
        # and the note's words are still warned about where they live, in
        # plan.md's prose.
        # Same reasoning for a ruling: `plan decide` writes the chosen option
        # slug verbatim, so an option somebody named `close-as-already-done`
        # would manufacture an error out of the owner's own choice, in the one
        # file nobody may edit to clear it.  Only the slug tail is exempt.
        nm = (NOTE_LOG_RE.match(text) or REPORT_LOG_RE.match(text)
              or RULED_LOG_RE.match(text))
        if nm is not None and nm.group(1) in p.entities:
            text = text[:nm.end()]
        # An option slug is an identifier this plan itself declares, so a
        # reason that names the ruling it is executing must be able to quote
        # it.  Mask declared slugs before the scan: `close-as-already-done`
        # stops being a claim of completion and becomes the name of a choice.
        # Narrow on purpose -- only slugs the plan declares are masked, and a
        # bare banned word anywhere else still errors.
        for slug in option_slugs(p):
            if slug in text:
                text = text.replace(slug, "@")
        for name in banned_hits(text):
            out.append(Diag(relp, i + 1, "error", "E-BANNED",
                            "banned vocabulary `%s` in a log line" % name))
    out.extend(check_log_append_only(p, relp))
    return out


def check_log_append_only(p, relp):
    """§2.9 — git when available, byte-position otherwise.  check is not on
    the hot path, so a git call is permitted here and nowhere else."""
    if not in_git_repo(p.repo_root):
        return []
    import subprocess
    try:
        r = subprocess.run(["git", "-C", p.repo_root, "diff", "--unified=0",
                            "--", rel(p.log_md, p.repo_root)],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           timeout=5)
    except (OSError, subprocess.SubprocessError):
        return []
    removed = 0
    for line in r.stdout.decode("utf-8", "replace").split("\n"):
        if line.startswith("-") and not line.startswith("---"):
            removed += 1
    if removed:
        return [Diag(relp, 1, "error", "E-LOG-APPEND-ONLY",
                     "%d line(s) removed or rewritten since HEAD " % removed +
                     EMDASH + " log.md is append-only")]
    return []


def signed_hashes(p):
    """Every intent hash `sign-off` has ever written, from log.md.

    A signature that no sign-off produced is a forgery: a cold trial user hit
    the circular-refusal defect above, ran `shasum -a 256 intent.md`, pasted
    16 hex into `signed:` and `check` went clean.  A hand-forged signature was
    indistinguishable from a real one, which is also the answer to whether
    guard 2 is real.  The witness is the log line the verb writes."""
    out = set()
    try:
        with open(p.log_md, "r", encoding="utf-8") as fh:
            for line in fh:
                for m in re.finditer(r"signed intent ([0-9a-f]{16})", line):
                    out.add(m.group(1))
    except IOError:
        pass
    return out


_transition_memo = {}


def logged_transition(p, eid):
    """True when log.md records this id reaching `verified` or `accepted`.
    Read once per check run; log.md is append-only so one pass is enough."""
    key = p.log_md
    if key not in _transition_memo:
        seen = set()
        try:
            with open(p.log_md, "r", encoding="utf-8") as fh:
                for line in fh:
                    for m in re.finditer(
                            r"\b((?:FT|L)-[A-Z0-9][A-Z0-9-]*)\b[^\n]*?"
                            r"->\s*(verified|accepted)", line):
                        seen.add(m.group(1))
        except IOError:
            pass
        _transition_memo[key] = seen
    return eid in _transition_memo[key]


def check_rework(p):
    """§3.7 row 4: a third rework means the brief or design is wrong."""
    counts = {}
    try:
        with open(p.log_md, "r", encoding="utf-8") as fh:
            for line in fh:
                m = re.search(r"returned (\S+) verdict=(fail-spec|blocked)",
                              line)
                if m:
                    counts[m.group(1)] = counts.get(m.group(1), 0) + 1
    except IOError:
        return []
    out = []
    for eid, c in sorted(counts.items()):
        if c >= 3 and eid in p.entities:
            e = p.entities[eid]
            out.append(Diag(rel(p.plan_md, p.repo_root), e.line + 1, "error",
                            "E-NEEDS-HUMAN",
                            "%s has regressed %d times " % (eid, c) + EMDASH +
                            " the brief or the design is wrong, not the "
                            "executor"))
    return out


def check_briefs(p, it):
    out = []
    if not os.path.isdir(p.briefs):
        return out
    for name in sorted(os.listdir(p.briefs)):
        if not name.endswith(".md"):
            continue
        lane_id = name[:-3]
        path = os.path.join(p.briefs, name)
        try:
            with open(path, "r", encoding="utf-8") as fh:
                text = fh.read()
        except IOError:
            continue
        m = re.match(r"^<!-- GENERATED brief ([0-9a-f]{8}) ", text)
        if not m:
            out.append(Diag(rel(path, p.repo_root), 1, "warn", "W-BRIEF-HAND",
                            "brief has no generated header " + EMDASH +
                            " hand edits are silently lost"))
            continue
        body = text.split("\n", 1)[1] if "\n" in text else ""
        body = body.split("## Return protocol")[0]
        if sha_hex(body)[:8] != m.group(1):
            out.append(Diag(rel(path, p.repo_root), 1, "warn",
                            "W-BRIEF-HAND",
                            "brief body does not match its hash " + EMDASH +
                            " hand edited; tick will overwrite it"))
        if lane_id not in p.entities:
            out.append(Diag(rel(path, p.repo_root), 1, "warn",
                            "W-BRIEF-ORPHAN",
                            "brief for `%s`, which is not in the plan"
                            % lane_id))
    return out


def check_r1(p):
    """§1.4 invariant R-1."""
    out = []
    cockpit = os.path.join(p.render_dir, "COCKPIT.md")
    if not os.path.isfile(cockpit):
        return [Diag(rel(p.render_dir, p.repo_root), 1, "warn", "W-R1-NOVIEW",
                     "no render/COCKPIT.md " + EMDASH + " run `plan render`")]
    try:
        with open(cockpit, "r", encoding="utf-8") as fh:
            text = fh.read()
    except IOError:
        return out
    rows = text.split("\n")
    sched = Sched(p)
    actions = needed_actions(p, sched)
    head = headline(p, sched, actions=actions)
    relc = rel(cockpit, p.repo_root)
    if not rows or rows[0].strip() != GEN_MARK:
        out.append(Diag(relc, 1, "warn", "W-R1-MARK",
                        "first line is not the GENERATED marker"))
    if len(rows) < 2 or rows[1].strip() != head.strip():
        out.append(Diag(relc, 2, "warn", "W-R1-STALE",
                        "rendered headline differs from the computed one "
                        + EMDASH + " re-run `plan render`"))
    for verb, eid, _t in actions:
        if eid not in text:
            out.append(Diag(relc, 1, "error", "E-R1",
                            "NEEDED action `%s %s` does not appear in the "
                            "cockpit view" % (verb, eid)))
    return out


def check_fresh(p):
    """§4.2 claim classes.  Only run with --fresh; may use git blame."""
    out = []
    now = time.time()
    relp = rel(p.plan_md, p.repo_root)
    for key, f in sorted(p.facts.items()):
        ts = parse_iso(f.ts)
        if ts is None:
            continue
        age = now - ts
        if f.status == "unconf":
            out.append(Diag(relp, f.line + 1, "warn", "W-FRESH-UNCONF",
                            "fact `%s` is unconfirmed (value retained from %s)"
                            % (key, f.ts)))
        elif age >= 24 * 3600:
            out.append(Diag(relp, f.line + 1, "warn", "W-FRESH-STALE",
                            "fact `%s` is stale (%s old, volatile class)"
                            % (key, fmt_age(age))))
    # risk class: flags older than 14 days, via git blame when available
    blame = git_blame_dates(p)
    if blame:
        for eid in p.order:
            e = p.entities[eid]
            if e.type != "Flag" or e.state == "cleared":
                continue
            ts = blame.get(e.line)
            if ts and now - ts >= 14 * 86400:
                out.append(Diag(relp, e.line + 1, "warn", "W-FRESH-RISK",
                                "flag %s untouched for %s (risk class)"
                                % (eid, fmt_age(now - ts))))
    return out


def git_blame_dates(p):
    if not in_git_repo(p.repo_root):
        return None
    import subprocess
    try:
        r = subprocess.run(["git", "-C", p.repo_root, "blame", "--line-porcelain",
                            "--", rel(p.plan_md, p.repo_root)],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    out = {}
    line_no = 0
    last_time = None
    for line in r.stdout.decode("utf-8", "replace").split("\n"):
        if line.startswith("author-time "):
            try:
                last_time = int(line.split()[1])
            except (ValueError, IndexError):
                last_time = None
        elif line.startswith("\t"):
            if last_time is not None:
                out[line_no] = last_time
            line_no += 1
    return out


