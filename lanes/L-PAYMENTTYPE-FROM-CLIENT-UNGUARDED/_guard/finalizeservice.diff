+        // Every payment line the journal writes must name a tender, and the name has to exist. A C#
+        // enum is not validated on cast and the app's Newtonsoft binder accepts any integer while
+        // rejecting only unknown names, so an out-of-range PaymentType arrives here intact — the same
+        // hazard PosReasonLabels.IsValid already guards on the reason field of this document. The
+        // column is mapped through EnumToStringConverter, so the value would persist as its bare
+        // decimal form ("999") on JournalPaymentLine, which is append-only and therefore beyond any
+        // later repair, and print as a naked number on the payer line of the SALREC and the § 2-8-7
+        // RETREC, where every other value is a Norwegian tender name. The check belongs on the writer
+        // rather than on the request types: those are internal DTOs no model binder ever fills, so a
+        // guard placed there would gate nothing.
+        private static PaymentType RequireDefinedTender(PaymentType paymentType, string what)
+        {
+            if (paymentType == PaymentType.NotSet)
+            {
+                throw new AppException(what + " requires the payment type.");
+            }
+
+            if (!Enum.IsDefined(typeof(PaymentType), paymentType))
+            {
+                throw new AppException(what + " carries an unknown payment type (" + (int)paymentType + ").");
+            }
+
+            return paymentType;
+        }
